   // Augments a manually entered failure event or fault
   @mutable
   struct C_Manual_Failure_Event : C_Failure_Event
   {
      // The subject of the fault report - capability, equipment, etc.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_subject;
      // A unique identifier used to associate records relating to the same manual report
