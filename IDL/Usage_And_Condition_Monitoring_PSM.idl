   };

   // Specifies the requirement to capture operator events and Equipment events.
   // Def Stan 23-009 defines event data thus:
   // 
   // 
   // A.2.3.3 Event Data 
   // A.2.3.3.1 Whenever there is a change to the state or mode of the platform components, or the User interacts with the EA, then these Events should automatically be registered and logged. This data shall form part of the data logged to give a snapshot of the platform at regular periods. These events can occur at any time. 
   @mutable
   struct C_Event_Based_Monitoring_Requirement : C_Monitoring_Requirement
   {
      // The name of the event to be monitored.  For example "Engine Started", "Gun Fired".
      @hashid P_LDM_Common_PSM::T_DescriptorType A_eventName;
   };

   // Brakes / 180 / Inspect
   // Brakes / 365 / Replace
   // 
   // Specifies the type of maintenance action to be instigated on a periodic (or temporal) basis, regardless of usage.
   @mutable
   struct C_Periodic_Maintenance_Requirement
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The amount of elapsed time between data collection sets for the specified monitoring requirement.
      @hashid P_LDM_Common_PSM::T_DurationType A_elapsedTime;
      // A human readable identifier for the type name of the monitored entity. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoredEntityTypeName;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_periodicMaintenanceActions_sourceID;
   };

   // Specifies the requirement to log Periodic Data.
   // 
   // Def Stan 23-009 defines period data thus:
   // 
   // A.2.3.1 Periodic Data 
   // A.2.3.1.1 This is data that is produced continuously at a predefined or controlled rate. This data may be produced for direct display to the User e.g. platform speed, battery voltage, or may be produced for data logging. This data shall form part of the data logged to give a snapshot of the platform at regular periods, and will be constantly assessed to ensure it does not exceed pre-set thresholds. This data is of use in both analysing trends and fault diagnosis off-platform. 
   @mutable
   struct C_Periodic_Monitoring_Requirement : C_Monitoring_Requirement
   {
      // Zero means do not log under normal conditions.
      // 
      // One means store the latest value only.
      // 
      // The "Threshold_Based_Monitoring_Requirement" specifies a "loggingIntervalWhileOutsideThreshold" that is used when an exceedance is in progress.
      @hashid P_LDM_Common_PSM::T_DurationType A_monitoringInterval;
   };

