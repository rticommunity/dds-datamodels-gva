   // The_Engine / Engine_Running / 85.0
   // 
   // Left_Headlight / Headlight_On / 2.0
   // 
   // Captures the accumulated usage which the specified Monitored_Entity sustained for the specified type of usage.
   // 
   // It is intended that this class can be used to reduce the requirement to hold all published values from which the accumulated usage could be derived.
   // 
   @mutable
   struct C_Cumulative_Usage
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The type of usage sustained.  For example, hours used or miles logged.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_usageTypeName;
      // The total number of usage units for the specified usage type.
      @hashid P_LDM_Primitive_PSM::T_Double A_cumulativeUsageCount;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_entityWithCumulativeUsage_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_usageThresholdSpecifications_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_usageSpecification_sourceID;
   };
