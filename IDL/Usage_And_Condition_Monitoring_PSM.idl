   };

   // Represents data items pertaining to the monitored entity that are relevant to the UCMS report.  These may be held locally here or retrieved from the relevant domain (e.g. "Vehicle Configuration")
   // 
   // From DefStan:
   // 
   // A.3.2.3 In addition to the above Core Platform Network devices there are a number of parameters that can be considered as platform level information that must be calculated or collected for dissemination across the platform or off-platform: 
   // a) Vehicle Registration Number (VRN) 
   // b) Vehicle Chassis Number (VCN) 
   // c) Platform Fit (Peacekeeping, theatre fit etc.) 
   // d) Range 
   // e) Total Fuel Level 
   // f) Total distance the platform has covered. 
   // 
   // This class captures those values that are fixed for the platform, and therefore do not require periodic logging.
   // 
   @mutable
   struct C_UCMS_Data_Item
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The name of the data item, corresponding the the LDM name where possible.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_dataItemName;
      // The value of the data item.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_dataItemValue;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_describedPlatform_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_monitoredEntity_sourceID;
   };

