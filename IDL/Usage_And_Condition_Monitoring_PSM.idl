      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // Examples include:
      // TYPE_NAME::Miles
      // TYPE_NAME::Hours
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_usageUnitType;
      // TRUE indicates that usage is to be captured for each usage period.
      // 
