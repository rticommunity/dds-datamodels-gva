#ifndef USAGE_AND_CONDITION_MONITORING_PSM__IDL
#define USAGE_AND_CONDITION_MONITORING_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// 
// 
// 
module P_Usage_And_Condition_Monitoring_PSM
{
   // Indicates the warning level of a given data with regards to two levels of thresholds.
   @appendable
   enum T_MonitoredDataWarningLevelType
   {
      L_MonitoredDataWarningLevel__Invalid,
      // The value of the considered data is OK in regards to the thresholds.
      L_MonitoredDataWarningLevel__No_Warning,
      // The value of the considered data has reached the pre-warning threshold.
      L_MonitoredDataWarningLevel__Pre_Warning,
      // The value of the considered data has reached the warning threshold.
      L_MonitoredDataWarningLevel__Warning
   };

   // Indicates if a data threshold is a minimum or a maximum value.
   // In the first case, the data is considered NOK if its value is lower than the threshold.
   // In the second case, the data is considered NOK if its value exceeds the threshold.
   @appendable
   enum T_ThresholdType
   {
      L_Threshold__Invalid,
      // The data is considered NOK if its value is lower than the threshold.
      L_Threshold__Min,
      // The data is considered NOK if its value is greater than the threshold.
      L_Threshold__Max
   };

   // The type of built-in test.
   @appendable
   enum T_BITType
   {
      L_BIT__Invalid,
      // Continuous Built-In Test
      L_BIT__C_BIT,
      // Power Up Built-In Test
      L_BIT__P_BIT,
      // Interruptive Built-In Test
      L_BIT__I_BIT
   };

   @appendable
   enum T_FailureStateType
   {
      L_FailureState__Invalid,
      L_FailureState__Cleared,
      L_FailureState__Raised,
      L_FailureState__Undefined
   };

   // Indicates what kind of characteristic this is.
   @appendable
   enum T_CharacteristicKindType
   {
      L_CharacteristicKind__Invalid,
      L_CharacteristicKind__Instant,
      L_CharacteristicKind__Cumulative
   };

   typedef sequence <T_BITType> T_BITTypeList;

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Usage_And_Condition_Monitoring_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Commands the specified monitored entity to run the specified type of built-in test
   @mutable
   struct C_Monitored_Entity_runBIT
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_BITType A_type;
   };

   // Imports data from the specified file and associates it with the specified monitored entity.  Typically used when the specified monitored entity has been repaired or transferred from another platform.
   @mutable
   struct C_Monitored_Entity_importUCMSData
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_MediumString A_filePathname;
   };

   // Engine_Unit / The_Engine
   // Headlight / Left_Headlight
   // Headlight / Right_Headlight
   // 
   // The status of system (platform or sub-system) whose usage and condition is being monitored.
   // 
   // In the majority of cases, this will correspond to a class in the LDM, and the name should be the class name used in the LDM.  In any case, LDM class naming convention shall be used for monitoredEntityTypeNames.  For example:
   // 
   // "Engine_Unit"
   // "Braking_System"
   // 
   // 
   @mutable
   struct C_Monitored_Entity
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The current health status of the monitored entity, expressed as a RAG code.
      @hashid P_LDM_Common_PSM::T_RAGType A_healthStatus;
      // The date and time when the monitored entity was installed on the platform.
      // 
      @hashid P_LDM_Common_PSM::T_DateTimeType A_installationDateTime;
      // A meaningful (textual) identifier for the monitored entity, if required.  For example, a LCN.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoredEntityDescriptor;
      // TRUE if a BIT operation is in progress.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_bitInProgress;
      // The failure events related to the system.
      // 
      // 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_failureEvents_sourceID;
      // The specification of the monitored system.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      // The cumulated system usage data, as calculated by the sub-system itself or by the UCMS service.
      // Ex. mileage for the vehicle, hours and power cycles for a processor, hours (global) and hours in each gear for a gearbox controller unit...
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_monitoredCharacteristics_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_bitResults_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_monitoredEntityCP_sourceID;
      // The list of the Threshold Exceedances that have occurred for a Characterisic of this Monitored Entity.
      // 
      // This includes any currently in progress as well as any past exceedances.
      // 
      // Exceedances remains in UCMS until logged and subsequently deleted/cleared.
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_thresholdExceedanceEvents_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_monitoredEntityDataItems_sourceID;
   };

   // An event indicating that a failure occurred in a sub-system or is expected to occur (predicted failure issued by a supervision and analysis system).  
   // 
   // Predicted failures may be issued by a supervision and analysis system. 
   // 
   // Failure detections may be created automatically or manually.
   // 
   // For events related to predicted failures, predictedFailure = TRUE and eventOccurrenceTime indicate a future time.
   // 
   @mutable
   struct C_Failure_Event
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The date-time when the event occurred (in case of events related to an actual failure) or is expected to occur (in case of events related to a predicted failure).
      // 
      @hashid P_LDM_Common_PSM::T_DateTimeType A_eventOccurenceTime;
      // If TRUE, indicates if the event relates to a predicted failure. If FALSE, indicates that it relates to an actual failure.
      // Predicted failures may be issued by a supervision and analysis system. For events related to predicted failures, prediction = TRUE and eventOccurenceData indicates a future date.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_predictedFailure;
      // The human-readable description of the failure.
      // Relevant only if the sub-system supports failure description.
      // 
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_failureDescription;
      // The human-readable description of the cause of the failure.
      // Relevant only if the sub-system supports failure cause description.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_causeDescription;
      // The human-readable description of the operational consequences of the failure.
      // Relevant only if the sub-system supports failure operational consequence description.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_operationalConsequenceDescription;
      // The human-readable description of the operator action recommended to fix the failure.
      // Relevant only if the sub-system supports failure operator action description.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_operatorActionDescription;
      // The human-readable description of the maintenance action recommended to fix the failure.
      // Relevant only if the sub-system supports failure maintenance action description.
      // 
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_maintenanceActionDescription;
      // A human-readable complement of information on the failure.
      // Relevant only if the sub-system supports failure complementary information.
      // 
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_complementaryInformation;
      // For rectified faults, the date and time when the fault was rectified.
      @hashid @optional P_LDM_Common_PSM::T_DateTimeType A_timeRectified;
      // A meaningful text string to augment the failure event details.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_comment;
      // Describes mitigation activity for a predicted failure.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_mitigationActivity;
      // Describes the course of action for a predicted failure
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_courseOfAction;
      // Indicates whether this failure event has been raised or cleared.
      @hashid T_FailureStateType A_failureState;
      // The system concerned by the failure event.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_monitoredEntity_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
   };

   // Engine_Unit
   // Headlight
   // 
   // The static parameters of an entity (whole platform or sub-system) whose usage and condition is being monitored.
   // 
   // From DefStan
   // A.2 Types of System data to be collected 
   // A.2.1 There are a number of different generic types of system data that shall be collected: 
   // a) Periodic Data 
   // b) Threshold Exceedance Data 
   // c) Event Data 
   // d) Fault and failure data
   // 
   // 
   @mutable
   struct C_Monitored_Entity_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // If TRUE, indicates that the monitored entity is capable of issuing its cumulative usage data (ex. cumulative hours of usage).
      // 
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_cumulativeMonitoredCharacteristicsOutputSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a failure fault code in a standard format.
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureStandardFaultCodeSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a fault code in a proprietary format.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureProprietaryFaultCodeSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable description of a failure.
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureDescriptionSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable description of the cause of a failure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureCauseDescriptionSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable description of the operational consequences of a failure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureOperationalConsequenceDescriptionSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable description of the operator action recommended to fix a failure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureOperatorActionDescriptionSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable description of the maintenance action recommended to fix a failure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureMaintenanceActionDescriptionSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a human-readable complement of information on a failure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureComplementaryInformationSupported;
      // If TRUE, indicates that the monitored entity is capable of issuing a pointer to the URI in the user or maintenance documentation where the failure is addressed.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_failureDocumentationURISupported;
      // A human readable identifier for the type name of the monitored entity. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoredEntityTypeDescriptor;
      @hashid T_BITTypeList A_supportedBITTypes;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_monitoringRequirements_sourceID;
   };

   // Instant or cumulative monitored usage and condition data of a sub-system, as calculated by the monitored entity itself or by the UCMS service.
   // Ex. current temperature of an electronic component (instant monitored characteristic), vehicle mileage (cumulative monitored characteristic)
   // 
   // Cumulative monitored characteristics are published either by the entity itself, or by the platform UCMS service if the entity is unable to do it.
   @mutable
   struct C_Monitored_Characteristic
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A human readable identifier for the type name of the monitored characteristic. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // Examples include:
      // TYPE_NAME::crewCompartmentTemperature
      // TYPE_NAME::cumulativeVehicleMileage
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
      // The time at which the value was captured.
      // 
      @hashid P_LDM_Common_PSM::T_DateTimeType A_timestamp;
      // The system concerned by the cumulated usage data.
      // 
      @hashid P_GVA_Common_PSM::T_IdentifierType A_monitoredEntity_sourceID;
      // The specification of this monitored characteristic.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
   };

   // The static parameters of a monitored usage and condition data of a sub-system.
   // Ex. temperature of the crew compartment ; vehicle mileage.
   @mutable
   struct C_Monitored_Characteristic_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A human readable identifier for the type name of the monitored units. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // Examples include:
      // TYPE_NAME::Kelvin
      // TYPE_NAME::Kilometers
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_unit;
      // A human readable identifier for the type name of the monitored characteristic. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // Examples include:
      // TYPE_NAME::crewCompartmentTemperature
      // TYPE_NAME::cumulativeVehicleMileage
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
      // The interval (in seconds) according to which the characteristic value is issued.
      @hashid P_LDM_Common_PSM::T_DurationType A_publishingInterval;
      // The kind of characteristic, instant (ex. crew compartment temperature) or cumulative (ex. vehicle mileage).
      @hashid T_CharacteristicKindType A_characteristicKind;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_monitoringRequirements_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_specifications_sourceID;
   };

   // Specifies a monitoring requirement for the specified type of monitored entity.  It is intended that these should be used to configure the UCMS to meet the requirements for each platform.
   @mutable
   struct C_Monitoring_Requirement
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A human readable identifier for the type name of the entity type. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoredEntityTypeName;
      // The number of data collection sets to be retained (in a circular buffer) for this type of monitoring requirement.  Zero means unlimited.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_historySize;
      // A human readable identifier for the type name of the monitoring requirement. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoringRequirementDescriptor;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_requiringEntityType_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_requiredResults_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_concernedCharacteristic_sourceID;
   };

   // Records an incident where a specified value has exceeded a specified threshold.
   @mutable
   struct C_Threshold_Exceedance_Event
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The date-time when the event occurred.
      // 
      @hashid P_LDM_Common_PSM::T_DateTimeType A_timestamp;
      // The value that represents the largest deviation from the threshold (i.e. lowest value for a minimum threshold, highest value for a maximum threshold)
      @hashid P_LDM_Primitive_PSM::T_Double A_measuredValue;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_exceededThreshold_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_concernedCharacteristic_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_inducedEvents_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_inducingEvent_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_exceedingEntity_sourceID;
   };

   // Logs the occurrence of a monitoring requirement, and provides links to the characteristics captured as a result of the triggered monitoring requirement.
   @mutable
   struct C_Triggered_Monitoring_Requirement
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The descriptor of the triggered monitoring requirement.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_monitoringRequirementDescriptor;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_triggeringRequirement_sourceID;
   };

   // Engine / RPM / Engine_Overspeed / 5000 / 2 sec
   // Engine / Oil_Temp / Oil_Too_Cold /-20
   // Engine / Oil_Temp / Oil_Too_Hot  / 50
   // 
   // Specifies the requirement to monitor a specific threshold and capture specific data when it is exceeded.
   // 
   // Def Stan 23-009 lists these threshold types:
   // 
   // 6.5.2 Pre-set parameter limits can have many forms including: 
   // a) An absolute limit; 
   // b) A limit exceeded specified within a given time period; 
   // c) A limit that has been exceeded a number of times; 
   // d) An averaged limit calculated over a given period on a rolling or discrete basis;. 
   // e) A rate of change limit over a given time showing fluctuations in a parameter. 
   // 
   // A.2.3.2 Threshold Exceedance Data 
   // A.2.3.2.1 Within the system there shall be a set of thresholds for some of the data parameters that can be used to trigger a more detailed data collection set, trigger a maintenance activity, or set an indication for the User. 
   @mutable
   struct C_Threshold_Based_Monitoring_Requirement : C_Monitoring_Requirement
   {
      // The threshold value to be monitored for exceedance.
      @hashid P_LDM_Primitive_PSM::T_Double A_thresholdValue;
      // Specifies increased logging frequency of exceeded characteristic to occur while exceedance is in progress.  Zero means no change from value specified in "Monitored_Characteristic_Specification"
      @hashid P_LDM_Common_PSM::T_DurationType A_loggingIntervalWhileOutsideThreshold;
      // Indicates if the threshold value is a minimum or maximum.
      // In the first case, the data is considered NOK if its value is lower than the threshold.
      // In the second case, the data is considered NOK if its value exceeds the threshold.
      // 
      // 
      // 
      @hashid T_ThresholdType A_type;
   };

   // The specification of an event type indicating that a failure occurred in a sub-system or is expected to occur (predicted failure issued by a supervision and analysis system).  
   @mutable
   struct C_Failure_Event_Specification : C_Monitoring_Requirement
   {
      // A pointer to the URI in the sub-system user or maintenance documentation where the failure is addressed.
      // Relevant only if the sub-system supports failure documentation URI.
      // 
      @hashid P_LDM_Common_PSM::T_URIType A_eventDocumentationURI;
      // The human-readable description of the failure.
      // Relevant only if the sub-system supports failure description.
      // 
      @hashid P_LDM_Primitive_PSM::T_LongString A_failureDescription;
      // The fault code that describes the failure, in a standard format.
      // Relevant only if the sub-system supports failure standard fault codes.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_failureCode;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_consequentialFailureEvents_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_rootCause_sourceID;
   };

   // A BIT result provided by the specified monitored entity.
   @mutable
   struct C_BIT_Result
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // iBIT, pBIT or cBIT
      @hashid T_BITType A_bitTypeName;
      // A string representing the result of the BIT.
      @hashid P_LDM_Primitive_PSM::T_LongString A_bitResult;
      // The time at which the value was captured.
      @hashid P_LDM_Common_PSM::T_DateTimeType A_timestamp;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_testedMonitoredEntity_sourceID;
   };

