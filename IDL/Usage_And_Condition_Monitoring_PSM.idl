      // TRUE indicates that the total amount of usage is to be captured.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_cumulativeDataRequired;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_summarisedValueSpecifications_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_thresholds_sourceID;
   };

