      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // Operation that plays the currently selected audio track. If audio track is paused, the audio track will resume play at the current position.
   @mutable
   struct C_Audio_Player_play
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // A specialist Audio_Provider that is capable of playing back recorded audio.
   @mutable
   struct C_Audio_Player : C_Audio_Provider
   {
      // The current status of the playback.
      @hashid T_AudioActivityStatusType A_playbackStatus;
      // The list of available audio tracks that can be played.
      @hashid T_AudioTrackListType A_availableTracks;
      // The identifier of the currently selected audio track. If no track is selected, then this should be set to zero.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_selectedTrack;
      // The current position of the track that is being played. Represented as a duration from the start of the track.
      @hashid P_LDM_Common_PSM::T_DurationType A_trackPosition;
      // The current playback speed represented as a multiplier. By default this would be set to 1.0 i.e. normal speed.
      @hashid P_LDM_Primitive_PSM::T_Double A_playbackSpeed;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_audioPlayerSpecification_sourceID;
   };

   // Operation to request to leave from an audio stream.
   @mutable
   struct C_Audio_Channel_Controller_leaveAudioChannel
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the audio receiver wanting or being instructed to leave or stop receiving the audio channel.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_audioReceiver;
      // The identifier of the audio channel that is required to be stopped from being received.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_providerChannel;
   };

   // Operation to transfer audio stream from one AudioReceiver to another.
   @mutable
   struct C_Audio_Channel_Controller_transferAudioChannel
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the audio receiver that is currently receiving the audio channel to be transferred.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_sourceAudioReceiver;
      // The identifier of the audio provider channel that is being transferred.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_sourceProviderChannel;
      // The identifier of the audio receiver that the audio channel is being requested to be transferred to.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_destinationAudioReceiver;
   };

   // Operation to request to join an audio stream being streamed.
   @mutable
   struct C_Audio_Channel_Controller_joinAudioChannel
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the audio receiver wanting or being instructed to join the audio channel.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_audioReceiver;
      // The identifier of the audio channel that is being request to be joined.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_providerChannel;
   };

   // Specialisation of Multimedia_Routing::Routable_Resource for an Audio_Channel_Controller. An Audio_Channel_Controller is responsible for co-ordinating access to and transfer of audio channels between Audio_Receivers.
   @mutable
   struct C_Audio_Channel_Controller : P_Multimedia_Routing_PSM::C_Routable_Resource
   {
   };

   // The specification for an audio provider.
   // 
   @mutable
   struct C_Audio_Provider_Specification : C_Audio_Resource_Specification
   {
      // Specifies whether auto gain control functionality is supported by the resource.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_autoGainControlSupported;
      // Specifies whether echo cancellation functionality is supported by the resource.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_echoCancellationSupported;
      // Specifies whether noise suppression functionality is supported by the resource.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_noiseSuppressionSupported;
      // Specifies whether the resource supports the ability to mute all channels.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_muteAllChannelsSupported;
      // The list of audio transmission modes supported by the resource.
      @hashid T_AudioTransmissionModeListType A_supportedTransmissionModes;
      // Specifies whether auto gain control can be enabled and disabled.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_autoGainControlEnableDisable;
      // Specifies whether echo cancellation can be enabled and disabled.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_echoCancellationEnableDisable;
      // Specifies whether noise suppression can be enabled and disabled.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_noiseSuppresionEnableDisable;
   };

   // The specification for an Audio_Receiver.
   // 
   @mutable
   struct C_Audio_Receiver_Specification : C_Audio_Resource_Specification
   {
      // Specifies whether the resource supports the ability to mute all channels.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_muteAllChannelsSupported;
      // Specifies whether the resource supports a master volume control.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_masterVolumeSupported;
      // The list of filter parameters supported by the resource.
      @hashid T_FilterParameterNameListType A_supportedFilterParameters;
      // The list of noise cancellation modes supported by the resource.
      @hashid T_NoiseCancellationModeListType A_supportedNoiseCancellationModes;
   };

   // The specification for an audio playback resource.
   // 
   @mutable
   struct C_Audio_Player_Specification : C_Audio_Provider_Specification
   {
      // Communicates if the player supports the ability to vary the speed at which audio tracks can be played back.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPlaybackSpeedSupported;
      // If the player supports the ability to vary the playback speed, this represents the maximum speed multiplier that can be used e.g. 5.00 would represent x5 times.
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumPlaybackSpeed;
      // If the player supports the ability to vary the playback speed, this represents the minimum speed multiplier that can be used e.g. 0.1 would represent x0.1 times.
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumPlaybackSpeed;
      // If the player supports the ability to vary the playback speed, this represents the speed increments supported e.g. if the player supports speed increments of 0.25, and a minimum and maximum speed of 0 and 2 respectively, the following discrete playback speeds would be available for selection, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0.
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_playackSpeedIncrement;
   };

   // The specification for an audio recording resource.
   @mutable
   struct C_Audio_Recorder_Specification : C_Audio_Receiver_Specification
   {
      // The maximum duration for an individual recording.
      @hashid @optional P_LDM_Common_PSM::T_DurationType A_recordingDurationLimit;
   };
};

#endif
