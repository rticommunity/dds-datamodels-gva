#ifndef AUDIO_PSM__IDL
#define AUDIO_PSM__IDL

#include "Multimedia_Routing_PSM.idl"
#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// This package contains data types related to the audio domain.
module P_Audio_PSM
{
   // Specification values for the audio input detection mode. This is the mode by which a device will detect if an audio input signal has been received i.e. the trigger for onwards transmission.
   @appendable
   enum T_InputDetectionModeType
   {
      L_InputDetectionMode__Invalid,
      // audio input is always open.
      L_InputDetectionMode__Continuous,
      // audio input is triggered by a push to talk signal.
      L_InputDetectionMode__PushToTalk,
      // audio input is triggered if the device detects someone speaking.
      L_InputDetectionMode__VoiceDetection
   };

   // Describes the type of audio format.
   // 
   // Note: Enumeration literals aligned with USB Audio v3.0.
   @appendable
   enum T_AudioFormatType
   {
      L_AudioFormat__Invalid,
      L_AudioFormat__PCM,
      L_AudioFormat__PMC8,
      L_AudioFormat__IEEE_FLOAT,
      L_AudioFormat__ALAW,
      L_AudioFormat__MULAW,
      L_AudioFormat__DSD,
      L_AudioFormat__RAW_DATA,
      L_AudioFormat__PCM_IEC60958,
      L_AudioFormat__AC_3,
      L_AudioFormat__MPEG1_Layer1,
      L_AudioFormat__MPEG1_Layer2_3,
      L_AudioFormat__MPEG2_EXT,
      L_AudioFormat__MPEG2_ACC_ADTS,
      L_AudioFormat__MPEG2_Layer1_LS,
      L_AudioFormat__MPEG2_Layer2_3_LS,
      L_AudioFormat__DTS_I,
      L_AudioFormat__DTS_II,
      L_AudioFormat__DTS_III,
      L_AudioFormat__ATRAC,
      L_AudioFormat__ATRAC_2_3,
      L_AudioFormat__WMA,
      L_AudioFormat__E_AC_3,
      L_AudioFormat__MAT,
      L_AudioFormat__DTS_IV,
      L_AudioFormat__MPEG4_HE_AAC,
      L_AudioFormat__MPEG4_HE_AAC_V2,
      L_AudioFormat__MPEG4_AAC_LC,
      L_AudioFormat__DRA,
      L_AudioFormat__MPEG4_HE_AAC_SURROUND,
      L_AudioFormat__MPEG4_AAC_LC_SURROUND,
      L_AudioFormat__MPEG4_H_3D_AUDIO,
      L_AudioFormat__AC4,
      L_AudioFormat__MPEG4_AAC_ELD
   };

   // Describes the compression algorithm used in an audio format.
   @appendable
   enum T_AudioCompressionAlgorithmType
   {
      L_AudioCompressionAlgorithm__Invalid,
      L_AudioCompressionAlgorithm__LOSSLESS,
      L_AudioCompressionAlgorithm__ACELP,
      L_AudioCompressionAlgorithm__SPEECH,
      L_AudioCompressionAlgorithm__MDCT,
      L_AudioCompressionAlgorithm__VSELP,
      L_AudioCompressionAlgorithm__RPE_LTP,
      L_AudioCompressionAlgorithm__BI_LPC,
      L_AudioCompressionAlgorithm__SUBBAND,
      L_AudioCompressionAlgorithm__LPC,
      L_AudioCompressionAlgorithm__LTP,
      L_AudioCompressionAlgorithm__CELP,
      L_AudioCompressionAlgorithm__MLT,
      L_AudioCompressionAlgorithm__PCM,
      L_AudioCompressionAlgorithm__ADPCM,
      L_AudioCompressionAlgorithm__CS_CELP
   };

   // Describes the type of audio resource or device.
   // 
   // Note: Enumeration literals aligned with USB Audio v3.0.
   @appendable
   enum T_AudioResourceType
   {
      L_AudioResource__Invalid,
      L_AudioResource__DeskSpeaker,
      L_AudioResource__Microphone,
      L_AudioResource__Headphone,
      L_AudioResource__Headset,
      L_AudioResource__Recorder,
      L_AudioResource__InputOutputBox,
      L_AudioResource__ControlPanel,
      L_AudioResource__Telephone,
      L_AudioResource__AudioVideo,
      L_AudioResource__Converter,
      L_AudioResource__Headset_Adapter,
      L_AudioResource__Speaker,
      L_AudioResource__SpeakerPhone,
      L_AudioResource__Other
   };

   // The intent and purpose of the audio channel. 
   // 
   // Note: Enumeration literals aligned with USB Audio v3.0
   @appendable
   enum T_AudioChannelPurposeType
   {
      L_AudioChannelPurpose__Invalid,
      // contains audio primarily used for direct capture or reproduction.
      L_AudioChannelPurpose__GenericAudio,
      // intended to be interpreted by humans.
      L_AudioChannelPurpose__Voice,
      // intended to be interpreted or generated by machine.
      L_AudioChannelPurpose__Speech,
      // contains audio other than the primary channels.
      L_AudioChannelPurpose__Ambient,
      // contains final processed audio.
      L_AudioChannelPurpose__Reference,
      // contains signals with spectral content above audible limits (typically >20 kHz).
      L_AudioChannelPurpose__Ultrasonic,
      // contains very low frequency information, typically used to actuate vibrators or motion.
      L_AudioChannelPurpose__VibroKinetic,
      // indicates that the channel carries non-audio information. Examples of non-audio information.
      L_AudioChannelPurpose__NonAudio
   };

   // An enumerated value that describes the relationship of a channel with respect to other channels. It can be considered as the spatial location of the audio channel.
   // 
   // Note: Enumeration literals aligned with USB Audio v3.0.
   @appendable
   enum T_AudioChannelRelationshipType
   {
      L_AudioChannelRelationship__Invalid,
      L_AudioChannelRelationship__Mono,
      L_AudioChannelRelationship__Left,
      L_AudioChannelRelationship__Right,
      L_AudioChannelRelationship__Array,
      L_AudioChannelRelationship__FrontLeft,
      L_AudioChannelRelationship__FrontRight,
      L_AudioChannelRelationship__FrontCenter,
      L_AudioChannelRelationship__FrontLeftOfCenter,
      L_AudioChannelRelationship__FrontRightOfCenter,
      L_AudioChannelRelationship__FrontWideLeft,
      L_AudioChannelRelationship__FrontWideRight,
      L_AudioChannelRelationship__SideLeft,
      L_AudioChannelRelationship__SideRight,
      L_AudioChannelRelationship__SoundArrayLeft,
      L_AudioChannelRelationship__SoundArrayRight,
      L_AudioChannelRelationship__BackLeft,
      L_AudioChannelRelationship__BackRight,
      L_AudioChannelRelationship__BackCenter,
      L_AudioChannelRelationship__BackLeftOfCenter,
      L_AudioChannelRelationship__BackRightOfCenter,
      L_AudioChannelRelationship__BackWideLeft,
      L_AudioChannelRelationship__BackWideRight,
      L_AudioChannelRelationship__TopCenter,
      L_AudioChannelRelationship__TopFrontLeft,
      L_AudioChannelRelationship__TopFrontRight,
      L_AudioChannelRelationship__TopFrontCenter,
      L_AudioChannelRelationship__TopFrontLeftOfCenter,
      L_AudioChannelRelationship__TopFrontRightOfCenter,
      L_AudioChannelRelationship__TopFrontWideLeft,
      L_AudioChannelRelationship__TopFrontWideRight,
      L_AudioChannelRelationship__TopSoundArrayLeft,
      L_AudioChannelRelationship__TopSoundArrayRight,
      L_AudioChannelRelationship__TopBackLeft,
      L_AudioChannelRelationship__TopBackRight,
      L_AudioChannelRelationship__TopBackCenter,
      L_AudioChannelRelationship__TopBackLeftOfCenter,
      L_AudioChannelRelationship__TopBackRightOfCenter,
      L_AudioChannelRelationship__TopBackWideLeft,
      L_AudioChannelRelationship__TopBackWideRight,
      L_AudioChannelRelationship__BottomCenter,
      L_AudioChannelRelationship__BottomFrontLeft,
      L_AudioChannelRelationship__BottomFrontRight,
      L_AudioChannelRelationship__BottomFrontCenter,
      L_AudioChannelRelationship__BottomFrontLeftOfCenter,
      L_AudioChannelRelationship__BottomFrontRightOfCenter,
      L_AudioChannelRelationship__BottomFrontWideLeft,
      L_AudioChannelRelationship__BottomFrontWideRight,
      L_AudioChannelRelationship__BottomSideLeft,
      L_AudioChannelRelationship__BottomSideRight,
      L_AudioChannelRelationship__BottomSurroundArrayLeft,
      L_AudioChannelRelationship__BottomSurroundArrayRight,
      L_AudioChannelRelationship__BottomBackLeft,
      L_AudioChannelRelationship__BottomBackRight,
      L_AudioChannelRelationship__BottomBackCenter,
      L_AudioChannelRelationship__BottomBackLeftOfCenter,
      L_AudioChannelRelationship__BottomBackRightOfCenter,
      L_AudioChannelRelationship__BottomBackWideLeft,
      L_AudioChannelRelationship__BottomBackWideRight,
      L_AudioChannelRelationship__LowFrequencyEffects,
      L_AudioChannelRelationship__LowFrequencyEffectsLeft,
      L_AudioChannelRelationship__LowFrequencyEffectsRight,
      L_AudioChannelRelationship__HeadphoneLeft,
      L_AudioChannelRelationship__HeadphoneRight
   };

   // The status of an audio activity such as recording and playback.
   @appendable
   enum T_AudioActivityStatusType
   {
      L_AudioActivityStatus__Invalid,
      L_AudioActivityStatus__Inactive,
      L_AudioActivityStatus__Active,
      L_AudioActivityStatus__Paused
   };

   // Describes the type of noise cancellation being used.
   @appendable
   enum T_NoiseCancellationModeType
   {
      L_NoiseCancellationMode__Invalid,
      // resource is not using noise cancelling.
      L_NoiseCancellationMode__Off,
      // resource is using active noise cancelling.
      L_NoiseCancellationMode__Active,
      // resource is using passive noise cancelling.
      L_NoiseCancellationMode__Passive
   };

   // Describes the details of an audio tag.
   @mutable
   @nested
   struct T_AudioTagType
   {
      // The name of the audio tag.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_tag;
      // The value of the audio tag.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_value;
   };

   // A list of audio tags.
   typedef sequence <T_AudioTagType> T_AudioTagListType;

   // Describes the transmission mode of the audio output e.g mono or stereo.
   @appendable
   enum T_AudioTransmissionModeType
   {
      L_AudioTransmissionMode__Invalid,
      L_AudioTransmissionMode__Mono,
      L_AudioTransmissionMode__Stereo
   };

   // A list of audio resource identifiers.
   typedef sequence <P_GVA_Common_PSM::T_IdentifierType> T_AudioResourceListType;

   // Describes the details of an audio group.
   @mutable
   @nested
   struct T_AudioGroupType
   {
      // The group identifier.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_groupId;
      // The name of the group.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_groupName;
      // The list of audio providers in the group.
      @hashid T_AudioResourceListType A_providers;
      // The list of audio receivers in the group.
      // 
      @hashid T_AudioResourceListType A_receivers;
   };

   // A list of audio transmission modes.
   typedef sequence <T_AudioTransmissionModeType, 2> T_AudioTransmissionModeListType;

   // A list of noise cancellation modes.
   typedef sequence <T_NoiseCancellationModeType> T_NoiseCancellationModeListType;

   // A list of named filter parameters.
   typedef sequence <P_LDM_Primitive_PSM::T_MediumString> T_FilterParameterNameListType;

   // Describes the details of an audio track.
   @mutable
   @nested
   struct T_AudioTrackType
   {
      // The unique identifier for the audio track.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_trackId;
      // The name of the audio track.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_trackName;
      // The total duration of the audio track.
      @hashid P_LDM_Common_PSM::T_DurationType A_trackLength;
      // A set of tags that provide additional detail about the audio track e.g. source, year etc. Tags are represented as a list of name value pairs.
      @hashid T_AudioTagListType A_tags;
   };

   // A list of audio tracks.
   typedef sequence <T_AudioTrackType> T_AudioTrackListType;

   // A list of audio channel identifiers.
   typedef sequence <P_GVA_Common_PSM::T_IdentifierType> T_AudioChannelListType;

   // A list of audio groups.
   typedef sequence <T_AudioGroupType> T_AudioGroupListType;

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Audio_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Specialisation of Multimedia_Routing::Routable_Channel_Specification for an Audio_Provider_Channel and Audio_Receiver_Channel. 
   @mutable
   struct C_Audio_Channel_Specification : P_Multimedia_Routing_PSM::C_Routable_Channel_Specification
   {
      // The stream IP address.
      @hashid @optional P_LDM_Common_PSM::T_IPv4AddressType A_streamIpAddress;
      // The RTP port used to deliver audio over IP network.
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_rtpPort;
      // The control IP address.
      @hashid @optional P_LDM_Common_PSM::T_IPv4AddressType A_controlIpAddress;
      // The security setting for the audio channel secure or insecure.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_secureChannel;
      // The intent and purpose of the audio channel.
      @hashid T_AudioChannelPurposeType A_purpose;
      // Describes the relationship of this channel with respect to other channels. It can be considered as the spatial location of the audio channel.
      @hashid T_AudioChannelRelationshipType A_relationship;
      // Describes whether this audio channel supports 3-Dimensional audio.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supports3dAudio;
   };

   // Operation that mutes a specific channel that is being provided.
   @mutable
   struct C_Audio_Provider_Channel_mute
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The mute status to be applied to the provider channel. False = Unmute and True = Mute.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_mute;
   };

   // Specialisation of Multimedia_Routing::Routable_Provider_Channel to specify Audio_Provider_Channel.
   // 
   @mutable
   struct C_Audio_Provider_Channel : P_Multimedia_Routing_PSM::C_Routable_Provider_Channel
   {
      // Describes whether the channel is currently muted or not.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_muted;
      // The geographical location of the source of the audio. This is only set if the channel supports 3-D audio and the resource is able to determine the location.
      @hashid @optional P_LDM_Common_PSM::T_Coordinate3DType A_sourceLocation;
   };

   // Operation that sets the volume for a specific channel that is being received.
   @mutable
   struct C_Audio_Receiver_Channel_setVolume
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The channel volume level to be set, expressed as a percentage.
      @hashid P_LDM_Common_PSM::T_PercentageType A_volume;
   };

   // Operation that mutes a specific channel that is being received.
   @mutable
   struct C_Audio_Receiver_Channel_mute
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The mute status to be applied to the receiver channel. False = Unmute and True = Mute.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_mute;
   };

   // Specialisation of Multimedia_Routing::Routable_Receiver_Channel to specify Audio_Receiver_Channel.
   // 
   @mutable
   struct C_Audio_Receiver_Channel : P_Multimedia_Routing_PSM::C_Routable_Receiver_Channel
   {
      // Describes whether the channel is currently muted or not.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_muted;
      // Describes the volume level of the channel.
      @hashid P_LDM_Common_PSM::T_PercentageType A_volume;
   };

   // Specialisation of Multimedia_Routing::Routable_Format_Specification to specify Audio_Format_Specification.
   // 
   @mutable
   struct C_Audio_Format_Specification : P_Multimedia_Routing_PSM::C_Routable_Format_Specification
   {
      // The type of audio format.
      @hashid T_AudioFormatType A_format;
      // The number of audio bits per sample.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_bitDepth;
      // The audio sampling rate used by the format. Rate is represented as a frequency.
      @hashid P_LDM_Common_PSM::T_FrequencyInHertzType A_sampleRate;
      // The mode of audio transmission that is supported by the format.
      @hashid @optional T_AudioTransmissionModeType A_transmissionMode;
      // The compression type used to compress the audio.
      @hashid @optional T_AudioCompressionAlgorithmType A_compressionAlgorithm;
      // Format has been encoded using a Constant Bit Rate.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_encodedConstantBitRate;
      // Format has been encoded using a Variable Bit Rate.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_encodedVariableBitRate;
   };

   // Operation to delete an audio group.
   @mutable
   struct C_Audio_Group_Controlller_deleteAudioGroup
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the audio group to be deleted.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_groupId;
   };

   // Operation to update an audio group.
   @mutable
   struct C_Audio_Group_Controlller_updateAudioGroup
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The audio group details to be used to update the audio group. The current details of the group will be completely replaced with the new details that is passed in. The groupId attribute will be used to identify which group is to be updated.
      @hashid T_AudioGroupType A_groupDetails;
   };

   // Operation to setup an audio group.
   @mutable
   struct C_Audio_Group_Controlller_createAudioGroup
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The name to be assigned to the newly created audio group.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_name;
      // The list of audio providers to be associated with the audio group.
      @hashid T_AudioResourceListType A_providers;
      // The list of audio receivers to be associated with the audio group.
      @hashid T_AudioResourceListType A_receivers;
   };

   // Specialisation of Multimedia_Routing::Routable_Resource for an Audio_Group_Controlller. An Audio_Group_Controlller is responsible for managing audio groups.
   // 
   @mutable
   struct C_Audio_Group_Controlller : P_Multimedia_Routing_PSM::C_Routable_Resource
   {
      // The list of currently supported groups.
      @hashid T_AudioGroupListType A_groups;
   };

   // Operation that deletes the selected audio track.
   @mutable
   struct C_Audio_Recorder_deleteRecording
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the audio recording that is to be deleted.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_trackId;
   };

   // Operation that resumes the recording of an audio stream. The recording must be already paused for this to have any effect.
   @mutable
   struct C_Audio_Recorder_resume
   {
