   // Specialisation of the Multimedia_Routing::Routable_Format_Specification for a Video channel.
   @mutable
   struct C_Video_Format_Specification : P_Multimedia_Routing_PSM::C_Routable_Format_Specification
   {
      // The basic video format of this entry.  Uncompressed video shall use "raw" and compressed video shall use the relevant IANA MIME media type specifier (e.g. jpeg2000, H264).
      @hashid @optional P_LDM_Primitive_PSM::T_ShortString A_base;
      // The pixel sampling format, e.g. YCbCr-4:2:2, RGB, GRAYSCALE
      @hashid @optional P_LDM_Primitive_PSM::T_ShortString A_sampling;
      // The number of bits used to encode a pixel or series of pixels for this entry
      @hashid @optional P_LDM_Primitive_PSM::T_Int32 A_bitDepth;
      // The maximum number of frames per second
      @hashid P_LDM_Primitive_PSM::T_Int32 A_fps;
      // The colorimetry of the format (e.g. BT601-5)
      @hashid @optional P_LDM_Primitive_PSM::T_ShortString A_colorimetry;
      // The interlacing state of the format
      @hashid @optional T_VideoFormatInterlaceModeType A_interlaced;
      // The compression factor type used if the format is for compressed video
      @hashid @optional T_VideoFormatCompressionFactorType A_compressionFactor;
      // The maximum target rate when the compression factor is set to target rate
      @hashid @optional P_LDM_Common_PSM::T_RateInKbpsType A_targetCompressionRate;
      // The horizontal resolution in pixels of the format
      @hashid T_PixelCountType A_horizontalResolution;
      // The vertical resolution in pixels of the format
      @hashid T_PixelCountType A_verticalResolution;
      // The type of the format
      @hashid T_VideoFormatType A_type;
      // A subjective quality factor if the format uses compression and the compression factor is target quality.
      // 
      // For example, in 00-082, this will be in the range 1-16.
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_targetCompressionQuality;
   };

   // Specialisation of Multimedia_Routing::Routable_Channel_Specification for a Video Channel.  
   @mutable
   struct C_Video_Channel_Specification : P_Multimedia_Routing_PSM::C_Routable_Channel_Specification
   {
      // Flag to indicate if the channel supports a region of interest
      @hashid P_LDM_Primitive_PSM::T_Boolean A_regionOfInterestSupported;
      // Specification for digital zoom capabilities.  This is optional, so if it is left unset it means digital zoom is not supported
      @hashid @optional T_ZoomSpecificationType A_digitalZoom;
      // Specification for orientation capabilities.  This is optional so if it is left unset then orientation is not supported
      @hashid @optional T_OrientationSpecificationType A_orientation;
   };

