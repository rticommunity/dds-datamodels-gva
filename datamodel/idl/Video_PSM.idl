      @doc("Specification of field of view parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature")
      @hashid @optional T_FieldOfViewSpecificationType A_fieldOfView;
      @doc("List of sensor spectrums the optical sensor supports")
      @hashid T_SensorSpectrumListType A_supportedSensorSpectrums;
   };

   @doc("Specialisation of Optical_Sensor_Specification to specify additional attributes for a Thermal Optical Sensor")
   @mutable
   struct C_Thermal_Optical_Sensor_Specification : C_Optical_Sensor_Specification
   {
      @doc("Flag to indicate if the sensor has a cooler")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_hasCooler;
      @doc("Flag to indicate if the sensor supports setting the polarity")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPolaritySupported;
      @doc("Flag to indicate if the sensor supports setting the colour scheme")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setColourSchemeSupported;
      @doc("Collection of polarities supported by the sensor")
      @hashid T_PolarityListType A_supportedPolarities;
      @doc("Collection of colour schemes the sensor supports")
      @hashid T_ColourManipulationListType A_supportedColourSchemes;
      @doc("Flag to indicate if inverting the polarity of the sensor is supported")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_invertPolaritySupported;
      @doc("Flag to indicate if resetting the Non-Uniform Correction of the sensor is supported")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_resetNonUniformCorrectionSupported;
      @doc("Flag to indicate if automatic resetting the Non-Uniform Correction of the sensor is supported")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setNonUniformCorrectionAutoResetModeSupported;
   };

   @doc("Specialisation of a Video_Channel_Specification for a Defence Standard 00-082 Video Channel.")
   @mutable
   struct C_Video_Channel_VIVOE_Specification : C_Video_Channel_Specification
   {
      @doc("The interpacket delay of the channel")
      @hashid P_LDM_Primitive_PSM::T_Int32 A_interpacketDelay;
      @doc("The SAP Message Interval of the channel")
      @hashid P_LDM_Primitive_PSM::T_Int32 A_sapMessageInterval;
      @doc("The RTP Port of the channel")
      @hashid P_LDM_Primitive_PSM::T_Int32 A_rtpPort;
      @doc("The stream IP Address of the channel")
      @hashid P_LDM_Common_PSM::T_IPv4AddressType A_streamIPAddress;
      @doc("The control IP Address of the channel")
      @hashid P_LDM_Common_PSM::T_IPv4AddressType A_controlIPAddress;
   };
};

