   // Specialisation of Multimedia_Routing::Routable_Resource_Specification to specify an Optical Sensor
   @mutable
   struct C_Optical_Sensor_Specification : P_Multimedia_Routing_PSM::C_Routable_Resource_Specification
   {
      // Specification of exposure parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_ExposureSpecificationType A_exposure;
      // Specification of boresight parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_BoresightSpecificationType A_boresight;
      // Specification of gain parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_GainSpecificationType A_gain;
      // Specification of focus parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_FocusSpecificationType A_focus;
      // Specification of white clip parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_WhiteClipSpecificationType A_whiteClip;
      // Specification of black level parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_BlackLevelSpecificationType A_blackLevel;
      // Specification of offset parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_OffsetSpecificationType A_offset;
      // Specification of field of view parameters for the Optical Sensor.  Defined as optional; if the attribute is not set then it does not support the feature
      @hashid @optional T_FieldOfViewSpecificationType A_fieldOfView;
      // List of sensor spectrums the optical sensor supports
      @hashid T_SensorSpectrumListType A_supportedSensorSpectrums;
   };

   // Specialisation of Optical_Sensor_Specification to specify additional attributes for a Thermal Optical Sensor
   @mutable
   struct C_Thermal_Optical_Sensor_Specification : C_Optical_Sensor_Specification
   {
      // Flag to indicate if the sensor has a cooler
      @hashid P_LDM_Primitive_PSM::T_Boolean A_hasCooler;
      // Flag to indicate if the sensor supports setting the polarity
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPolaritySupported;
      // Flag to indicate if the sensor supports setting the colour scheme
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setColourSchemeSupported;
      // Collection of polarities supported by the sensor
      @hashid T_PolarityListType A_supportedPolarities;
      // Collection of colour schemes the sensor supports
      @hashid T_ColourManipulationListType A_supportedColourSchemes;
      // Flag to indicate if inverting the polarity of the sensor is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_invertPolaritySupported;
      // Flag to indicate if resetting the Non-Uniform Correction of the sensor is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_resetNonUniformCorrectionSupported;
      // Flag to indicate if automatic resetting the Non-Uniform Correction of the sensor is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setNonUniformCorrectionAutoResetModeSupported;
   };

