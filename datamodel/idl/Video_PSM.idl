#ifndef VIDEO_PSM__IDL
#define VIDEO_PSM__IDL

#include "Multimedia_Routing_PSM.idl"
#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// The primary purpose of this module is to abstract and control video devices. The video device is split into two functional parts:
// 
//     Video Routing
//     Video Source Control
// 
// The module specialises elements from Multimedia_Routing to provide Video-specific attributes and behaviours.
module P_Video_PSM
{
   // Describes the type of the format
   @appendable
   enum T_VideoFormatType
   {
      L_VideoFormat__Invalid,
      L_VideoFormat__Full_Frame,
      L_VideoFormat__Region_Of_Interest
   };

   // Describes the interlacing mode of a video format
   @appendable
   enum T_VideoFormatInterlaceModeType
   {
      L_VideoFormatInterlaceMode__Invalid,
      L_VideoFormatInterlaceMode__Interlaced,
      L_VideoFormatInterlaceMode__Progressive,
      L_VideoFormatInterlaceMode__None
   };

   // Describes the compression factor for a video format
   @appendable
   enum T_VideoFormatCompressionFactorType
   {
      L_VideoFormatCompressionFactor__Invalid,
      L_VideoFormatCompressionFactor__Target_Rate,
      L_VideoFormatCompressionFactor__Target_Quality,
      L_VideoFormatCompressionFactor__Lossless,
      L_VideoFormatCompressionFactor__None
   };

   // Number of pixels
   typedef P_LDM_Primitive_PSM::T_Int32 T_PixelCountType;

   // Describes the frame integration setting
   @appendable
   enum T_FrameIntegrationSettingType
   {
      L_FrameIntegrationSetting__Invalid,
      L_FrameIntegrationSetting__On,
      L_FrameIntegrationSetting__Off
   };

   // Describes the shutter operation mode
   @appendable
   enum T_ShutterOperationModeType
   {
      L_ShutterOperationMode__Invalid,
      L_ShutterOperationMode__Auto,
      L_ShutterOperationMode__Manual
   };

   // Describes the shutter state
   @appendable
   enum T_ShutterStateType
   {
      L_ShutterState__Invalid,
      L_ShutterState__Open,
      L_ShutterState__Closed,
      L_ShutterState__Transitioning
   };

   // Represents the state of the boresight of an optical sensor
   @mutable
   @nested
   struct T_BoresightType
   {
      // The current x axis boresight value
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_xAxis;
      // The current y axis boresight value
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_yAxis;
   };

   // Represents the state of the exposure of an optical sensor
   @mutable
   @nested
   struct T_ExposureType
   {
      // The current frame integration
      @hashid @optional T_FrameIntegrationSettingType A_frameIntegration;
      // The current frame rate
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_frameRate;
      // The current operation mode
      @hashid T_ShutterOperationModeType A_operationMode;
      // The last shutter speed
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_lastShutterSpeed;
      // The current state of the shutter
      @hashid @optional T_ShutterStateType A_shutterState;
   };

   // Describes the orientation of the video
   @appendable
   enum T_OrientationType
   {
      L_Orientation__Invalid,
      L_Orientation__Normal,
      L_Orientation__X_Flipped,
      L_Orientation__Y_Flipped,
      L_Orientation__Both_Flipped
   };

   // Describes the gain mode
   @appendable
   enum T_GainModeType
   {
      L_GainMode__Invalid,
      L_GainMode__Auto,
      L_GainMode__Manual
   };

   // Describes the focus mode
   @appendable
   enum T_FocusModeType
   {
      L_FocusMode__Invalid,
      L_FocusMode__Auto,
      L_FocusMode__Manual
   };

   // Describes the white clip mode
   @appendable
   enum T_WhiteClipModeType
   {
      L_WhiteClipMode__Invalid,
      L_WhiteClipMode__Auto,
      L_WhiteClipMode__Manual
   };

   // The attributes that describe the zoom state of a Video Provider
   @mutable
   @nested
   struct T_ZoomType
   {
      // The current zoom multiplier.  1.0 equals 1x zoom
      @hashid P_LDM_Primitive_PSM::T_Double A_multiplier;
      // The amount of zoom multiplier that will be added or removed for a single nudge step.  E.g. 0.2 will adjust the zoom by 0.2x
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
   };

   // Represents the state of the field of view of an optical sensor
   @mutable
   @nested
   struct T_FieldOfViewType
   {
      // The current horizontal field of view
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_horizontal;
      // The current vertical field of view
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_vertical;
   };

   // Describes the black level mode
   @appendable
   enum T_BlackLevelModeType
   {
      L_BlackLevelMode__Invalid,
      L_BlackLevelMode__Auto,
      L_BlackLevelMode__Manual
   };

   // Describes the offset mode
   @appendable
   enum T_OffsetModeType
   {
      L_OffsetMode__Invalid,
      L_OffsetMode__Auto,
      L_OffsetMode__Manual
   };

   // Represents the state of the gain of an optical sensor
   @mutable
   @nested
   struct T_GainType
   {
      // The current gain
      @hashid P_LDM_Primitive_PSM::T_Double A_absolute;
      // The current step size for nudging gain
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
      // The current gain mode
      @hashid T_GainModeType A_mode;
   };

   // Represents the state of the focus of an optical sensor
   @mutable
   @nested
   struct T_FocusType
   {
      // The current focus value
      @hashid P_LDM_Primitive_PSM::T_Double A_absolute;
      // The current step size for nudging focus
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
      // The current focus mode
      @hashid T_FocusModeType A_mode;
   };

   // Represents the state of the white clip of an optical sensor
   @mutable
   @nested
   struct T_WhiteClipType
   {
      // The current white clip value
      @hashid P_LDM_Primitive_PSM::T_Double A_absolute;
      // The current step size for nudging white clip
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
      // The current white clip mode
      @hashid T_WhiteClipModeType A_mode;
   };

   // Represents the state of the black level of an optical sensor
   @mutable
   @nested
   struct T_BlackLevelType
   {
      // The current black level value
      @hashid P_LDM_Primitive_PSM::T_Double A_absolute;
      // The current step size for nudging black level
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
      // The current black level mode
      @hashid T_BlackLevelModeType A_mode;
   };

   // Represents the state of the offset of an optical sensor
   @mutable
   @nested
   struct T_OffsetType
   {
      // The current offset value
      @hashid P_LDM_Primitive_PSM::T_Double A_absolute;
      // The current step size for nudging offset
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_stepSize;
      // The current offset mode
      @hashid T_OffsetModeType A_mode;
   };

   // Describes the colour manipulation
   @appendable
   enum T_ColourManipulationType
   {
      L_ColourManipulation__Invalid,
      L_ColourManipulation__False_Colour,
      L_ColourManipulation__Monochrome
   };

   // Describes the cooler mode
   @appendable
   enum T_CoolerModeType
   {
      L_CoolerMode__Invalid,
      L_CoolerMode__On,
      L_CoolerMode__Off
   };

   // Describes the polarity
   @appendable
   enum T_PolarityType
   {
      L_Polarity__Invalid,
      L_Polarity__White_Hot,
      L_Polarity__Black_Hot
   };

   // Specification attributes for zooming a video source and associated capabilities to interact with the zoom capability
   @mutable
   @nested
   struct T_ZoomSpecificationType
   {
      // The minimum zoom multiplier
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumZoomLevel;
      // The maximum zoom multiplier
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumZoomLevel;
      // Flag for whether nudging the zoom multiplier by a step size is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeZoomSupported;
      // Flag for whether setting the zoom multiplier explicitly is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteZoomSupported;
      // Flag for whether changing the step size for nudging the zoom multiplier is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_changeStepSizeSupported;
   };

   // Specification values for the focus of an optical sensor
   @mutable
   @nested
   struct T_FocusSpecificationType
   {
      // The minimum focus of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumFocus;
      // The maximum focus of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumFocus;
      // Flag to indicate if setting focus mode is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setFocusModeSupported;
      // Flag to indicate if nudging focus is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeFocusSupported;
      // Flag to indicate if setting focus absolutely is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteFocusSupported;
   };

   // Represents a list of the fields of view type values.
   typedef sequence <T_FieldOfViewType> T_FieldOfViewListType;

   // Specification values for the white clip of an optical sensor
   @mutable
   @nested
   struct T_WhiteClipSpecificationType
   {
      // The minimum white clip of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumWhiteClip;
      // The maximum white clip of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumWhiteClip;
      // Flag to indicate if setting white clip mode is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setWhiteClipModeSupported;
      // Flag to indicate if nudging white clip is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeWhiteClipSupported;
      // Flag to indicate if setting white clip absolutely is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteWhiteClipSupported;
   };

   // Specification values for the offset of an optical sensor
   @mutable
   @nested
   struct T_OffsetSpecificationType
   {
      // The minimum offset of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumOffset;
      // The maximum offset of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumOffset;
      // Flag to indicate if setting offset mode is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setOffsetModeSupported;
      // Flag to indicate if nudging offset is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeOffsetSupported;
      // Flag to indicate if setting offset absolutely is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteOffsetSupported;
   };

   // Specification values for the gain of an optical sensor
   @mutable
   @nested
   struct T_GainSpecificationType
   {
      // The minimum gain of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumGain;
      // The maximum gain of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumGain;
      // Flag to indicate if setting gain mode is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setGainModeSupported;
      // Flag to indicate if nudging gain is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeGainSupported;
      // Flag to indicate if setting gain absolutely is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteGainSupported;
   };

   // Specification values for the black level of an optical sensor
   @mutable
   @nested
   struct T_BlackLevelSpecificationType
   {
      // The minimum black level of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumBlackLevel;
      // The maximum black level of the optical sensor
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumBlackLevel;
      // Flag to indicate if setting black level mode is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setBlackLevelModeSupported;
      // Flag to indicate if nudging black level is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_nudgeBlackLevelSupported;
      // Flag to indicate if setting black level absolutely is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_absoluteBlackLevelSupported;
   };

   // List of ShutterOperationModeType values
   typedef sequence <T_ShutterOperationModeType> T_ShutterOperationModeListType;

   // Specification values for the boresight of an optical sensor
   @mutable
   @nested
   struct T_BoresightSpecificationType
   {
      // The minimum X offset of the boresight
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumXOffset;
      // The minimum Y offset of the boresight
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumYOffset;
      // The maximum X offset of the boresight
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumXOffset;
      // The maximum Y offset of the boresight
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumYOffset;
      // Flag to indicate if setting the boresight is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setBoresightSupported;
   };

   // Describes the Sensor Spectrum
   @appendable
   enum T_SensorSpectrumType
   {
      L_SensorSpectrum__Invalid,
      L_SensorSpectrum__Day,
      L_SensorSpectrum__Low_Light,
      L_SensorSpectrum__Thermal
   };

   // Describes a Region of Interest in a Video Channel
   @mutable
   @nested
   struct T_VideoRegionOfInterestType
   {
      // The top value of the top left origin of the region of interest
      @hashid T_PixelCountType A_originTop;
      // The left value of the top left origin of the region of interest
      @hashid T_PixelCountType A_originLeft;
      // The bottom value of the bottom right extent of the region of interest
      @hashid T_PixelCountType A_extentBottom;
      // The right value of the bottom right extent of the region of interest
      @hashid T_PixelCountType A_extentRight;
   };

   // Specification values for the exposure of an optical sensor
   @mutable
   @nested
   struct T_ExposureSpecificationType
   {
      // The minimum shutter speed of the optical sensor exposure
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minimumShutterSpeed;
      // The maximum shutter speed of the optical sensor exposure
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maximumShutterSpeed;
      // The supported operation modes of the optical sensor exposure
      @hashid T_ShutterOperationModeListType A_shutterOperationModesSupported;
      // Flag to indicate if the optical sensor supports setting exposure
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setExposureSupported;
      // Flag to indicate if the optical sensor supports setting shutter speed
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setShutterSpeedSupported;
      // Flag to indicate if the optical sensor supports operating the shutter manually
      @hashid P_LDM_Primitive_PSM::T_Boolean A_operateShutterManuallySupported;
      // Flag to indicate if the optical sensor supports setting the shutter operation mode
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setShutterOperationModeSupported;
   };

   // List of OrientationType values
   typedef sequence <T_OrientationType> T_OrientationListType;

   // Specification attributes for the orientation of a video source and associated capabilities to interact with the orientation of the video
   @mutable
   @nested
   struct T_OrientationSpecificationType
   {
      // Flag for whether setting the orientation of the video is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setOrientationSupported;
      // List of supported video orientations
      @hashid T_OrientationListType A_supportedOrientations;
   };

   // List of SensorSpectrumType values
   typedef sequence <T_SensorSpectrumType> T_SensorSpectrumListType;

   // List of PolarityType values
   typedef sequence <T_PolarityType> T_PolarityListType;

   // List of ColourManipulationType values
   typedef sequence <T_ColourManipulationType> T_ColourManipulationListType;

   // Specification values for the field of view of an optical sensor
   @mutable
   @nested
   struct T_FieldOfViewSpecificationType
   {
      // The minimum horizontal field of view of the optical sensor
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_minimumHorizontalFieldOfView;
      // The minimum vertical field of view of the optical sensor
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_minimumVerticalFieldOfView;
      // The maximum horizontal field of view of the optical sensor
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_maximumHorizontalFieldOfView;
      // The maximum vertical field of view of the optical sensor
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_maximumVerticalFieldOfView;
      // Flag to indicate if discrete horizontal field of view is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_discreteHorizontalFieldOfViewSupported;
      // Flag to indicate if continuous horizontal field of view is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_continuousHorizontalFieldOfViewSupported;
      // Flag to indicate if discrete vertical field of view is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_discreteVerticalFieldOfViewSupported;
      // Flag to indicate if continuous vertical field of view is supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_continuousVerticalFieldOfViewSupported;
      // Collection of discrete horizontal fields of view of the optical sensor. Should be linked to discreteVerticalFieldsOfView.
      @hashid T_FieldOfViewListType A_discreteFieldsOfView;
   };

   // Describes the type of Non-Uniform Correction resetting supported by a Thermal Optical Sensor.
   @appendable
   enum T_NonUniformCorrectionAutoResetModeType
   {
      L_NonUniformCorrectionAutoResetMode__Invalid,
      L_NonUniformCorrectionAutoResetMode__Enabled,
      L_NonUniformCorrectionAutoResetMode__Disabled
   };

   // Represents a non-uniform correction type for an Optical Sensor.
   @mutable
   @nested
   struct T_NonUniformCorrectionType
   {
      // Boolean indicating if the Non-Uniform Correction is currently in progress.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_inProgress;
      // The date and time at which the Non-Uniform Correction was last reset.
      @hashid @optional P_LDM_Common_PSM::T_DateTimeType A_timeOfLastReset;
      // Describes the type of Non-Uniform Correction resetting currently used by the Thermal Optical Sensor.
      @hashid @optional T_NonUniformCorrectionAutoResetModeType A_autoResetMode;
   };

   // Represents a cooler for a Thermal Optical Sensor.
   @mutable
   @nested
   struct T_CoolerType
   {
      // The current cooler type mode
      @hashid @optional T_CoolerModeType A_mode;
   };

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Video_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Sets the orientation of the video
   @mutable
   struct C_Video_Provider_Channel_setOrientation
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_OrientationType A_orientation;
   };

   // Sets the amount of zoom multiplier that will be added or removed for a single nudge step.  E.g. 0.2 will adjust the zoom by 0.2x
   @mutable
   struct C_Video_Provider_Channel_setDigitalZoomStepSize
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Double A_stepSize;
   };

   // Adjusts the digital zoom multiplier by (the number of steps x the digital zoom step size)
   @mutable
   struct C_Video_Provider_Channel_nudgeDigitalZoom
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Int32 A_numberOfSteps;
   };

   // Sets the digital zoom multiplication.  1.0 = 1x zoom (i.e. no zoom applied)
   @mutable
   struct C_Video_Provider_Channel_setDigitalZoomMultiplier
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Double A_multiplier;
   };

   // Sets the region of interest carried in the channel.  
   @mutable
   struct C_Video_Provider_Channel_setRegionOfInterest
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
