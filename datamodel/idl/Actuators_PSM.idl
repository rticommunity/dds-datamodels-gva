#ifndef ACTUATORS_PSM__IDL
#define ACTUATORS_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

@doc("The responsibilities of this domain are:
    Control of specific actuators by setting and reporting of attributes peculiar to each actuator.
    Control of one or more generic actuators by setting and reporting of data driven attributes in the form of a name-value pair.")
module P_Actuators_PSM
{
   @doc("Fire suppressant.")
   @appendable
   enum T_FireExtinguisherMediaType
   {
      L_FireExtinguisherMedia__Invalid,
      @doc("ANSI/UL 626, CAN/ULC-S507, Standard for Water Fire Extinguishers")
      L_FireExtinguisherMedia__Water,
      @doc("DS42-40 Foam Liquids, Fire Extinguishing")
      L_FireExtinguisherMedia__Foam,
      @doc("ANSI/UL 299 Standard for Dry Chemical Fire Extinguishers")
      L_FireExtinguisherMedia__Dry_Powder,
      @doc("ANSI/UL 154 Standard for Carbon-Dioxide Fire")
      L_FireExtinguisherMedia__CO2,
      L_FireExtinguisherMedia__Halon
   };

   @doc("The method of expelling the contents.")
   @appendable
   enum T_FireExtinguisherExpelType
   {
      L_FireExtinguisherExpel__Invalid,
      L_FireExtinguisherExpel__Gas_Cartridge,
      L_FireExtinguisherExpel__Stored_Pressure
   };

   @doc("An enumeration defining the type of unit used to meaures the capacity of the fire extinguisher. E.g.
       Litres
       Kilograms
       Pounds")
   @appendable
   enum T_FireExtinguisherCapacityUnitsType
   {
      L_FireExtinguisherCapacityUnits__Invalid,
      L_FireExtinguisherCapacityUnits__Litres,
      L_FireExtinguisherCapacityUnits__Kilograms,
      L_FireExtinguisherCapacityUnits__Pounds
   };

   @doc("Capacity of fire extinguisher with units of either Litres, Kilograms or pounds.")
   @mutable
   @nested
   struct T_FireExtinguisherCapacityType
   {
      @doc("The numerical capacity of the fire extenguisher.")
      @hashid P_LDM_Primitive_PSM::T_Double A_fireExtinguisherCapacityValue;
      @doc("Depending upon the type of fire extinguisher, the capacity may be quoted in one of the following:
          Litres (l), Kilograms (Kg) or Pounds (lbs).")
      @hashid T_FireExtinguisherCapacityUnitsType A_fireExtinguisherCapacityUnits;
   };

   @doc("All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.")
   @mutable
   struct C_Actuators_CommandResponse
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure")
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      @doc("LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.")
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   @doc("Any controllable actuator, such as heater, fan, dehumidifier, air feed flap.")
   @mutable
   struct C_Actuator
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("The current reported status of the power applied to the actuator.")
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_powerOnStatus;
      @doc("The current reported status of the power saving applied to the actuator.")
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_powerSavingStatus;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_actuatorCP_sourceID;
   };

   @doc("Specifies the capabilities of an environmental actuator.")
   @mutable
   struct C_Actuator_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("A human readable identifier for the type name of the actuator (particularly when the actuator is of type Generic_Actuator). This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>
          Examples include:
          MOTOR
          RAM
          COOLER")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_actuatorTypeName;
      @doc("TRUE indicates that this actuator supports a power saving mode.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPowerSavingStatusSupported;
      @doc("TRUE indicates that the actuator type supports commands to turn it on and off.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPowerOnStatusSupported;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_specificationItems_sourceID;
   };

   @doc("Sets the speed of the Motor.")
   @mutable
   struct C_Motor_setMotorSpeed
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_motorSpeed;
   };

   @doc("The vehicle ram")
   @mutable
   struct C_Ram : C_Actuator
   {
      @doc("The actual oil temperature of the ram")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_ramOilTemperature;
      @doc("The actual oil level in the ramp oil tank")
      @hashid P_LDM_Common_PSM::T_VolumeInCubicMetresType A_ramOilLevel;
      @doc("The actual pressure of the ram filter")
      @hashid @optional P_LDM_Common_PSM::T_PressureInPascalType A_ramFilterPressureLevel;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_ramSolenoids_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_ramMotors_sourceID;
   };

