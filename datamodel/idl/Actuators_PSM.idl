   @mutable
   struct C_Ram_Specification : C_Actuator_Specification
   {
      @doc("The maximum allowable oil level in the ramp oil tank.")
      @hashid P_LDM_Common_PSM::T_VolumeInCubicMetresType A_maximumOilLevel;
      @doc("The minimum recommended oil level in the ramp oil tank.")
      @hashid P_LDM_Common_PSM::T_VolumeInCubicMetresType A_minimumOilLevel;
      @doc("The maximum allowable temperature of the ram oil.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_maximumOilTemperature;
      @doc("The minimum recommended temperature of the ram oil.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_minimumOilTemperature;
      @doc("The maximum allowable pressure of the ram filter.")
      @hashid P_LDM_Common_PSM::T_PressureInPascalType A_maximumFilterPressure;
      @doc("The minimum recommended pressure of the ram filter.")
      @hashid P_LDM_Common_PSM::T_PressureInPascalType A_minimumFilterPressure;
      @doc("A human readable identifier for the type name of the ram. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>
          Examples include:
          HYDRAULIC
          PNEUMATIC")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_ramTypeName;
   };

   @doc("Command to activate the solenoid")
   @mutable
   struct C_Solenoid_activateSolenoid
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_PercentageType A_activationLevel;
   };

   @doc("An installed motor.")
   @mutable
   struct C_Motor : C_Actuator
   {
      @doc("The actual motor temperature")
      @hashid @optional P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_motorTemperature;
      @doc("The current angulkar velocity of the actual motor, as measured from the motor looking along the shaft.  A negative value represents counter clockwise motion, and a positive value represents clockwise motion.")
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_motorSpeed;
   };

