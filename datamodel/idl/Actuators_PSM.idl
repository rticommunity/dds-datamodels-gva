   @mutable
   struct C_Motor_Specification : C_Actuator_Specification
   {
      @doc("The minimum operating temperature of the motor")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_minimumMotorTemperature;
      @doc("The maximum operating temperature of the motor")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_maximumMotorTemperature;
      @doc("A human readable identifier for the type name of the motor. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>
          Examples include:
          AC
          DC
          LINEAR
          SERVO")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_motorTypeName;
      @doc("The maximum speed of the specified Motor.")
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_maximumMotorSpeed;
      @doc("A Boolean which, when set to TRUE, indicates that the associated Motor supports the \"setMotorSpeed\" command.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setMotorSpeedSupported;
   };

