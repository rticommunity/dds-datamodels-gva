   @doc("Allows the operator to manually control the available actuators, such as heaters, air-conditioners, fans etc.  Note that this includes specific manual settings that may override automatic maintenance of environmental settings (e.g. \"Heater_Off\") and settings that enable automatic maintenance of environmental settings (e.g. \"Heater_Auto\").
       Each Environmental_Actuator_Setting is associated with one or more Environmental_Actuators, all of which must be of the same type.  When an Environmental_Actuator_Setting value is set, this setting is applied to all associated Environmental_Actuators.  This addresses the situation where there are, for example, a set of fans or heaters, all of which are to be controlled as a group.")
   @mutable
   struct C_Actuator_Setting
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_affectedActuator_sourceID;
   };

