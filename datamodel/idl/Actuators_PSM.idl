   @doc("An installed solenoid.")
   @mutable
   struct C_Solenoid : C_Actuator
   {
      @doc("The actual activation level of the solenoid
          The activation level represents the ratio of the current value of current or voltage in respect with the maximum value
          It is calculated according to the following formula:
          activationLevel = (actualValue - minValue) / (maxValue - minValue) * 100
          Example 1:
          The minimumCurrent and maximumCurrent values of a current driven solenoid are 0 and 0.75 amps respectively. The activationLevel corresponding to 0.375 amps is therefore 50%
          Example 2:
          The minimumVoltage and maximumVoltage values of a voltage driven solenoid are 2 and 24 Volts DC respectively. The actual voltage value corresponding to 50% is therefore 13 Volts DC.
          *The actualValue is easy derivable from the above formula.")
      @hashid P_LDM_Common_PSM::T_PercentageType A_activationLevel;
      @doc("The most recently reported current for the solenoid.")
      @hashid @optional P_LDM_Common_PSM::T_CurrentInAmpsType A_ampage;
      @doc("The most recently reported voltage for the solenoid.")
      @hashid @optional P_LDM_Common_PSM::T_VoltageInVoltsType A_voltage;
   };

   @doc("Specification data for the specified solenoid type.")
   @mutable
   struct C_Solenoid_Specification : C_Actuator_Specification
   {
      @doc("Minimum operating current of the solenoid")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_minimumCurrent;
      @doc("Maximum operating current of the solenoid")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumCurrent;
      @doc("Minimum operating voltage of the solenoid")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_minimumVoltage;
      @doc("Maximum operating voltage of the solenoid")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_maximumVoltage;
      @doc("A human readable identifier for the type name of the Solenoid. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_solenoidTypeName;
      @doc("A Boolean which, when set to TRUE, indicates that the associated Solenoid supports the \"activateSolenoid\" command.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_activateSolenoidSupported;
   };

