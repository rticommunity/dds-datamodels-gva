   // Specifies the set of relevant capabilities provided by the specified type of navigation resource.
   @mutable
   struct C_Navigation_Resource_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The maximum rate at which data outputs can be updated.
      // 
      // The accuracies and data rates would largely depend on the technologies used in the system, Laser Ring Gyros, Fiber Optic Gyros, GPS aided, etc.  Outputs at lower frequency are generally more accurate due to longer integration times. 
      @hashid P_LDM_Common_PSM::T_FrequencyInHertzType A_maximumDataCalculationRate;
      // The World Magnetic Model (WMM) is a large spatial-scale representation of the Earth's magnetic field. It consists of a degree and order 12 spherical-harmonic expansion of the magnetic potential of the geomagnetic main field generated in the Earth\rquote s core.
      // 
      // TRUE =WMM is supported
      // FALSE = WMM is not supported
      @hashid P_LDM_Primitive_PSM::T_Boolean A_worldMagneticModelSupported;
      // Indicates that the specified resource is able to take a set of waypoints and provide guidance to each waypoint in turn.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_routeGuidanceSupported;
      // A human readable identifier for the type name of the navigation resource. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<\i typeName>
      @hashid P_LDM_Common_PSM::T_DescriptorType A_resourceTypeName;
      // Indicates that the resource type is capable of providing sterring advice when navigating to a waypoint.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_steeringAdviceSupported;
      // References the output configuration of the navigation resource.  
      @hashid P_GVA_Common_PSM::T_IdentifierType A_supportedOutput_sourceID;
      // References the navigation resource setup capability information. 
      @hashid P_GVA_Common_PSM::T_IdentifierType A_supportedSetup_sourceID;
      // References the list of datum supported by the navigation resource.
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_supportedCoordinateDatumSpecifications_sourceID;
   };

