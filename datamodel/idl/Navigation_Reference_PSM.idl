   // Any device or integration service that provides navigation data.  Provides a starting point for accessing various items of navigation data.
   @mutable
   struct C_Navigation_Resource : C_Navigation_Equipment_Unit
   {
      // The selected North Reference i.e True North, Magnetic North or Grid North
      @hashid T_HeadingReferenceDatumType A_northReference;
      // The rates at which navigation data are to be provided by the specified navigation resource.
      @hashid T_DataOutputRateListType A_dataOutputRates;
      // At a given place and time, the horizontal angle between the true north and magnetic north measured east or west according to whether magnetic north lies east or west of true north.
      // 
      // Used to provide a correction value for navigation data.
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_magneticVariation;
      // The horizontal angle at a place between true north and grid north. It is proportional to the longitude difference between the place and the central meridian.
      // 
      // It is used to provide a correction value for navigation data.
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_gridConvergence;
      // References the specification of the navigation resource.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      // references the datum used by the navigation resource for output data.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_selectedCoordinateDatumSpecification_sourceID;
      // References the angular motion output by the navigation resource. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType, 3> A_reportedAngularMotions_sourceID;
      // References the attitude information output by the navigation resource.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_reportedAttitude_sourceID;
      // References the heading information output by the navigation resource. 
      @hashid P_GVA_Common_PSM::T_IdentifierType A_reportedHeading_sourceID;
      // References the linear motion information output by the navigation resource in its reference frame. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType, 3> A_reportedLinearMotions_sourceID;
      // References the navigation frame velocity information output by the navigation resource.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_reportedNavigationFrameVelocity_sourceID;
      // References the position output by this navigation resource.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_reportedPosition_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_utcTime_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_reportedCurrentWaypoint_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_selectedCoordinateSystemSpecification_sourceID;
   };

   // A GPS receiver is a device that accurately calculates geographical location by receiving information from GPS satellites.
   // 
   // The Global Positioning System (GPS) is a satellite-based navigation system made up of a network of a minimum of 24, but currently 30, satellites placed into orbit by the U.S. Department of Defense.
   @mutable
   struct C_GPS_Receiver : C_Navigation_Resource
   {
      // Indicates the current state of the key.
      @hashid T_GpsKeyedStatusType A_gpsKeyStatus;
      // GPS Ready (GPS providing full accuracy 3-D solution).
      @hashid P_LDM_Primitive_PSM::T_Boolean A_gpsReady;
      // Possible spoofers detected.
      // 
      // A GPS spoofing attack attempts to deceive a GPS receiver by broadcasting counterfeit GPS signals, structured to resemble a set of normal GPS signals, or by rebroadcasting genuine signals captured elsewhere or at a different time. These spoofed signals may be modified in such a way as to cause the receiver to estimate its position to be somewhere other than where it actually is, or to be located where it is but at a different time, as determined by the attacker.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_spoofersDetected;
      // The reported number of satellites used for position fixing.  This affects the accuracy of the available data.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_numberOfSatellitesAvailable;
      // Possible jammers detected.
      // 
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_jammersDetected;
   };

   // Used to validate INU internal data that enables giro errors correction when no GPS position is available and stored position is judged (system or even end-user) valid
   @mutable
   struct C_Inertial_Navigation_System_validateStoredInformationAlignmentData
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // An inertial navigation system (INS) is a navigation aid that uses a computer, motion sensors (accelerometers) and rotation sensors (gyroscopes) to continuously calculate via dead reckoning the position, orientation, and velocity (direction and speed of movement) of a moving object without the need for external references.
   @mutable
   struct C_Inertial_Navigation_System : C_Navigation_Resource
   {
      // Align Time to go (in seconds).
      // valid only when in operating mode IN_ALIGNMENT
      @hashid P_LDM_Common_PSM::T_DurationType A_alignTimeToGo;
      // Indicates that the INS requires a position input from the user.
      @hashid T_PositionUpdateStatusType A_positionUpdateStatus;
      // Zero-velocity-update (ZUPT) request. Zero velocity dead reckoning required.
      @hashid T_ZeroVelocityUpdateStatusType A_zeroVelocityUpdateStatus;
      // Flag set to true when INS receives information and information are valid from a GPS 
      // 
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_isAidedByGPS;
      // Flag set to true when INS receives information and information are valid from a speedometer
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_isAidedBySpeedometer;
      // Defines the alignment mode used by the INS.
      @hashid T_AlignmentModeType A_alignmentMode;
      // Flag set to true when INS detects that it is stationary
      @hashid P_LDM_Primitive_PSM::T_Boolean A_isStationary;
      // Defines the operating mode of the INS
      @hashid T_OperatingModeType A_operatingMode;
   };

