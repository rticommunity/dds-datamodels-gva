      // Indicates the support provided for Keyed GPS.
      // 
      // True = supported
      // False = not supported
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_keyedGpsSupported;
      // References the navigation resource specification. 
      @hashid P_GVA_Common_PSM::T_IdentifierType A_supportingResourceSpecification_sourceID;
   };

   // The reported angular motion expressed as angular velocity and angular acceleration.
   @mutable
   struct C_Angular_Motion
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The angular acceleration.
      // Angular acceleration is the rate of change of angular velocity. In SI units, it is measured in radians per second squared (rad/s2), and is usually denoted by the Greek letter alpha (\f1\'e1).
      @hashid @optional P_LDM_Common_PSM::T_AngularAccelerationInRadiansPerSecPerSecType A_angularAccelerationAboutAxis;
      // The angular velocity.
      // The angular velocity represents the rate of change of angular displacement and is a vector quantity which specifies the angular speed (rotational speed) of an object and the axis about which the object is rotating. This speed is measured in the SI unit of angular velocity, radians per second.  Angular velocity is usually represented by the symbol omega 
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_angularVelocityAboutAxis;
      // Defines the axis (X, Y, Z) to which the associated angular velocity and acceleration values apply.
      @hashid P_LDM_Common_PSM::T_Axis3DType A_axis;
   };

