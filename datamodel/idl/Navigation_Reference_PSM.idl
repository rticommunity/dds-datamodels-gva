   struct C_Speedometer : C_Navigation_Equipment_Unit
   {
      // The speed as reported by the speedometer.
      @hashid P_LDM_Common_PSM::T_SpeedInMetresPerSecType A_measuredSpeed;
   };

   // Represents a geographic coordinate system, which is a coordinate system that enables locations on the Earth to be specified by a set of numbers or letters, or symbols. The coordinates are often chosen such that one of the numbers represents vertical position, and two or three of the numbers represent horizontal position. A common choice of coordinates is latitude, longitude and elevation
   // 
   // For example,, the Universal Transverse Mercator (UTM) and Universal Polar Stereographic (UPS) coordinate systems both use a metric-based cartesian grid laid out on a conformally projected surface to locate positions on the surface of the Earth. The UTM system is not a single map projection but a series of sixty, each covering 6-degree bands of longitude. The UPS system is used for the polar regions, which are not covered by the UTM system.
   // 
   @mutable
   struct C_Coordinate_System_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A human readable identifier for the type name of the coordinate system. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // For example, CARTESIAN.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_coordinateSystemTypeName;
      // References the datum specification referenced by the coordinate system. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_coordinateDatumSpecifications_sourceID;
   };

   // The allowable datums and their codes for the Geodetic Datum fields.
   // 
   // All Spatial Data must be referenced to a coordinate system. Geographic Information on the earth must be referenced to a Coordinate Reference System (CRS) based on a set of Geodetic Parameters. ISO standard 19111:2007 defines the conceptual schema for the description of spatial referencing by coordinates.
   // 
   // In order to combine or use multiple data sources together they must make use of the same Coordinate Reference System (CRS). In some situations transformations are required between CRSs to convert data.
   // 
   // Default Coordinate System and Datum
   // Coordinate based calculations, and coordinate data published within the platform, should be performed within the same datum and coordinate system.  The LDM standard for this is WGS84 (reference STANAG 2211),  and this should be used for offboard messages too.  Presentation of coordinate data to the user in a more meaningful format (e.g. local grid coordinate system) should be in the user defined format.
   // Locally Displayed Coordinate System and Datum
   // The transformation from the default coordinate system to the user coordinate system should be carried out locally at the point of presentation (e.g. at the crewstation).
   @mutable
   struct C_Coordinate_Datum_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A human readable identifier for the type name of the coordinate datum. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 				
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      // 
      // For example, WGS84.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_coordinateDatumTypeName;
      // references the navigation resource that provide this coordinate system. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_supportingNavigationResourceSpecifications_sourceID;
      // references the coordinate system associated to the datum. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_baseCoordinateSystemSpecifications_sourceID;
   };

