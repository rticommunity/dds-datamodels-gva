   // The support for setting up various inputs to the specified type of navigation resource.  
   @mutable
   struct C_Navigation_Resource_Setup_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
