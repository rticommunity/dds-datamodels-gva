      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // This sets the value for the North Reference to 
      // True North
      // Magnetic North 
      // Grid North
      @hashid T_HeadingReferenceDatumType A_datum;
   };

   // Any device that provides navigation data.
   @mutable
   struct C_Navigation_Equipment_Unit
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The reported status of the unit.
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_onStatus;
      // The list of navigation resources that are used as inputs of the this navigation resource. For example, a GPS providing position information to an Inertial Navigation System. 
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_navigationEquipmentProvidingInputs_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_navigationEquipmentnUnitCP_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_owningPlatform_sourceID;
   };

