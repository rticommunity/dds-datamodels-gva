#ifndef NAVIGATION_REFERENCE_PSM__IDL
#define NAVIGATION_REFERENCE_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// Supports the setup and operation of all navigation devices installed on a platform.
// 				
// Responsibilities of this domain are:
// 	- provide access to navigation data provided by the various navigation resources (GPS, INS etc) on the platform;
// 	- provide integrated navigation data for the platform, derived from multiple navigation resources;
// 	- support configuration of the various navigation resources on the platform.
module P_Navigation_Reference_PSM
{
   // Specifies the possible values for reference datum.
   @appendable
   enum T_HeadingReferenceDatumType
   {
      L_HeadingReferenceDatum__Invalid,
      // Use magnetic north as reference.
      L_HeadingReferenceDatum__Magnetic_For,
      // Use true north as reference.
      L_HeadingReferenceDatum__Datum_True_For,
      // Use grid north as reference.
      L_HeadingReferenceDatum__Datum_Grid_For
   };

   // Indicates the status of the current GPS key.
   // 
   // No_Action_Required is used when:
   // - No actions related to keys are required
   // - Keys are not used/supported
   @appendable
   enum T_GpsKeyedStatusType
   {
      L_GpsKeyedStatus__Invalid,
      // The GPS does not have keys installed.
      L_GpsKeyedStatus__Key_Required,
      // The GPS received invalid keys. 
      L_GpsKeyedStatus__Invalid_Key_Received,
      // The GPS received valid keys. 
      L_GpsKeyedStatus__Key_Accepted,
      // No actions related to keys are required or and Keysv are not applicable.
      L_GpsKeyedStatus__No_Action_Required
   };

   // Provides an indication of accuracy.  Values are:
   // 
   // GDOP -  Geometric Dilution of Precision
   // 
   // GPS ranging errors are magnified by the range vector differences between the receiver and the SVs. The volume of the shape described by the unit-vectors from the receiver to the SVs used in a position fix is inversely proportional to GDOP.
   // 
   // GDOP is computed from the geometric relationships between the receiver position and the positions of the satellites the receiver is using for navigation. For planning purposes GDOP is often computed from Almanacs and an estimated position. Estimated GDOP does not take into account obstacles that block the line-of-sight from the position to the satellites. Estimated GDOP may not be realizable in the field.
   // 
   // CEP - Circular Error Probable
   // This is the value of the radius of a circle, centered at the actual position that contains 50% of the position estimates. Spherical Error Probable (SEP) is the spherical equivalent of CEP, that is the radius of a sphere, centered at the actual position, that contains 50% of the three dimension position estimates. As opposed to 2drms, drms, or RMS figures, CEP and SEP are not affected by large blunder errors making them an overly optimistic accuracy measure.
   // 
   // FOM - Figure of Merit
   // A FOM is an indicator of receiver positioning or time accuracy which may be displayed to the operator or communicated to an integrated system. A FOM may be either a qualitative or quantitative measure, depending on the accuracy and integrity of the data used to calculate the FOM. In general, a FOM is not suitable for making integrity decisions where safety of life is concerned. However, a qualitative FOM may be perfectly suitable for integrity decisions regarding unmanned missions.
   @appendable
   enum T_UncertaintyType
   {
      L_Uncertainty__Invalid,
      // Geometric Dilution of Precision uncertainty type
      L_Uncertainty__GDOP,
      // Figure Of Merit precision uncertainty type.
      L_Uncertainty__FOM,
      // Circular Error Probability uncertainty type.
      L_Uncertainty__CEP,
      // Error Rating uncertainty type.
      L_Uncertainty__Error_Rating,
      // No uncertainty available.
      L_Uncertainty__None_Available
   };

   // Describes the possible alignment modes for the INS. 
   @appendable
   enum T_AlignmentModeType
   {
      L_AlignmentMode__Invalid,
      // indicates that stored information are used in order to define initial position
      L_AlignmentMode__Stored_Information,
      // indicates alignment is waiting for information
      L_AlignmentMode__Standby,
      // indicates that alignment is performed on the basis of a previously received position and no movement is detected
      L_AlignmentMode__Static,
      // indicates that alignment is performed in motion on the basis of a position coming from the GPS and/or speed from speedometer
      L_AlignmentMode__In_Motion,
      // indicates that alignment is finalised
      L_AlignmentMode__Done,
      // indicates no valid information
      L_AlignmentMode__Unknown
   };

   // Describes the possible alignment modes for the INS. 
   @appendable
   enum T_OperatingModeType
   {
      L_OperatingMode__Invalid,
      // indicates INS is operating alignment
      L_OperatingMode__In_Alignment,
      // indicates INS is processing information
      L_OperatingMode__In_Survey,
      // indicates no valid information
      L_OperatingMode__Unknown
   };

   // Specifies the possible set of zero velocity update status types.
   // 
   @appendable
   enum T_ZeroVelocityUpdateStatusType
   {
      L_ZeroVelocityUpdateStatus__Invalid,
      L_ZeroVelocityUpdateStatus__Stop_Requested,
      L_ZeroVelocityUpdateStatus__In_Progress,
      L_ZeroVelocityUpdateStatus__No_Action_Required
   };

   // Specifies the possible set of position update status values.
   // 
   @appendable
   enum T_PositionUpdateStatusType
   {
      L_PositionUpdateStatus__Invalid,
      L_PositionUpdateStatus__No_Action_Required,
      L_PositionUpdateStatus__Position_Requested,
      L_PositionUpdateStatus__In_Progress
   };

   // Describes the possible types of naviagtion data.
   @appendable
   enum T_NavigationDataType
   {
      L_NavigationData__Invalid,
      L_NavigationData__All,
      L_NavigationData__Position,
      L_NavigationData__Heading,
      L_NavigationData__Attitude,
      L_NavigationData__Angular_Motion,
      L_NavigationData__Linear_Motion,
      L_NavigationData__Navigation_Frame_Velocity,
      L_NavigationData__UTC,
      L_NavigationData__Current_Waypoint
   };

   // This type specifies the the attributes of a waypoint.
   @mutable
   @nested
   struct T_WaypointType
   {
      // The name opf the waypoint.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_waypointName;
      // The number of the waypoint
      @hashid P_LDM_Primitive_PSM::T_Int16 A_waypointNumber;
      // The latitude of a waypoint
      @hashid P_LDM_Common_PSM::T_LatitudeType A_latitude;
      // The longitude of the waypoint
      @hashid P_LDM_Common_PSM::T_LongitudeType A_longitude;
   };

   // A type specifying a list of waypoints.
   typedef sequence <T_WaypointType> T_WaypointListType;

   // A type that specifies via its attributes, the rate if data output.
   @mutable
   @nested
   struct T_DataOutputRateType
   {
      // The type of data to which the output rate applies.
      @hashid T_NavigationDataType A_outputDataType;
      // The output rate for the specifed type of data.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_outputRate;
   };

   // A list of dat output rates.
   typedef sequence <T_DataOutputRateType> T_DataOutputRateListType;

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Navigation_Reference_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Specifies the associated Coordinate_System_Specification for this Navigation_Resource.
   @mutable
   struct C_Navigation_Resource_setCoordinateSystem
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // This defines the coordinate system selected in the form of a human readable identifier for the type name of the coordinate system. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<\i typeName>
      // 
      // For example, TYPE_NAME::GEODETIC
      @hashid P_LDM_Common_PSM::T_DescriptorType A_coordinateSystemTypeName;
   };

   // Sepcifies the current desired waypoint from the waypoint list supplied in an earlier "loadRouteToFollow" command.
   @mutable
   struct C_Navigation_Resource_setCurrentWaypoint
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Int16 A_waypointNumber;
   };

   // Used for smart navigation resources that have a routing capability as well as a position fixing capability.  Allows loading of a sequence of waypoints to be traversed.
   @mutable
   struct C_Navigation_Resource_loadRouteToFollow
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_WaypointListType A_waypointList;
   };

   // Used on occasions when it is required to set heading, for example for an IMU / INS that doesn\rquote t have a North Finding capability, there is no heading sensor or situations where a sensor such as a magnetic compass is giving known incorrect readings.
   @mutable
   struct C_Navigation_Resource_setCurrentHeadingAndUncertainty
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_BearingType A_heading;
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_uncertainty;
   };

   // This operation offsets the the position provided by the navigation value using the provided parameters. 
   // This operation is available even when the vehicle is in motion. 
   @mutable
   struct C_Navigation_Resource_setPositionOffsetAndUncertainty
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // Latitude offset between the position of the reference point and the position provided by the INU at the moment of the reference point crossing.
      @hashid P_LDM_Primitive_PSM::T_Double A_latitudeOffset;
      // Longitude offset between the position of the reference point and the position provided by the INU at the moment of the reference point crossing.
      // 
      @hashid P_LDM_Primitive_PSM::T_Double A_longitudeOffset;
      @hashid P_LDM_Primitive_PSM::T_Double A_altitudeOffset;
      // Uncertainty associated to the horizontal position.
      @hashid P_LDM_Primitive_PSM::T_Double A_positionUncertainty;
      // Uncertainty value associated to the altitude value.
      @hashid P_LDM_Primitive_PSM::T_Double A_altitudeUncertainty;
      // Type of the uncertainty value associated to the position information.
      @hashid T_UncertaintyType A_positionUncertaintyType;
      // Type of the uncertainty value associated to the altitude information.
      @hashid T_UncertaintyType A_altitudeUncertaintyType;
      // If this flag is set to false, the navigation equipment may reject the provided position and precision if it is not coherent with its current internal navigation information. 
      // If this flag is set to true, the navigation equipment must accept the new position and precision even if it is not coherent with its current internal navigation information. The navigation equipment may still refuse the position if it is incoherent with a more trusted navigation information source (such as a direct input from a gps).
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_force;
   };

   // Sets the current position and precision information for the navigation resource.
   @mutable
   struct C_Navigation_Resource_setCurrentPositionAndUncertainty
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The new position to apply.
      @hashid P_LDM_Common_PSM::T_Coordinate3DType A_position;
      // Value of the uncertainty associated to the horizontal position (latitude and longitude). 
      @hashid P_LDM_Primitive_PSM::T_Double A_positionUncertainty;
      // Value of the uncertainty of the altitude value.
      @hashid P_LDM_Primitive_PSM::T_Double A_altitudeUncertainty;
      // Type of the uncertainty associated to the horizontal position.
      @hashid T_UncertaintyType A_positionUncertaintyType;
      // Type of the uncertainty associated to the altitude value.
      @hashid T_UncertaintyType A_altitudeUncertaintyType;
      // If this flag is set to false, the navigation equipment may reject the provided position and precision if it is not coherent with its current internal navigation information. 
      // If this flag is set to true, the navigation equipment must accept the new position and precision even if it is not coherent with its current internal navigation information. The navigation equipment may still refuse the position if it is incoherent with a more trusted navigation information source (such as a direct input from a gps).
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_force;
   };

   // Requests the specified navigation resource to refresh the grid convergence value.
   @mutable
   struct C_Navigation_Resource_requestGridConvergence
