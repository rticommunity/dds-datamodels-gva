#ifndef ARBITRATION_PSM__IDL
#define ARBITRATION_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// The Arbitration domain provides the mechanism for arbitrating/ allocating control of Controllable Resources to Commanding Resources by an Arbitrator resource. The design does not preclude having more than one Arbitrator in a Mission System, but each Arbitrator must be providing the service for a different subset of Mission System resources.
//  The Arbitration module provides two protocols for setting up and tearing down exclusive relationships between Commanding and Controllable resources:
// Arbitration - A Request/Response protocol where an arbitrator reacts to requests and decides whether to act upon or deny the request for control of a resource.
// Allocation - A pro-active protocol where the Arbitrator is responsible monitoring system specific inputs, deciding which resource controls any other at a given point in time on the basis of these, and commands the Commanding and Controllable resources accordingly.
// Specifications to define scope of the decisions the arbiter can make. 
// Each Scenario described as a sequence diagram shows the protocol used as part of the title. 
module P_Arbitration_PSM
{
   @appendable
   enum T_Controllable_Resource_StateType
   {
      L_ControllableResourceState__Invalid,
      // The resource is not currently allocated to any commanding resource.
      L_ControllableResourceState__Unallocated,
      // The resource is currently allocated to a commanding resource.
      L_ControllableResourceState__Allocated
   };

   // The method to be used for a decision:
   //  - Undefined
   //  - Arbitration
   //  - Allocation
   @appendable
   enum T_ArbitrationMethodType
   {
      L_ArbitrationMethod__Invalid,
      L_ArbitrationMethod__Arbitrated,
      L_ArbitrationMethod__Allocated
   };

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Arbitration_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // A resource that can participate in arbitration of resources either as:
   // an Arbitrator which controls a set of decisions in the Mission System
   // a controlled resource that is the subject of a permutation of a decision
   // a commanding resources that is the subject of a permutation of a decision
   @mutable
   struct C_Arbitration_Participant
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_arbitrationParticipantCP_sourceID;
   };

   // Command to remove the controllable resource form the association of allocated resources using the allocation method
   @mutable
   struct C_Commanding_Resource_releaseAllocatedControlCommand
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the resource (or resource sub component that is to be released).
      @hashid P_GVA_Common_PSM::T_IdentifierType A_releasedResource;
   };

   // This command is part of the allocation method. It is used to add the Controllable Resource to the association of Allocated Resources.
   @mutable
   struct C_Commanding_Resource_allocateResourceCommand
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The identifier of the resource that the Commanding resource is to take control off.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_allocatedResource;
   };

   // This command is part of the Arbitration method. It Informs a Commanding_Resource that it should release control of a Controllable_Rresource using the. 
   @mutable
   struct C_Commanding_Resource_releaseArbitratedControlCommand
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // Identifies the Controlable_Resource to be released.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_releasedResource;
      // is the release forced:
      //  - false control can be retained if desired
      //  - true control must be released
      @hashid P_LDM_Primitive_PSM::T_Boolean A_forceRelease;
   };

   // This command is part of the Arbitration method. It Informs a Commanding_Resource that requested control of a Controllable_Resource has either been granted or denied.
   @mutable
   struct C_Commanding_Resource_acknowledgeArbitrationRequest
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // identifier of the Controlablle_Resource being requested 
      @hashid P_GVA_Common_PSM::T_IdentifierType A_requestedResource;
      // True= Request granted
      // False= Request denied
      @hashid P_LDM_Primitive_PSM::T_Boolean A_granted;
   };

   // A resource that can control other entities. Examples of this type of resource are:
   // a crew position
   // A Controllable resource may support either or both Arbitration protocols:
   //  - if it supports the arbitration method and the Permutation Groups it is linked to has the ARBITRATION setting  it can request control of Controllable resources from the Arbitrator.
   //  - if it supports the allocation method then it will wait for the Arbitrator to tell it which Controllable resource it should either take control of or release
   @mutable
   struct C_Commanding_Resource : C_Arbitration_Participant
   {
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_commandedResources_sourceID;
   };

   // Common to both Request driven and Pro-active lifecycles. Informs a Controllable_Rresource that it has been allocated to a Commanding_Resource .
   // 
   @mutable
   struct C_Controllable_Resource_allocateResource
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The Commanding_Resource to associate with
      @hashid P_GVA_Common_PSM::T_IdentifierType A_controller;
   };

   // Common to both Request driven and Pro-active lifecycles. Informs a Controllable_Resource that it is no longer allocated to its current controlling resource.
   // 
   // 
   @mutable
   struct C_Controllable_Resource_releaseResource
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The Commanding_Resource to be released from
      @hashid P_GVA_Common_PSM::T_IdentifierType A_controller;
   };

   // A resource that can be controlled by other entities. Examples of this type of resource are:
   // 
   // a singular resource e.g a Laser Range Finder 
   // a composite resource (i.e a number of resources acting as a singular resource). An example of a composite resource could be the main armament and the laser range finder both assigned to the Gunner..
   // 
   @mutable
   struct C_Controllable_Resource : C_Arbitration_Participant
   {
      @hashid T_Controllable_Resource_StateType A_currentState;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_commandingResource_sourceID;
   };

   // Captures common features of all resources that participate in arbitration.
   @mutable
   struct C_Arbitration_Participant_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Indicates whether or not a resource is capable of being controlled.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_isControllable;
      // A human readable identifier for the type name of the Arbitration participant. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // TYPE_NAME::<typeName>
      @hashid P_LDM_Common_PSM::T_DescriptorType A_arbitrationParticipantName;
   };

   // This required operation provides a placeholder for any behaviour that needs to be initiated in other domains when the specified object status changes.
   // 
   @mutable
   struct C_Arbitration_Participant_CP_objectStatusChanged
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // A human readable identifier for the name of the Object. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // OBJECT::<domainName>::<className>::<objectName>
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
      // Specifies the new status of the specified object.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_newStatus;
      // Provides a generic means to convey relevant data items for use in the bridge method and/or the invoked provided operation(s).
      @hashid P_LDM_Common_PSM::T_NameValuePairListType A_argumentList;
   };

