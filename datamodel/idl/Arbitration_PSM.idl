      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // A human readable identifier for the name of the Object. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
      // 
      // The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
      // 
      // OBJECT::<domainName>::<className>::<objectName>
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
   };

   // Placeholder for counterpart associations and services in build sets.
   @mutable
   struct C_Arbitration_Participant_CP
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_cpArbitrationParticipant_sourceID;
   };

   // This command is part of the arbitration Method. It indicates to the Arbitrator that a Commanding_Resource has acknowledged a request to release exclusive access to a resource.
   @mutable
   struct C_Arbitrator_releaseControlAcknowledge
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // identifier of the Cotrolloable_Resource being requested
      @hashid P_GVA_Common_PSM::T_IdentifierType A_resource;
      // true = release successful
      // false = release failed
      @hashid P_LDM_Primitive_PSM::T_Boolean A_released;
   };

   // This command is part of the arbitration Method. It requests the Arbitrator to provide exclusive control of a resource.
   //  
   @mutable
   struct C_Arbitrator_releaseExclusiveAccess
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // identifier of the Controllable_Resource to release
      @hashid P_GVA_Common_PSM::T_IdentifierType A_releaseResource;
   };

   // This command is part of the arbitration method. it requests the Arbitrator to provide exclusive control of a resource
   @mutable
   struct C_Arbitrator_requestExclusiveAccess
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // identifier of the Controllable_Resource being requested
      @hashid P_GVA_Common_PSM::T_IdentifierType A_resourceRequested;
   };

   // An Arbitrator is a resource involved in the arbitration function, a mission system
   // may contain more than one Arbitrator.  It represents a resource that performs
   // arbitration functions for the resources for which it is responsible:
   //  - Monitors the current allocated state of resources.
   //  - Consult the Arbitrator Specification for protocol and priority of permutations
   //  in allocation of resources.
   //  - Allocate resources based on the the Arbitrator Specification and their
   //  current allocated state
   //  - Inform resources of changes to their allocated state.
   // 
   // This model supports two protocols:
   //  - a reactive request mechanism where Controlling_Resources request control
   //  of resources from the arbitrator called Arbitration.
   //  - a pro-active allocation mechanism where the arbitrator reacts to the 
   //  changes at state and triggers changes in allocation (by tearing down
   //  and setting up new associations between Controllable and Controlling
   //  Resources) called Allocation
   // 
   // The selection of arbitration method is based on configuration data created
   //  at design time. While a system can contain more than one Arbitration object
   //  they must be working from mutually exclusive Specification data. I.e. only
   //  one Arbitrator shall determine the Controller of a controllable resource. 
   // 
   @mutable
   struct C_Arbitrator : C_Arbitration_Participant
   {
      @hashid P_GVA_Common_PSM::T_IdentifierType A_arbitratorSpecification_sourceID;
   };

   // Defines the set of permutation groups (decisions) that an Arbitrator is responsible for. For example an Arbitrator could responsible the Following Decisions:
   //  - Sight Control Selection
   //  - Battle Management system Input selection
   //  - Driver Camera Control Selection
   // With each permutation group having a number of possible permutations (outcomes).
   // This specification data for an Arbitrator instance must be specific to that instance. If there are two Arbitrator instances in a mission system there must be two separate Arbitrator specification hierarchies that are mutually exclusive with the specification data of any other Arbitrator instance. 
   @mutable
   struct C_Arbitrator_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A descriptor to associate a Rule set with an Arbitrator.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_arbitratorSpecificationDescription;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_ownsSelections_sourceID;
   };

   // Defines a single permutation (possible outcome) for a decision the Arbitrator could make. The permutation is described in terms of:
   // -  the Controllable_Resource and Controlling_Resource pair,
   // -  the priority of this permutation ( WRT to other permutations in the same group)
   // - if it is the defaultOwnership for this decision. A permutation where this attribute is true will be applied (using the Allocation protocol) whenever there is no other request or state data to select another permutation other than this one.
   // Please Note a Controllable Resource shall only be the target of any Permutations_Specifications associated with a Pemutation_Group and therefore a Single Arbitrator in the Mission System.  
   // 
   @mutable
   struct C_Arbitration_Permutation_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The relative priority of this permutation, under nominal circumstances the highest priority would win control. All Priorities on the option for a decision should be unique.  
      @hashid P_LDM_Primitive_PSM::T_Int32 A_priority;
      // Boolean to show if this is the default option for this decision. Only on option in a decision may have default set to true. 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_defaultOwnership;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_candidateCommandingResource_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_candidateCommandedResource_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_owningSelection_sourceID;
   };

   // Specifies a group of permutations that represent the possible outcomes for a particular decision. All permutations must share the same protocol arbitrationMethod:
   //  - Arbitration, Request driven, reactive.
   //  - Allocation, State driven, pro-active.
   // The Group also specifies if single or multiple simultaneous outcomes are supported. For example:
   // - A single possible outcome, who can control the drivers camera
   // - Multiple possible outcomes, which user controls each sight system, where you could have as many outcomes as there are controllable resources.
   // In a groups where a single outcome is allowed, only one Arbitration_Permutation_Specification may have defaultOwnership set.
   // Where Multiple OwnerShip is allowed then one permutation per Controllable resource is permitted but they must be mutually exclusive (i.e. different Controllers) 
   @mutable
   struct C_Arbitration_Permutation_Group_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The arbitration method to be used for this decision:
      //  - Arbitrated (ie request driven)
      //  - Allocated driven by external state data.
      @hashid T_ArbitrationMethodType A_arbitrationMethod;
      // An indication if Multiple simultaneous arbitration permutations are supported:
      // - False,  only one permutation allowed.
      // - True, One permutation per Controllable resource allowed.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_multipleOutcomesSupported;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_owningRuleSet_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_selectableOptions_sourceID;
   };
};

#endif
