   // Displays an image, the widget scales the image to it's size according to its displayFormat attribute and may insert black bars top and bottom and/or left and right to achieve the requested sacling.
   // 
   // When an image widget is created it should have no data and have its mimetype and url should be blank, displayFormat should be set to no scaling.
   // 
   // Note that the image widget specifically does not have a attribute with its current image data because this could be quite large and there is littlereason to put this on the wire.
   // 
   // 
   @mutable
   struct C_Image_Widget : C_Widget_With_Position
   {
      // The mime type of the data in the data attribute
