   };

   // A tabular representation of information.
   // 
   // On creation the implementation should calculate and publish the number of rows that fit in the table, and use the following defaults:
   // 
   // 2 columns each with 50% width, blank heading text, centre default justification 
   // column headings should be enabled
   // highlight disabled (highlightType = None).
   // title enabled but blank
   // 
   @mutable
   struct C_Table_Widget : C_Widget_With_Position
   {
      // The number of rows displayed in the table
      @hashid P_LDM_Primitive_PSM::T_Int16 A_rowCount;
      // A list of descriptors, 1 for each column each giving the width, heading and default justification for a column. The number of items in the list gives the number of columns.
      @hashid T_ColumnDescriptorListType A_columnDescriptorList;
      // The type of highlight that is current being shown on the table
      @hashid T_TableHighlightType A_highlightType;
      // The row to include in the highlight being shown as specified by the highlighType
      @hashid P_LDM_Primitive_PSM::T_Int16 A_highlightRow;
      // The column to include in the highlight being shown as specified by the highlighType
      @hashid P_LDM_Primitive_PSM::T_Int16 A_highlightColumn;
      // If enabled the current title of the table if the table title has been disabled then this optional attribute should not be transmitted
      @hashid @optional P_LDM_Primitive_PSM::T_MediumString A_title;
      // Indicates if the table column headings are enabled or disabled
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_columnHeadingsStatus;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_tableCells_sourceID;
   };

