      // The name of the key e.g. F1 or F11; referenced in other entities and commands
      @hashid P_LDM_Primitive_PSM::T_ShortString A_keyName;
      // Gives some idea of relative location of keys; keys on the top or bottom side should be numbered left to right, keys of the left or right side should be numbered top to bottom. Keys on the same side with adjacent numbers in their ordering should be physically adjacent to each other.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_order;
      // The programability of the hard button label indicates which parameters in the Hard_Button_Label::setDisplayedState will be acted on when using the operation on the key.
      @hashid T_HardButtonLabelProgrammabilityType A_programability;
      // Indicates side of the screen/page the key/label is on
