   // The display state for a label associated with a hard button associated with a specific third party page.
   @mutable
   struct C_Hard_Button_Label
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The text that should appear on the label if it is displayed. Note that this field is likely to be longer than the actual text  that can be fit on a label, the implementation is free to truncate text that is too long in any way it sees fit.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_text;
      // Indicates if this label is visible (true) or hidden (false)
      @hashid P_LDM_Primitive_PSM::T_Boolean A_visible;
      // Indicates how the label is displayed if it is visible (visible attribute is true) in which case display in an enabled state (true) or a disabled state (false); this should be combined with the showSelected attribute to determine exactly how to display the label.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_showEnabled;
      // Indicates how the label is displayed if it is not hidden (hidden attribute is false) in which case display in an selected  state (true) or a unselected state (false); this should be combined with the showEnabled attribute to determine exactly how to display the label.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_showSelected;
      // This is an indication to the Extensible HMI Application on how to style this hard button label. When this attribute is true it should be styled as the label of a button that causes the application to navigate to a new page in the menu hierarchy. When false it should be styled normal. The difference in the styles is implementation defined.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_navigationPage;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_thirdPartyPage_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hardButtonLabelSpecification_sourceID;
   };

