      // This indicates if the widget widget was able to correctly render the data which it has either been sent or has retrieved from the supplied URL It should be true if the Image_Widget has correctly renderd the image.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_renderedCorrectly;
      // The URL that was passed to the image widget to retrieve the image it is displaying from.
      @hashid @optional P_LDM_Common_PSM::T_URIType A_url;
   };

