      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // New value for the mouseEventsEnabled
      @hashid P_LDM_Primitive_PSM::T_Boolean A_mouseEventsEnabled;
      // New value for the buttonEventsEnabled
      @hashid P_LDM_Primitive_PSM::T_Boolean A_buttonEventsEnabled;
   };

   // Sets the attributes of the widget that control how it is displayed.
   @mutable
   struct C_Widget_styleWidget
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The new hidden value for the widget
      @hashid P_LDM_Primitive_PSM::T_Boolean A_visible;
      // The new styling value for the widget
      @hashid T_WidgetStyleType A_style;
   };

   // A cell in a table. A table cell is a widget but not a widget with position because its position is defined by its row and column in the table. It does have a size which should be calculated by the Extensible_HMI_Application and made available in its Widget instance.
   // 
   // On creation it should use the following defaults
   // 
   // contents - Text
   // text - blank string
   // justification - Default
   @mutable
   struct C_Table_Cell : C_Widget
   {
      // The cells column number in the table indexed from 0
      @hashid P_LDM_Primitive_PSM::T_Int16 A_column;
      // The text the cell is displaying if it is displaying text otherwise this optional attribute should not be transmitted
      @hashid @optional P_LDM_Primitive_PSM::T_MediumString A_text;
      // The type of contents the cell should display
      @hashid T_TableCellContentsType A_contents;
      // The cells row in the table indexed from 0
      @hashid P_LDM_Primitive_PSM::T_Int16 A_row;
      // The justification of the contents the cell is displaying, if set to default then the cell should be displayed using the default justification defined for the column
      @hashid T_HorizontalAlignmentType A_justification;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_tableWidget_sourceID;
   };

   // The Soft_Button event is used to inform the third party application that a soft button displayed on the HMI has been pressed.
   @mutable
   struct C_Soft_Button_Event
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The state of the soft button.
      @hashid P_LDM_Common_PSM::T_ButtonStateType A_state;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_widget_sourceID;
   };

   // Mouse information in relation to the mouse movement or use over the widget.
   @mutable
   struct C_Mouse_Event
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The mouse position over the widget reference from the top-left corner of the widget as the origin.
      @hashid P_LDM_Common_PSM::T_Position2DType A_position;
      // the units that the value of the position attribute is in
      @hashid T_UnitsType A_positionUnits;
      // The mouse button that is depressed.  Where possible the standard mouse numbering should be adhered to i.e.
      // 
      // 1 - Left Button
      // 2 - Middle Button (or scroll wheel click)
      // 3 - Right Button
      @hashid P_LDM_Primitive_PSM::T_Int16 A_depressedMouseButton;
      // Indicates if any modifier keys are depressed.
      @hashid T_ModifierKeyType A_modifierKey;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_widget_sourceID;
   };

