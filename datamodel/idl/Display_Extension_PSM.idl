   // A widget represents an on screen object that has a size, can be displayed or hidden and can be styled as a button, a checkbox or normally and that can receive button press or mouse events. It should be created with the following defaults
   // 
   // button events disabled
   // mouse events disabled
   // not checked
   // normal styling
   // visible
   @mutable
   struct C_Widget
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Indicates if button events are enabled (true) or disabled (false) for the widget.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_buttonEventsEnabled;
      // Indicates if mouse events are enabled (true) or disabled (false) for the widget
      @hashid P_LDM_Primitive_PSM::T_Boolean A_mouseEventsEnabled;
      // Holds the checked state of the widget, this may have no effect if the widget does not have checkbox styling
      @hashid P_LDM_Primitive_PSM::T_Boolean A_checked;
      // Gives the display style for the widget
      @hashid T_WidgetStyleType A_style;
      // Indicates if the widget is visible (true) or not (false). Widgets that are not visible can still receive status updates but should not generate mouse or button events.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_visible;
      // The size (extent) of this widget as calculated by the Extensible_MI_Application.
      @hashid P_LDM_Common_PSM::T_Size2DType A_size;
      // The units that the size attribute is in
      @hashid T_UnitsType A_sizeUnits;
   };

   // The result of a user text entry operation started by a call to Extensible_HMI_Application::requestUserTextEntry, the association to the Third_Party_Session should be filled in with the data received as the source id of this command.
