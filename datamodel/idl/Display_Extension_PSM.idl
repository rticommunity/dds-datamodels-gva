#ifndef DISPLAY_EXTENSION_PSM__IDL
#define DISPLAY_EXTENSION_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"
#include "Displays_And_Controls_PSM.idl"

// Provides status and control to allow an HMI Application to provide an interface for third parties to request a presence on the HMI for a platform. Examples of uses are
// 
// Calibration: Allowing the calibration process itself to stay in the domain of the equipment manufacturer but allowing a maintainer to interact with the calibration process through the equipment itself providing the calibration HMI
// 
// Addition of equipment to fulfil a UOR that was not part of the original platform and extending the HMI to support status and control from this equipment.
module P_Display_Extension_PSM
{
   // Defines the units in which widget positions and sizes are given
   @appendable
   enum T_UnitsType
   {
      L_Units__Invalid,
      // Absolute Pixels on the display
      L_Units__Pixel,
      // Percentage of overall screen height or width
      L_Units__Percentage,
      // 100ths of a percent of overall screen height or width
      L_Units__Percentage_100th,
      // Absolute Millimeters
      L_Units__Millimeter
   };

   // This gives an indication of the type of thing that the Third_Party_App is asking the user to enter
   @appendable
   enum T_UserTextEntryType
   {
      L_UserTextEntry__Invalid,
      L_UserTextEntry__Integer,
      L_UserTextEntry__Real,
      // The format is HH:MM:SS, where the hours shall be in range 0 to 23 and minutes shall be in the range 0 to 59 and seconds in the range 0 to 59.
      L_UserTextEntry__Time,
      // The format is either HH:MM::SS where the hours shall be in range 0 to 99 and minutes shall be in the range 0 to 59 and seconds in the range 0 to 59 or a single real  value followed by a 1 letter unit h - hours, m - minutes, s - seconds
      L_UserTextEntry__Duration,
      // Date and Time format. A Date Time variable shall be defined in the format YYYY MMM DD HH:MM:SS z for days, hours, minutes and seconds, z shall be timezone. The Time Zone can be a single character in the range A to Z excluding J or can given in thr format [+-]HH:MM
      L_UserTextEntry__Date_Time,
      L_UserTextEntry__Free_Text,
      // Location, in the format specified as the current Grid Format in the HMI_Desktop
      L_UserTextEntry__Location
   };

   // Enum to define the programability of a given label/key function
   @appendable
   enum T_HardButtonLabelProgrammabilityType
   {
      L_HardButtonLabelProgrammability__Invalid,
      // The programmable function key is fully programable; the 3rd party app can set its label text and its state
      L_HardButtonLabelProgrammability__Fully_Programmable,
      // The programable function key has a fixed function/text but the 3rd party app can indicate if the function is available. Note that for keys with this specification the system may choose to interpret the Hidden state as Display_Disabled
      L_HardButtonLabelProgrammability__State_Only,
      // They programmable function key does allow some variation but that variation is completely application defined e.g. GVA F13 key which can only display "Up" or "Cancel" but should always be available unless you are at the top screen of a menu stack.
      L_HardButtonLabelProgrammability__Custom
   };

   // Defines the side of the screen a key is placed placed on and therefore the side of the page its label will appear on
   @appendable
   enum T_HardButtonLocationType
   {
      L_HardButtonLocation__Invalid,
      L_HardButtonLocation__Top,
      L_HardButtonLocation__Bottom,
      L_HardButtonLocation__Left,
      L_HardButtonLocation__Right,
      L_HardButtonLocation__Other
   };

   // A list of unit types
   typedef sequence <T_UnitsType> T_UnitsListType;

   // The result of a user text entry operation which can be
   // 
   // OK - the operation succeeded and the entered text is supplied
   // Cancelled by the User - The user cancelled the operation themselves
   // Cancelled by System - The system cancelled the operation due to some outside circumstance.
   @appendable
   enum T_UserTextEntryResultType
   {
      L_UserTextEntryResult__Invalid,
      // Text entry was successful, text provided
      L_UserTextEntryResult__OK,
      // Text entry was cancelled by the user, no text is provided
      L_UserTextEntryResult__Cancelled_By_User,
      // Text entry was cancelled by the system, no text is provided
      L_UserTextEntryResult__Cancelled_By_System
   };

   // Gives a hint as to the desired location of the plan position indicator
   @appendable
   enum T_PPIPositionHintType
   {
      L_PPIPositionHint__Invalid,
      // This impementation does not support use of the positionHint
      L_PPIPositionHint__Unsupported,
      L_PPIPositionHint__Top_Left,
      L_PPIPositionHint__Top_Right,
      L_PPIPositionHint__Bottom_Left,
      L_PPIPositionHint__Bottom_Right
   };

   // A blob of binary data that should be interpretted as a standard image format (e.g. png, jif, tif, svg etc)
   typedef sequence <P_LDM_Primitive_PSM::T_Char> T_ImageDataType;

   // Indicates the type of highlight a table is displaying
   @appendable
   enum T_TableHighlightType
   {
      L_TableHighlight__Invalid,
      // No highlight, ignore highlight row and column
      L_TableHighlight__None,
      // Highlight cell identified by row and column
      L_TableHighlight__Cell,
      // Highlight row identified ignore column
      L_TableHighlight__Row,
      // Highlight column identified ignore row
      L_TableHighlight__Column,
      // Highlight both the row and the column identified
      L_TableHighlight__Row_And_Column
   };

   // Defines the contents of a table cell, for the icon types the actual icon is platform defined but should be designed to be approximate the same height as a single line of text on the display.
   @appendable
   enum T_TableCellContentsType
   {
      L_TableCellContents__Invalid,
      // Display the supplied text
      L_TableCellContents__Text,
      // Display tick icon
      L_TableCellContents__Icon_Tick,
      // Display cross icon
      L_TableCellContents__Icon_Cross,
      // Display spanner icon
      L_TableCellContents__Icon_Spanner,
      // Display exclamation icon
      L_TableCellContents__Icon_Exclamation,
      // Display error icon
      L_TableCellContents__Icon_Error,
      // Display warning icon
      L_TableCellContents__Icon_Warning
   };

   // This type contains a mime type as defined by RFC6838 (see https://tools.ietf.org/html/rfc6838). The length of this field follows the requirement set out in section 4.2 of this RFC.
   typedef sequence <P_LDM_Primitive_PSM::T_Char, 129> T_MimeTypeType;

   // This type describes a list of mime types
   typedef sequence <T_MimeTypeType> T_MimeTypeListType;

   // Specifies the format type.
   @appendable
   enum T_ImageDisplayFormatType
   {
      L_ImageDisplayFormat__Invalid,
      // The supplied image should be displayed in the image widget without any scaling (1 pixel of the image == 1 pixel of the Image_Widget). The image should be clipped where it is bigger than the image widget and black bars should be displayed where the image is smaller than the image widget. The center of the image should be at the center of the Image_Widget
      L_ImageDisplayFormat__No_Scaling,
      // The supplied image should be scaled such that either its height or width exactly fit the Image_Widget and the other dimention is bigger than the image widget; the aspect ratio of the image should be maintained and it should be displayed with the parts outside the Image_Widget extents clipped with the same amount clipped from opposite sides.
      L_ImageDisplayFormat__Maintain_Aspect_Ratio_Clip_Image,
      // The supplied image should be scaled such that either its height or width exactly fit the Image_Widget and the other dimention is smaller than the image widget; the aspect ratio of the image should be maintained and it should be displayed with black bars of equal width on either side of the dimension of the image that is smaller than the image widget.
      L_ImageDisplayFormat__Maintain_Aspect_Ratio_Full_Image,
      // The supplied image should be scaled and stretched to exactly fit the imiage widget; the aspect ratio of the image is not maintained
      L_ImageDisplayFormat__Stretch
   };

   // Describes a number of styles a widget can be displayed as. The the precise look and feel of any style is implementation defined.
   @appendable
   enum T_WidgetStyleType
   {
      L_WidgetStyle__Invalid,
      // The widget is styled normally for its type
      L_WidgetStyle__Normal,
      // The widget is styled as a push button
      L_WidgetStyle__Push_Button,
      // The widget is styled as a check box
      L_WidgetStyle__Checkbox
   };

   // Indicates which modifier keys are pressed
   @appendable
   enum T_ModifierKeyType
   {
      L_ModifierKey__Invalid,
      L_ModifierKey__None,
      L_ModifierKey__Shift,
      L_ModifierKey__Ctrl,
      L_ModifierKey__Alt,
      L_ModifierKey__Super,
      L_ModifierKey__Shift_Ctrl,
      L_ModifierKey__Shift_Alt,
      L_ModifierKey__Shift_Super,
      L_ModifierKey__Ctrl_Alt,
      L_ModifierKey__Ctrl_Super,
      L_ModifierKey__Alt_Super,
      L_ModifierKey__Shift_Ctrl_Alt,
      L_ModifierKey__Shift_Ctrl_Super,
      L_ModifierKey__Shift_Alt_Super,
      L_ModifierKey__Ctrl_Alt_Super,
      L_ModifierKey__Shift_Ctrl_Alt_Super
   };

   // Defines the justification used when displaying text in a widget
   @appendable
   enum T_HorizontalAlignmentType
   {
      L_HorizontalAlignment__Invalid,
      // Default justification may come from an object higher up the class hierarchy (i.e. from a Table for a Tablle_Cell) otherwise the application can set its own default)
      L_HorizontalAlignment__Default,
      L_HorizontalAlignment__Left,
      L_HorizontalAlignment__Centre,
      L_HorizontalAlignment__Right
   };

   // Define the column width and justification.
   @mutable
   @nested
   struct T_ColumnDescriptorType
   {
      // The width of the column as a percentage of the total table width
      @hashid P_LDM_Common_PSM::T_PercentageType A_width;
      // The default justification that should be used in the cells in the column if not overridden on a cell by cell basis
      @hashid T_HorizontalAlignmentType A_defaultJustification;
      // The heading text that should be displayed for the column.
      @hashid @optional P_LDM_Primitive_PSM::T_MediumString A_heading;
   };

   // A list of descriptors for a set of columns, e.g in a table
   typedef sequence <T_ColumnDescriptorType> T_ColumnDescriptorListType;

   // List of the subset of formatting styles that may or may not be supported by the application. Anything not on this list is not supported.
   @mutable
   @nested
   struct T_TextMarkupSupportedType
   {
      // Follows Wiki Mark-up			Yes
      // Name					Bold
      // Format					���<text>���
      // Example				���Bold���
      // Example Displays As (platform defined)	Bold
      @hashid P_LDM_Primitive_PSM::T_Boolean A_boldSupported;
      // Follows Wiki Mark-up			Yes
      // Name					Italics
      // Format					��<text>��
      // Example				��Italics��
      // Example Displays As (platform defined)	Italics
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_italicSupported;
      // Follows Wiki Mark-up			No
      // Name					Strike Through
      // Format					^^^<text>^^^
      // Example				^^^Strike Through^^^
      // Example Displays As (platform defined)	Strike Through
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_strikethroughSupported;
      // Follows Wiki Mark-up			No
      // Name					Highlight / Mark
      // Format					^^<text>^^
      // Example				^^ Highlight / Mark ^^
      // Example Displays As (platform defined)	Highlight / Mark
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_highlightSupported;
      // Follows Wiki Mark-up			Yes
      // Name					Bold + Italics
      // Format					�����<text>�����
      // Example				����� Bold + Italics�����
      // Example Displays As (platform defined)	Bold + Italics
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_boldAndItalicSupported;
      // Indicates that the following special characters are supported. If this attribute is set to TRUE then ALL of the following special characters MUST be supported.
      // 
      // No	Follows Wiki Mark-up	What you type	What it looks like	Notes	
      // 66	Yes	&amp;	&	Because & is special now in case you want one in the text	
      // 77	Yes	&nbsp;		A non-breaking space prevents a line break at that given point	
      // 88	Yes	&ndash;	-	Small hyphen (width of an N), not a -	
      // 99	Yes	&mdash;	-	Larger hyphen (width of an M) , not a -	
      // 110	Yes	&apos;	�	Because � is special e.g. in case you want italic text starting with a �	
      // 111	Yes	&quot;	�	For completeness	
      // 112	Sort of	&hat;	^	Because ^ is special	
      // 
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_specialCharactersSupported;
   };

   // Defines the justification used when displaying text in a widget
   @appendable
   enum T_VerticalAlignmentType
   {
      L_VerticalAlignment__Invalid,
      // Default justification may come from an object higher up the class hierarchy (i.e. from a Table for a Tablle_Cell) otherwise the application can set its own default)
      L_VerticalAlignment__Default,
      L_VerticalAlignment__Top,
      L_VerticalAlignment__Centre,
      L_VerticalAlignment__Bottom
   };

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Display_Extension_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // If supported requests creation of a Third_Party_Page by a Third_Party_Session as a child of this Page_Node to the specification identified.
   @mutable
   struct C_Page_Node_createChildPage
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The descriptor of the Third_Party_Session making the request
      @hashid P_LDM_Common_PSM::T_DescriptorType A_sessionDescriptor;
      // An identifier for the page to be created
      @hashid P_LDM_Common_PSM::T_UUIDType A_pageId;
      // The identifier of the page specification under which the page should be created
      @hashid P_LDM_Common_PSM::T_UUIDType A_pageSpecificationId;
   };

   // The PageNode defines the tree structure that defines the heirarchy of the pages created as Third_Party_Pages. An Extensible_HMI_Application that uses dynamic page creation creates bare PageNodes (i.e. a PageNode not a Third_Party_Page) to define the places that a Third_Party_Session can create child pages on. Because a Third_Party_Page is a PageNode (it generalises PageNode) child pages can also be created on Third_Party_Pages allowing the heirarchy to be built up.
   @mutable
   struct C_Page_Node
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_extensibleHmiApplication_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_dynamicExtensionPointSpecification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_parentPageNode_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_childPageNodes_sourceID;
   };

   // Provides the specification for a Page_Node.
   @mutable
   struct C_Page_Node_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // This descriptor provides a way to define the menu (e.g. SA, WPN, DEF, STR, COM, STR, BMS in GVA) that this Page_node exists in.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_locationDescriptor;
      // Indicates if the Page_Node::createChildPage operation is supported.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_createChildPageSupported;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_extensibleHmiApplicationSpecification_sourceID;
   };

   // This operation is used to inform the Third_Party_Session that it should reset its virtual page heirarchy. 
   // 
   // A third party application that has had a single Third_Party_Page assigned to it, where the static page allocation is in use, may choose to internally create a virtual page heirarchy to organise the data it is prepresenting. In this case the Extensible_HMI_Application has no visibility of where in that heirarchy the third party application may be. However there are cases where the heirarchy needs to be reset e.g. The menu button the page is under has been double pressed to return to the top page in the menu and then the user has navigated back through the heirarchy to the Third_Party_Page. In this case the third party application needs to know to start back from the top of its page heirarchy. This function fulfills the requirement to start again from the top onto the third party application.
   @mutable
   struct C_Third_Party_Session_resetVirtualPageHierarchy
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // The Third_Party_Session presents a third party applications presence within this PIM nd it used to associate it the the Third_Party_Pages it is using.
   @mutable
   struct C_Third_Party_Session
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // A descriptor identifying the Third_Party_Session, used if the session creates calls the operation Page_Node::createChildPage
      @hashid P_LDM_Common_PSM::T_DescriptorType A_sessionDescriptor;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_thirdPartyPages_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_thirdPartyApplicationCP_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_thirdPartySessionSpecification_sourceID;
   };

   // Request the HMI application to go down from this Third_Party_Page in the page hierarchy, activating a child Third_Party_Page of the current Third_Party_Page. 
   // 
   // Note that this command is only valid if 
   // 
   //   1. It is issued to a Third_Party_Page that is actually active 
   //   2. It is issued by the Third_Party_Session that owns the Third_Party_Page 
   //   3. The child Third_Party_Page referenced by the parameter is actually 
   //       a child of the Third_Party_Page the command is issued to. 
   // 
   // 
   @mutable
   struct C_Third_Party_Page_activateChildPage
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The UUID of the child page to activate
      @hashid P_LDM_Common_PSM::T_UUIDType A_childPageId;
   };

   // Request the HMI application to go up in the page hierarchy from this third-party page. 
   // 
   // Note that this command is only valid if 
   // 
   //   1. It is issued to a Third_Party_Page that is actually active 
   //   2. It is issued by the Third_Party_Session that owns the Third_Party_Page *
   // 
   // Going up from a third party page could go to a different third party page or could return to a system page provided by the HMI application.
   // 
   // * This does not prevent the Extensible HMI Application from just changing the active page due to some other event as the HMI application would not issue the command to itself.
   @mutable
   struct C_Third_Party_Page_upFromPage
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // Removes the page and deletes all resources associated with it including deleting all widgets and recursively deleting all sub-pages and their widgets.
   // 
   // If is only valid to call this operation on a page that was created by Page_Node::createChildPage.
   @mutable
   struct C_Third_Party_Page_destroy
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // If supported requests the creation of a widget with the given type and attributes on this page.
   // 
   // If the size and position do not fit on the screen the Extensible_HMI_Application is free to fail the request.
   @mutable
   struct C_Third_Party_Page_createWidget
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
