      // The new setting to be used for the hidden state of the Hard_Button_Label
      @hashid P_LDM_Primitive_PSM::T_Boolean A_hidden;
      // The new setting to be used for the showEnabled state of the Hard_Button_Label
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_showEnabled;
