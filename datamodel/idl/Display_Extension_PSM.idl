   // An event indicating a new state for 1 of the hard buttons on the applications bezel. This should be sent whenever the Extensible_HMI_Application is displaying a Third_Party_Page and the user presses a hard button (or if supported touches the label displayed for that button) which the Extensible_HMI_Application will not handle itself (e.g. the F1 key).
   // 
   // These events should always be sent regardless of the state of the Hard_Button_Label, it is up to the Third_Party_Session to decide if the button press has any meaning to it.
   @mutable
   struct C_Hard_Button_Event
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The state of the hard button
      @hashid P_LDM_Common_PSM::T_ButtonStateType A_state;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hardButtonLabel_sourceID;
   };

   // Multi line widgets automatically take care of new lines and wrap between words.
   @mutable
   struct C_Multi_Line_Text_Widget : C_Text_Widget
   {
      // The number of lines that the widget supports.
