   // Specifies the category of  an Alarm Condition (and subsequent Alarm).
   // 
   // Alarm_Category_Specification defines the categories of Alarms that can exist and codifies some of their behaviour.
   // 
   // In GVA the categories are:
   // 
   //   Warning (highest priority)
   //   Caution
   //   Advisory (lowest priority)
   //  
   @mutable
   struct C_Alarm_Category_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Specifies the name of the Alarm category.
      // 
      // In GVA the possible names are Warning, Caution and Advisory.
      @hashid T_AlarmCategoryType A_alarmCategory;
      // Specifies whether an Alarm of this category is annunciated to the user. If annunciated it would be capable of being acknowledged and repeated.
      // 
      // For example in GVA, Advisories are not annunciated to the crew through text message display or audio tone. They would however appear in the Alarm Register.
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_annunciateSupported;
      // Specifies the timeout period before a previously acknowledged Alarm of this category is reannunciated to the crew.
      // 
      // The value of this attribute has no meaning if annunciateSupported is false.
      @hashid P_LDM_Common_PSM::T_DurationType A_reannunciateTimeout;
      // Specifies whether an Alarm Condition of this category can be overridden.
      // 
      // When an Alarm Condition is overridden, any occurrence of the Alarm will not result in an audio or visual annunciation of that Alarm.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideSupported;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_alarmCategorySpecificationCP_sourceID;
   };
};

#endif
