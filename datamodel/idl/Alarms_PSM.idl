#ifndef ALARMS_PSM__IDL
#define ALARMS_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// This domain defines the data produced in generation of alarm conditions and associated alarms.
module P_Alarms_PSM
{
   @appendable
   enum T_Alarm_StateType
   {
      L_AlarmState__Invalid,
      // The alarm condition has ended.
      L_AlarmState__Resolved,
      // The alarm has not yet been acknowleged.
      L_AlarmState__Active_Unacknowledged,
      // The alarm has been acknowledged.
      L_AlarmState__Active_Acknowledged,
      // The initiating alarm condition has been cleared.
      L_AlarmState__Cleared
   };

   @appendable
   enum T_Alarm_Condition_StateType
   {
      L_AlarmConditionState__Invalid,
      // Represent a state where the alarm condition is currently active.
      L_AlarmConditionState__Active,
      // Represents a state where the alarm condition is not currently active.
      L_AlarmConditionState__Inactive
   };

   // The AlarmCategoryType specifies the priority of the Alarm.
   @appendable
   enum T_AlarmCategoryType
   {
      L_AlarmCategory__Invalid,
      L_AlarmCategory__Warning,
      L_AlarmCategory__Caution,
      L_AlarmCategory__Advisory
   };

   // A list of unique Identifier of resources.
   typedef sequence <P_GVA_Common_PSM::T_IdentifierType> T_IdentifierTypeListType;

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Alarms_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // An operation to add an annotation to the specified Alarm.
   @mutable
   struct C_Alarm_annotate
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_LongString A_annotationText;
   };

   // An operation to clear the specified Alarm.
   @mutable
   struct C_Alarm_clear
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // An operation to acknowledge the specified Alarm.
   @mutable
   struct C_Alarm_acknowledge
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // Represents an instance of an Alarm.
   // 
   // When, in the external system, a condition occurs that is specified by an Alarm_Condition_Specification, a corresponding Alarm_Condition and Alarm is created.
   // 
   // For example, if an Engine Fire occurs, an Alarm instance will be created to manage the notifications to the vehicle crew. The Alarm goes through various states as it is actioned by the crew (e.g. acknowledged) or, for example, if the originating Alarm_Condition ceases.
   @mutable
   struct C_Alarm
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Reports the point in time at which the originating Alarm_Condition ceased (i.e. became inactive).
      @hashid @optional P_LDM_Common_PSM::T_DateTimeType A_conditionEndTime;
      // Reports the time at which this Alarm was last Acknowledged.
      @hashid @optional P_LDM_Common_PSM::T_DateTimeType A_lastAcknowledgeTime;
      // Reports the number of times the Alarm has been annunciated. This number increments each time the Alarm is re-annunciated to the user following the reannunciateTimeout.
      // 
      @hashid P_LDM_Primitive_PSM::T_Int16 A_annunciationCount;
      // Reports the annotation text which can be added to an Alarm, providing additional information about the Alarm.
      @hashid @optional P_LDM_Primitive_PSM::T_LongString A_annotation;
      // Reports the point in time at which the originating Alarm_Condition started (i.e. became active).
      @hashid P_LDM_Common_PSM::T_DateTimeType A_conditionStartTime;
      @hashid T_Alarm_StateType A_currentState;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_causingCondition_sourceID;
   };

   // The specification of a Alarm Condition possible on a platform.  
   @mutable
   struct C_Alarm_Condition_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Specifies the unique description of an Alarm Condition which can cause an Alarm.
      // 
      // This could be made up of a combination of Subsystem - Component - Measure - Nature
      // 
      // An example of such an alarmConditionDescription might be:
      // 
      //    "Engine Oil Pressure Low"
      // 
      // In this example:
      // 
      // The Component is "Engine". This is the major vehicle component in which the Alarm Condition can occur or be detected.
      // 
      // The Subsystem is "Oil". This is the subsystem within the component which the Alarm Condition can occur or be detected.
      // 
      // The Measure is "Pressure". This is the physical quantity or measure which has deviated from an acceptable value.
      // 
      // The Nature is "Low".  This is the nature of the deviation of the physical measure.
      // 
      // 
      // 
      @hashid P_LDM_Common_PSM::T_DescriptorType A_alarmConditionDescription;
      // Specifies the text to be displayed when an Alarm of this type occurs.  This is a free-text field which  provides a more "user friendly" representation of message than the alarmConditionDescription.
      // 
      @hashid P_LDM_Primitive_PSM::T_LongString A_alarmText;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_alarmConditionSpecificationCP_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_alarmCategory_sourceID;
   };

   // An operation to remove the override from the specified Alarm Condition, meaning that annunciations (audio and visual) are again received for Alarms related to this Alarm Condition.
   @mutable
   struct C_Alarm_Condition_removeOverride
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // An operation to override the specified Alarm Condition, meaning that annunciations (audio or visual) are no longer received for the current or any future Alarms related to the Alarm Condition.  
   @mutable
   struct C_Alarm_Condition_override
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // Represents an occurrence of an Alarm Condition.  
   // 
   // Although closely related to an Alarm, this is not exactly the same thing. An Alarm_Condition will result in an Alarm. However, an Alarm_Condition in a vehicle may cease (e.g. an engine temperature returns to within normal limits) but the associated Alarm will remain until explicitly cleared.
   // 
   // When an Alarm Condition is created for the first time, it enters the Active state. It then persists for the mission, in either the Active or Inactive state.
   // 
   // 
   // 			
   @mutable
   struct C_Alarm_Condition
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Represents the ID of the Resource(s) for which the condition was detected.
      // 
      // Note that as far as the Alarms module is concerned, this ID is just some string provided by the detecting system.
      @hashid T_IdentifierTypeListType A_conditionSourceId;
      // Represents whether or not the Alarm Condition has been overridden.
      // 
      // When an Alarm Condition is overridden, any occurrence of the Alarm will not result in an Audio or Visual annunciation of that Alarm.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_overridden;
      // Reports the number of times this Alarm Condition has been raised (during the mission).
      @hashid P_LDM_Primitive_PSM::T_Int16 A_raisedCount;
      @hashid T_Alarm_Condition_StateType A_currentState;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
   };

