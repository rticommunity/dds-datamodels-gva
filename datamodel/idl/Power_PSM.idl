   @doc("This represents the state of the selected Inverter  (power converting resource).")
   @mutable
   struct C_Inverter : C_Power_Converting_Resource
   {
      @doc("This represents the phase angle of the inverter.")
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_phase;
