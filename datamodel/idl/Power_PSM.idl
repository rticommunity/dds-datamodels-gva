      @doc("A human readable identifier for the type name of the component. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_componentTypeName;
      @doc("If TRUE, indicates that a soft shutdown is required for this type of power consuming resource.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_softShutdownRequired;
   };

   @doc("This represents the static (specification) values of a generator.")
   @mutable
   struct C_Generator_Specification : C_Power_Providing_Resource_Specification
   {
      @doc("This represents the type of generator in use.")
      @hashid T_GeneratorType A_typeOfGenerator;
   };

   @doc("This represents the static (specification) values of a channel.")
   @mutable
   struct C_Channel_Specification : P_Distribution_Network_PSM::C_Distribution_Network_Component_Specification
   {
      @doc("The state a channel goes to when a reversionary power override is applied")
      @hashid T_PowerOnStateType A_defaultOnState;
      @doc("This represents the maximum continuous trip current of the power distribution component.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumContinuousCurrent;
      @doc("The state a channel goes to when a reversionary power override is applied")
      @hashid T_PowerOnStateType A_powerReversionaryState;
      @doc("A human readable identifier for the type name of the component. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_componentTypeName;
      @doc("BOOLEAN that indicates if the Channel can report when an over voltage condition is present.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overvoltageSupported;
   };
};

