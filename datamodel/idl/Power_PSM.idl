      @doc("Indicates the current power saving status of the power consuming resource.")
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_powerSavingStatus;
   };

   @doc("This causes the setting of the operating mode of the Power Providing Resource")
   @mutable
   struct C_Power_Providing_Resource_setPowerProvidingResourceMode
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_Power_Providing_Resource_StateType A_currentState;
   };

   @doc("This represents the state of the selected AC generator  (power providing resource).")
   @mutable
   struct C_AC_Generator : C_Power_Providing_Resource
   {
      @doc("This represents the phase angle of the generator.")
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_phase;
      @doc("This represents the frequency of the generator.")
      @hashid P_LDM_Common_PSM::T_FrequencyInHertzType A_frequency;
   };

   @doc("This represents the state of the selected Direct Current converter (power converting resource).
       NB  A Direct Current converter may be an Alternating Current to Direct Current converter or a Direct Current to Direct Current converter.")
   @mutable
   struct C_DC_Converter : C_Power_Converting_Resource
   {
      @doc("This represents the voltage ripple of the converter.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_noise;
      @hashid T_DC_Converter_StateType A_converterMode;
   };

   @doc("This represents the static (specification) values of a generator.")
   @mutable
   struct C_Power_Providing_Resource_Specification : P_Distribution_Network_PSM::C_Distribution_Network_Component_Specification
   {
      @doc("This represents the maximum power that can be developed by the resource.")
      @hashid P_LDM_Common_PSM::T_PowerInWattsType A_maximumPower;
      @doc("This represents the maximum output voltage of the resource.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_maximumOutputVoltage;
      @doc("This represents the nominal output voltage of the resource type.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_nominalOutputVoltage;
      @doc("This represents the maximum instantaneous current (discharge current if a battery) that can be supplied by the resource type.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumInstantaneousCurrent;
      @doc("This represents the maximum continuous current (discharge current if a battery) that can be supplied by the power providing resource type.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumContinuousCurrent;
      @doc("This represents the maximum operating temperature of the environment in which the resource type will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_maximumOperatingTemperature;
      @doc("This represents the minimum operating temperature of the environment in which the resource type will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_minimumOperatingTemperature;
      @doc("A human readable identifier for the type name of the resource. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_componentTypeName;
   };

   @doc("This represents the static (specification) values of a fuel cell.")
   @mutable
   struct C_Fuel_Cell_Specification : C_Power_Providing_Resource_Specification
   {
      @doc("This represents the type of Fuel Cell in use.")
      @hashid T_FuelCellType A_typeOfCell;
      @doc("This represents the type of Fuel in use.")
      @hashid T_FuelCellFuelType A_typeOfFuel;
      @doc("This states whether or not the installed battery supports temperature measurement.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_temperatureSupported;
      @doc("Indicates that this type of fuel cell can provide its remaining fuel level.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_remainingFuelSupported;
   };

   @doc("This represents the static (specification) values of a battery.")
   @mutable
   struct C_Battery_Specification : C_Power_Providing_Resource_Specification
   {
      @doc("This represents the type of battery in use.")
      @hashid T_BatteryType A_typeOfBattery;
      @doc("Reports the nominal capacity of the battery.")
      @hashid P_LDM_Common_PSM::T_CapacityInAmpereHoursType A_nominalCapacity;
      @doc("This represents ideal current at which the battery is initially charged a under constant charging scheme.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_nominalContinuousChargeCurrent;
      @doc("This represents the nominal operating voltage of the battery.
          Nominal operating voltage is the operating voltage during standard discharge following a standard charge.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_nominalOperatingVoltage;
      @doc("This represents the minimum allowable battery voltage (i.e the voltage that defines the \"empty\" state of the battery).")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_dischargeCutOffVoltage;
      @doc("This states whether or not a fast charge profile is supported")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supportsFastCharge;
      @doc("This states whether or not a trickle charge profile is supported.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supportsTrickleCharge;
      @doc("This states whether or not the installed battery supports temperature measurement.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_temperatureSupported;
      @doc("Indicates that this type of battery can provide its remaining charge level.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_remainingChargeSupported;
   };

   @doc("This represents the static (specification) values of a generalised Power converter.")
   @mutable
   struct C_Power_Converter_Specification : P_Distribution_Network_PSM::C_Distribution_Network_Component_Specification
   {
      @doc("This represents the maximum voltage supplied at the converter output.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_maximumOutputVoltage;
      @doc("This represents the nominal voltage supplied at the converter output.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_nominalOutputVoltage;
      @doc("This represents the maximum continuous current that can be supplied by the converter.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumContinuousCurrent;
      @doc("This represents the maximum instantaneous current supplied by the converter to the load.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumInstantaneousCurrent;
      @doc("This represents the maximum operating temperature of the environment in which the converter will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_maximumOperatingTemperature;
      @doc("This represents the minimum operating temperature of the environment in which the converter will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_minimumOperatingTemperature;
      @doc("A human readable identifier.")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_powerConverterTypeName;
      @doc("A human readable identifier for the type name of the component. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_componentTypeName;
      @doc("BOOLEAN that indicates if the power converter can report when an over voltage condition is present.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overvoltageSupported;
   };

   @doc("This represents the static (specification) values of a converter.")
   @mutable
   struct C_DC_Converter_Specification : C_Power_Converter_Specification
   {
      @doc("This represents the type of converter in use.")
      @hashid T_DCConverterType A_typeOfConverter;
      @doc("This represents the nominal input voltage of the converter.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_nominalInputVoltage;
      @doc("This represents the maximum input voltage of the converter.")
