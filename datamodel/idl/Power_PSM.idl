      @doc("This represents the minimum input voltage of the inverter.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_minimumInputVoltage;
   };

   @doc("This represents the static (specification) values of a power consuming resource.")
   @mutable
   struct C_Power_Consuming_Resource_Specification : P_Distribution_Network_PSM::C_Distribution_Network_Component_Specification
   {
