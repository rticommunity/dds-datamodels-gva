      @doc("This represents the specified current limit of the inverter.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_currentLimit;
      @hashid T_Inverter_StateType A_connection;
   };

   @doc("This represents the static (specification) values of a charger.")
   @mutable
   struct C_Charger_Specification : C_Power_Converter_Specification
   {
      @doc("This defines whether intelligent charging is supported by the charger.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supportsIntelligentCharging;
      @doc("This defines whether fast charging is supported by the charger")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supportsFastCharging;
      @doc("This defines whether trickle charging is supported by the charger.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_supportsTrickleCharging;
      @doc("If TRUE, indicates that the charger operating mode can be set using a command.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setChargerOperatingModeSupported;
   };

   @doc("This reports the static (specification) values of an inverter.")
   @mutable
   struct C_Inverter_Specification : C_Power_Converter_Specification
   {
      @doc("This represents the nominal input voltage of the inverter.")
