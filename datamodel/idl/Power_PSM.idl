#ifndef POWER_PSM__IDL
#define POWER_PSM__IDL

#include "Distribution_Network_PSM.idl"
#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

@doc("Control of power related components is the primary purpose of this domain.
    Responsibilities of this domain are:
    setting power node component limits where applicable
    controlling power node component shutdown if required
    controlling  power node component operating modes
    monitoring  power node component parameters
    NB: Power management is not included in this domain and is expected to be performed by an application domain.")
module P_Power_PSM
{
   @appendable
   enum T_Charger_StateType
   {
      L_ChargerState__Invalid,
      @doc("The charger is connected and is supplying an intelligent charge to the load (i.e. the charge to the load is following a defined profile).")
      L_ChargerState__Connected_Intelligent,
      @doc("The charger is connected and is supplying a fast charge to the load.")
      L_ChargerState__Connected_Fast,
      @doc("The charger is connected and is supplying a trickle charge to the load (i.e..a fully charged battery is charged under no-load at a rate equal to its self-discharge rate, thus enabling the battery to remain at its fully charged level).")
      L_ChargerState__Connected_Trickle,
      @doc("The charger is isolated from the load.")
      L_ChargerState__Isolated
   };

   @appendable
   enum T_DC_Converter_StateType
   {
      L_DCConverterState__Invalid,
      @doc("The converter is connected and is supplying power to the load.")
      L_DCConverterState__Connected,
      @doc("The converter is isolated from the load.")
      L_DCConverterState__Isolated
   };

   @appendable
   enum T_Channel_StateType
   {
      L_ChannelState__Invalid,
      @doc("The selected channel is isolated from the load.")
      L_ChannelState__Isolated,
      @doc("The selected channel is connected but is switched to prevent it from suppling power to the load.")
      L_ChannelState__Connected_Off,
      @doc("The selected channel is connected and is switched to be able to supply power to the load.")
      L_ChannelState__Connected_On
   };

   @appendable
   enum T_Power_Distribution_Node_StateType
   {
      L_PowerDistributionNodeState__Invalid,
      @doc("The selected channel is isolated from the load.")
      L_PowerDistributionNodeState__Isolated,
      @doc("The selected channel is connected but is switched to prevent it from suppling power to the load.")
      L_PowerDistributionNodeState__Connected_Off,
      @doc("The selected channel is connected and is switched to be able to supply power to the load.")
      L_PowerDistributionNodeState__Connected_On
   };

   @appendable
   enum T_Power_Providing_Resource_StateType
   {
      L_PowerProvidingResourceState__Invalid,
      L_PowerProvidingResourceState__Connected,
      L_PowerProvidingResourceState__Isolated
   };

   @appendable
   enum T_Inverter_StateType
   {
      L_InverterState__Invalid,
      @doc("The Inverter is connected and is supplying power to the load.")
      L_InverterState__Connected,
      @doc("The Inverter is isolated from the load.")
      L_InverterState__Isolated
   };

   @doc("Enumerated Fuel Cell types.")
   @appendable
   enum T_FuelCellType
   {
      L_FuelCell__Invalid,
      L_FuelCell__Alkali,
      L_FuelCell__PEM,
      L_FuelCell__Solid_Oxide
   };

   @doc("Enumerated fuel types for Fuel Cells.")
   @appendable
   enum T_FuelCellFuelType
   {
      L_FuelCellFuel__Invalid,
      L_FuelCellFuel__Diesel,
      L_FuelCellFuel__Hydrogen,
      L_FuelCellFuel__Methanol
   };

   @doc("Enumerated generator types.")
   @appendable
   enum T_GeneratorType
   {
      L_Generator__Invalid,
      L_Generator__APU,
      L_Generator__Main
   };

   @doc("Enumerated Battery types.")
   @appendable
   enum T_BatteryType
   {
      L_Battery__Invalid,
      L_Battery__Lead_Acid,
      L_Battery__Lithium_Ion
   };

   @doc("Enumerated DC Converter types.")
   @appendable
   enum T_DCConverterType
   {
      L_DCConverter__Invalid,
      L_DCConverter__AC_DC,
      L_DCConverter__DC_DC
   };

   @doc("Defines the state entered when the resource is connected.")
   @appendable
   enum T_PowerOnStateType
   {
      L_PowerOnState__Invalid,
      L_PowerOnState__On,
      L_PowerOnState__Off
   };

   @doc("Specifies the state entered when resetTrip is invoked.")
   @appendable
   enum T_ResetTripStateType
   {
      L_ResetTripState__Invalid,
      L_ResetTripState__Reset_To_Off,
      L_ResetTripState__Reset_To_On,
      L_ResetTripState__Reset_Manual
   };

   @doc("All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.")
   @mutable
   struct C_Power_CommandResponse
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure")
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      @doc("LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.")
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   @doc("This represents a generic power providing resource.
       Power providing resources in the system may be batteries, fuel cells, Direct Current generators or Alternating Current generators.")
   @mutable
   struct C_Power_Providing_Resource : P_Distribution_Network_PSM::C_Source
   {
      @doc("This represents the instantaneous current supplied by the the resource.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_current;
      @doc("This represents the instantaneous resource voltage.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltage;
      @hashid T_Power_Providing_Resource_StateType A_currentState;
   };

   @doc("This causes the setting of the operating mode of the charger.")
   @mutable
   struct C_Charger_setChargerOperatingMode
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_Charger_StateType A_setMode;
   };

   @doc("This represents a generic power converting resource.
       Power converting resources in the system may be chargers, Direct Current converters or inverters.")
   @mutable
   struct C_Power_Converting_Resource : P_Distribution_Network_PSM::C_Converter
   {
      @doc("This represents the instantaneous charger current.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_current;
      @doc("This represents the instantaneous charger voltage.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltage;
      @doc("This indicates that an over current condition is present.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overcurrent;
      @doc("This indicates that an over voltage condition is present.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_overvoltage;
      @doc("This represents the current temperature of the power converting resource.")
      @hashid @optional P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_temperature;
   };

   @doc("This causes the setting of the operating mode of the converter.")
   @mutable
   struct C_DC_Converter_setDCConverterOperatingMode
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_DC_Converter_StateType A_setMode;
   };

   @doc("This represents the state of the selected charger (power converting resource).")
   @mutable
   struct C_Charger : C_Power_Converting_Resource
   {
      @hashid T_Charger_StateType A_chargerMode;
   };

   @doc("This represents the state of the selected battery (power providing resource).")
   @mutable
   struct C_Battery : C_Power_Providing_Resource
   {
      @doc("This represents the level of charge remaining in the battery.")
      @hashid @optional P_LDM_Common_PSM::T_ChargeInCoulombsType A_remainingCharge;
      @doc("This represents the temperature of the battery.")
      @hashid @optional P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_temperature;
      @doc("If TRUE, indicates that the battery is currently charging.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_charging;
      @doc("Represents the battery's ability to retain charge.  Used to determine when to replace the battery.")
      @hashid @optional P_LDM_Common_PSM::T_PercentageType A_stateOfHealth;
   };

   @doc("This represents the state of the selected fuel cell (power providing resource).")
   @mutable
   struct C_Fuel_Cell : C_Power_Providing_Resource
   {
      @doc("This represents the level of fuel remaining in the fuel cell.")
      @hashid @optional P_LDM_Common_PSM::T_PercentageType A_remainingFuel;
      @doc("This represents the current temperature of the fuel cell.")
      @hashid @optional P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_temperature;
   };

   @doc("Resets the trip for the specified channel.")
   @mutable
   struct C_Channel_resetTrip
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   @doc("This causes the setting of the voltage and current limits for a given channel of a power distribution node.")
   @mutable
   struct C_Channel_setChannelLimits
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @doc("Specified current limit above which an over current situation is flagged.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_currentLimit;
      @doc("Specified voltage limit above which an over voltage situation is flagged.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltageLimit;
   };

   @doc("This causes the setting of the operating mode of the channel.")
   @mutable
   struct C_Channel_setChannelOperatingMode
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_Channel_StateType A_setMode;
   };

   @doc("This represents the state of a selected channel of a power distribution node.")
   @mutable
   struct C_Channel : P_Distribution_Network_PSM::C_Isolator
   {
      @doc("The unique number of this channel.")
      @hashid P_LDM_Primitive_PSM::T_Int16 A_channelNumber;
      @doc("This represents the instantaneous load current supplied by the selected channel.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_current;
      @doc("This represents the instantaneous voltage measured at the selected channel.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltage;
      @doc("This represents the current temperature of the selected channel.")
      @hashid @optional P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_temperature;
      @doc("This represents the specified current limit of the selected channel.  If the instantaneous current of the selected channel exceeds this, an over current condition should be raised.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_currentLimit;
      @doc("This represents the specified voltage limit measured at the selected channel output. If the voltage of the selected channel exceeds this, an over voltage condition should be raised.")
      @hashid @optional P_LDM_Common_PSM::T_VoltageInVoltsType A_voltageLimit;
      @doc("This indicates that an over current condition is present in the selected power channel.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overcurrent;
      @doc("This indicates that an over voltage condition is present in the selected channel.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_overvoltage;
      @hashid T_Channel_StateType A_channelMode;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_parentDistributionNode_sourceID;
   };

   @doc("Resets all tripped channels for this node.")
   @mutable
   struct C_Power_Distribution_Node_resetAllTrippedChannels
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   @doc("This causes the setting of the voltage and current limits for a power distribution node.")
   @mutable
   struct C_Power_Distribution_Node_setPowerDistributionNodeLimits
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @doc("Specified current limit above which an over current situation is flagged.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_currentLimit;
      @doc("Specified voltage limit above which an over voltage situation is flagged.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltageLimit;
   };

   @doc("This causes the setting of the operating mode of the power distribution node.")
   @mutable
   struct C_Power_Distribution_Node_setPowerDistributionNodeOperatingMode
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_Power_Distribution_Node_StateType A_setMode;
   };

   @doc("This represents the state of the complete power distribution node. A power distribution node will contain one or more power channels.")
   @mutable
   struct C_Power_Distribution_Node : P_Distribution_Network_PSM::C_Splitter
   {
      @doc("This represents the instantaneous current supplied by the complete power distribution node.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_current;
      @doc("This represents the instantaneous voltage measured at the power distribution node.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_voltage;
      @doc("This represents the current temperature of the power distribution node.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_temperature;
      @doc("This indicates that an over current condition is present in the power distribution node.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overcurrent;
      @doc("This indicates that an over voltage condition is present in the power distribution node.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_overvoltage;
      @doc("This represents the specified current limit of the power distribution node.  If the instantaneous current of the power distribution node exceeds this, an over current condition should be raised.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_currentLimit;
      @doc("This represents the specified voltage limit measured at the power distribution node. If the voltage of the power distribution node exceeds this, an over voltage condition should be raised.")
      @hashid @optional P_LDM_Common_PSM::T_VoltageInVoltsType A_voltageLimit;
      @hashid T_Power_Distribution_Node_StateType A_nodeMode;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_distributionPowerChannels_sourceID;
   };

   @doc("Initiates a soft shutdown of the power consuming resource.")
   @mutable
   struct C_Power_Consuming_Resource_performSoftShutdown
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   @doc("Sets the power saving status for this power consuming resource.")
   @mutable
   struct C_Power_Consuming_Resource_setPowerSavingStatus
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_CommandedStatusType A_powerSavingStatus;
   };

   @doc("Sets the power on status for the specified power consuming resource.")
   @mutable
   struct C_Power_Consuming_Resource_setPowerOnStatus
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_CommandedStatusType A_powerOnStatus;
   };

   @doc("This represents a generic power consuming resource.")
