      @doc("This represents the minimum input voltage of the converter.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_minimumInputVoltage;
   };

   @doc("This represents the state of the selected Direct Current generator (power providing resource).")
   @mutable
   struct C_DC_Generator : C_Power_Providing_Resource
   {
   };

   @doc("This represents the static (specification) values of a power node.")
   @mutable
   struct C_Power_Distribution_Node_Specification : P_Distribution_Network_PSM::C_Distribution_Network_Component_Specification
   {
      @doc("This represents the maximum voltage at which the power distribution component operates.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_maximumOperatingVoltage;
      @doc("This represents the nominal voltage at which the power distribution component operates.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_nominalOperatingVoltage;
      @doc("This represents the minimum voltage at which the power distribution component operates.")
      @hashid P_LDM_Common_PSM::T_VoltageInVoltsType A_minimumOperatingVoltage;
      @doc("This represents the maximum continuous trip current of the power distribution component.")
      @hashid P_LDM_Common_PSM::T_CurrentInAmpsType A_maximumContinuousCurrent;
      @doc("This represents the maximum operating temperature of the environment in which the power distribution component will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_maximumOperatingTemperature;
      @doc("This represents the minimum operating temperature of the environment in which the power distribution component will operate.")
      @hashid P_LDM_Common_PSM::T_TemperatureInDegreesKelvinType A_minimumOperatingTemperature;
      @doc("A human readable identifier for the type name of the component. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_componentTypeName;
      @doc("Specifies the trip state type (off, on or manual) for the specified component type.")
      @hashid T_ResetTripStateType A_resetTripState;
      @doc("BOOLEAN that indicates if the Node can report when an over voltage condition is present.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overvoltageSupported;
   };

   @doc("This causes the setting of the voltage and current limits for an inverter.")
   @mutable
   struct C_Inverter_setInverterLimits
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
