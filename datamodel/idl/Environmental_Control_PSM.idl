#ifndef ENVIRONMENTAL_CONTROL_PSM__IDL
#define ENVIRONMENTAL_CONTROL_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// This domain is responsible for monitoring and controlling the environment within a platform.  The environment may be single space, represented by �Platform_With_Environment�, such as a basic vehicle like a Land Rover, or a simple base comprising a single accommodation unit.  Alternatively, the platform may be partitioned into a number of �Subzones�, each with its own environmental control settings, such as an APC with a �driver compartment� subzone and a �passenger compartment� subzone, or a complex base with multiple rooms.  The hierarchy of subzones is represented by the �superzone-subzone� reflexive association on Zone, where the topmost �superzone� is the platform itself.
// 
// The behaviour of the domain is controlled by the �Environmental_Control_Setting�, which allows the operator to specify desired values for any setting, such as �Temperature�, �Fan_RPM�, �Air_Recirculation� etc.  These settings are modelled generically, to support the variety of settings likely to be encountered across multiple platform types over time, using the �Setting_Value_Specification�.  Objects of �Setting_Value_Specification� are configured using data (in XML datasets), and each of these is either a �Numeric_Setting_Specification� such as a temperature value in the range 289 to 203 (Kelvin), or a �Numeric_Setting_Value_Specification� with a configurable set of literals such as {�Heater_Auto�, �Heater_Off�, �Heater_On�}.
// 
// The domain has a �Sensor� interface (modelled as a counterpart) to the sensors providing the actual measured values (held in the �Sensors� domain counterpart in the case of the LDM) that correspond to the desired settings (e.g. actual driver compartment temperature).  Once these actual values are obtained, they are compared with the desired value, and if necessary the appropriate actuator commands (e.g. to turn on the heater if the actual temperature is less than the desired temperature) can be issued (via the �Actuators� domain counterpart in the case of the LDM).  Note that some settings represent operator commands, with no associated �actual� value obtained from Sensors, such as �Air_Recirculation�.
// 
// The instances in this domain will be specified using a domain dataset.
module P_Environmental_Control_PSM
{
   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Environmental_Control_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Determines whether the climate in the platform is controlled automatically or manually.  A TRUE argument value indicates that climate control is to be set to automatic.
   @mutable
   struct C_Zone_setAutomaticControlOn
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // TRUE indicates that climate control is to be set to automatic.
      @hashid P_LDM_Common_PSM::T_CommandedStatusType A_automaticControlOn;
   };

   // A volume of space within the platform whose environment can be controlled, either automatically or manually.
   // 
   @mutable
   struct C_Zone
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The name by which this zone is known.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_zoneName;
      // TRUE indicates that climate control is currently set to automatic.
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_automaticControlOn;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_superzone_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_zoneSettings_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_subzones_sourceID;
   };

   @mutable
   struct C_Platform_With_Environment_closeAllAirFlaps
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   // The topmost zone on the platform.
   @mutable
   struct C_Platform_With_Environment : C_Zone
   {
      @hashid P_GVA_Common_PSM::T_IdentifierType A_platformWithEnvironmentCP_sourceID;
   };

   // This is the specification of a data type to be used for environment control settings.  It specifies either a numerical data type or an enumerated data type.
   // 
   // Data types are specified using objects (i.e. data) here to allow addition and modification of types without the need to regenerate and/or recompile any code.
   @mutable
   struct C_Setting_Value_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The name of the setting value type.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_settingValueTypeName;
   };

   // Example Objects:
   // Heater_Setting_Type
   // Air_Recirculate_Type
   // 
   // This is the specification of an enumeration data type to be used for environment control settings.  It is associated with one or more "Enumerated_Setting_Value_Literal" objects, each defining one enumeration literal value that can be held in variables of this enumeration type..
   // 
   // Enumeration types and their literal values are specified using objects (i.e. data) here to allow addition and modification of enumeration types and enumeration literals without the need to regenerate and/or recompile any code.
   @mutable
   struct C_Enumerated_Setting_Value_Specification : C_Setting_Value_Specification
   {
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_validLiterals_sourceID;
   };

   // Allows the operator or an authorised application to set desired values for environment variables such as temperature, humidity, pressure.  These are typically used by the environmental control system to automatically control one or more of the available actuators, such as heaters, air-conditioners, fans etc to achieve the specified desired values.
   // 
   // Authorised applications may wish to set environmental variables to achieve their goals.  for example, an NBC application may wish to close all air flaps, or a power saving application may wish to turn off heaters and/or fans.
   // 
   @mutable
   struct C_Environmental_Control_Setting
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The name of the Environmental_Control_Setting.  For example "Temperature", "Humidity".
      @hashid P_LDM_Primitive_PSM::T_MediumString A_settingName;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_controlledZone_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_measuringSensors_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_controlledActuators_sourceID;
   };

   // Example Objects:
   // Heater_Auto | -1
   // Heater_Off | 0
   // Heater_Low | 1
   // Heater_High | 2
   // Air_Recirculate_Auto | -1
   // Air_Recirculate_Off | 0
   // Air_Recirculate_On | 1
   // 
   // This specifies an enumeration literal that can be assigned to variables of the associated "Enumerated_Setting_Value".
   @mutable
   struct C_Enumerated_Setting_Literal_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Specifies the name of the enumeration literal.  The names are specified using objects to allow addition of new enumerations without the need to regenerate or recompile existing code.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_enumerationLiteralName;
      // An optional attribute that specifies an integer value associated with the literal value.  This can be used to specify any required ordering of literal values within an enumerated type definition.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_enumerationLiteralValue;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_enumerationTypeSpecification_sourceID;
   };

   // Sets the desired value of the specific setting.
   @mutable
   struct C_Desired_Enumeration_Setting_setDesiredEnumerationValue
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_MediumString A_settingName;
      @hashid P_LDM_Primitive_PSM::T_MediumString A_desiredValue;
   };

   // Example Objects:
   // Air_Recirculate
   // Interior_Light_Level
   // 
   // This is the enumeration literal value of an environment control setting, used for automatic control of the climate within the associated zone.  The value is specified by the linkage to one "Enumerated_Setting_Value_Literal" object.
   @mutable
   struct C_Desired_Enumeration_Setting : C_Environmental_Control_Setting
   {
      @hashid P_GVA_Common_PSM::T_IdentifierType A_desiredValue_sourceID;
   };

   // A zone within the platform that provides a separate set of environmental controls and actuators.
   @mutable
   struct C_Subzone : C_Zone
   {
   };

