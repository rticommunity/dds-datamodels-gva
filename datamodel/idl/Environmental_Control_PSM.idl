   };

   // Example Objects:
   // Temperature | 21.0
   // Humidity | 55.0
   // Pressure | 101325
   // 
   // This is the numeric value of an environment control setting, used for automatic control of the climate within the associated zone.
   // 
   @mutable
   struct C_Desired_Numeric_Setting : C_Environmental_Control_Setting
   {
      // The desired target value for the specified setting.
      @hashid P_LDM_Primitive_PSM::T_Double A_desiredValue;
   };

   // Example Objects:
   // Temperature_Type | 289.0 | 301.0 | 0.5
   // Fan_RPM_Type | 0.0 | 6000.0 | 1.0
   // 
   // This is the specification of a numeric data type to be used for environment control settings.  It specifies the range of values that can be held by variables of that type, and the granularity of the values.
   // 
   // Numeric types and their value ranges are specified using objects (i.e. data) here to allow addition and modification of types without the need to regenerate and/or recompile any code.
   @mutable
   struct C_Numeric_Setting_Specification : C_Setting_Value_Specification
   {
      // The minimum value that can be assigned to instances of this setting.
      // 
      @hashid P_LDM_Primitive_PSM::T_Double A_minimumValue;
      // The maximum value that can be assigned to instances of this setting.
      @hashid P_LDM_Primitive_PSM::T_Double A_maximumValue;
      // The granularity of the values that can be held in variables of this type.  For example, if it is required that temperature is set in units of half a degree, the granularity would be 0.5.  If humidity is to be held as an integer percentage value, the granularity would be 1.0 (with minimumValue=0 and maximumValue=100)
      @hashid P_LDM_Primitive_PSM::T_Double A_granularity;
      // A meaningful name for the sensed value.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_sensedValueName;
   };

