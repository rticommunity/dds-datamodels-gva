   @doc("The characteristics schema datatype specification specifies a reusable data type that can referenced by properties contained in a schema.
       It supports both simple types ranging from booleans, string, dates, times etc, as well as complex types that are re-usable structures that contain properties. If this is representing a simple data type, the type attribute should be set and there should be no sub properties. However, if it is complex, then the type attribute should be set to \"complex\" and sub properties should be included.
       Depending the underlying data type being represented, the specification allows different constraints to be set e.g. maximum & minimum values for numerical types, maximimum & minimum length  for string types etc.")
   @mutable
   struct C_Characteristics_Schema_DataType_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("The primitive type to be used by the simple schema data type.")
      @hashid @optional T_DataTypeType A_type;
      @doc("The name of the schema type.")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_name;
      @doc("The list of literals that are supported by the enumeration.")
      @hashid @optional T_LiteralDataListType A_literals;
      @doc("The maximum length of the string data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_maxLength;
      @doc("The number of fractional digits supported by the decimal data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_fractionDigits;
      @doc("The total number of digits supported by the numeric data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_totalDigits;
      @doc("The minimum inclusive value of the numeric data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_minValue;
      @doc("The maximum inclusive value of the numeric data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_maxValue;
      @doc("The minimum length of the string data type.")
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_minLength;
      @hashid sequence <C_Characteristics_Schema_DataType_Property_Specification> A_property;
   };

   @doc("The characteristics schema specification specifies the schema that defines the characteristics that are supported for a particular type of battlespace object, relationship or group. A schema contains the properties for the characteristics and their associated data types. Properties can also reference common data types that are described in other schemas.")
   @mutable
   struct C_Characteristics_Schema_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("The name of the characteristic schema. This will be used to contextualise and qualify the names of the properties and data types supported by the schema. Making them unique and easily referenced.")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_name;
      @hashid sequence <C_Characteristics_Schema_Root_Property_Specification> A_property;
      @hashid sequence <C_Characteristics_Schema_DataType_Specification> A_dataType;
   };
};

