      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_cpAccessorGroupSpecification_sourceID;
   };

   // Represents a group of accessible items that would all be accessible to one or more specified accessors.  This eliminates the need to establish linkages between each primitive accessible item and its associated accessors.
   @mutable
   struct C_Accessible_Item_Group_Specification : C_Accessible_Item_Specification
   {
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_groupMembers_sourceID;
   };
};

#endif
