   // Specifies information relating to a detection location expressed as a 2D relative bearing.
   @mutable
   struct C_Bearing_Detection_Location : C_Detection_Location
   {
      // The relative bearing from the detector absolute location.
      @hashid P_LDM_Common_PSM::T_CoordinatePolar2DType A_relativeBearing;
   };

   // Specifies information relating to a detection location expressed in 3D polar coordinates.
   @mutable
   struct C_Point_Detection_Location : C_Detection_Location
   {
      // The relative position from the detector absolute location.
      // 
      @hashid P_LDM_Common_PSM::T_CoordinatePolar3DType A_relativePosition;
   };
};

#endif
