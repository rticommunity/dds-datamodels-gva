      @hashid P_LDM_Common_PSM::T_Position2DType A_position;
   };

   // An HMI Application; this embodies display of information of some kind to a user; the application knows where it is on its HMI_Desktop but has no direct knowledge of which screen it is displayed on, although that can be determined indirectly from available information.
   @mutable
   struct C_HMI_Application
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Position of the top left corner of the application on the HMI desktop
      // 
      @hashid P_LDM_Common_PSM::T_Position2DType A_topLeft;
      // Size of the application's view to be displayed.
      // 
      @hashid P_LDM_Common_PSM::T_Size2DType A_size;
      // Indictaes if the application is active or not; an inactive application should not responed to user input; although it may respond to other changing data.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_active;
      // Indicates if the application is visible (true = visible); an invisible application is not drawn on the HMI desktop
      @hashid P_LDM_Primitive_PSM::T_Boolean A_visible;
      // The default Plan Position Indicator (PPI) Up setting that should be used i.e. what should be shown for the up position of the PPI. It is acceptable for a displayed PPI not to use this setting if something that makes more sense is available in the context it is being displayed in e.g. if displayed on top of a map aligning the PPI with the map grid rather than using this setting makes sense for clear interpretation of the screen. If there is no contextual exception then this setting should be used for any displayed PPI.
      @hashid T_PlanPositionIndicatorUpType A_defaultPlanPositionIndicatorUp;
      // Name of the application. Application names should be unique with-in the system. Different instances of the same application should have different names.
      @hashid P_LDM_Common_PSM::T_DescriptorType A_fullName;
      // A shorter name that can be used on screen for this application
      @hashid P_LDM_Primitive_PSM::T_MediumString A_onScreenName;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hmiApplicationSpecification_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hmiDesktop_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_HMIApplicationCP_sourceID;
   };

   // Specification for the HMI Desktop
   @mutable
   struct C_HMI_Desktop_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The list of languages that are supported by this desktop
      @hashid T_LanguageCodeListType A_supportedLanguageList;
