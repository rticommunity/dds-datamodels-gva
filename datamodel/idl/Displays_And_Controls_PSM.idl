      // Light state, enable = on, disable = off
      @hashid P_LDM_Common_PSM::T_CommandedStatusType A_status;
   };

   // Data representing a generic output element.
   @mutable
   struct C_Output_Component : C_Human_Interaction_Component
   {
      // If supported the current brightness of the light as a percentage of its maximum brightness
      @hashid @optional P_LDM_Common_PSM::T_PercentageType A_brightness;
   };

   // Specification for an output component.
