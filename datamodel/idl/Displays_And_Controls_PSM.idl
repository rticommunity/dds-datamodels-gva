   // Data and operations for a panel that displays 1 or more lines of text (LCD, LED etc)
   @mutable
   struct C_Text_Display : C_Output_Component
   {
      // An array of text strings, 1 for each row that the display panel supports
      @hashid T_TextDisplayLineListType A_currentText;
   };

   // The specification of a touch pad
   @mutable
   struct C_Touch_Digitiser_Specification : C_Input_Component_Specification
   {
      // The maximum number of simultaneous touches that the touch pad supports
      @hashid P_LDM_Primitive_PSM::T_Int16 A_maxSimulataneousTouches;
      // Indicates of the touch pad supports gesture detection. If supported detected gestures are reported through the detectedGestureName attribute.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_detectedGestureNameSupported;
   };

   // The data for a touch pad or if combined with a physical screen as a composite device a touch screen
   @mutable
   struct C_Touch_Digitiser : C_Input_Component
   {
      // If supported and available the gestureDetected by the Touch_Pad
      @hashid @optional P_LDM_Primitive_PSM::T_ShortString A_detectedGestureName;
      // The list of touch currently detected by the touch pad
      @hashid T_TouchLocationListType A_touchList;
   };

   // Specification for a text panel display
   @mutable
   struct C_Text_Display_Specification : C_Output_Component_Specification
   {
      // Defines the number of lines of text a text display panel displays
      @hashid P_LDM_Primitive_PSM::T_Int16 A_numberOfLines;
      // Defines the maximum number of characters that the text display panel can can display on each of its available lines
      @hashid P_LDM_Primitive_PSM::T_Int16 A_maximumCharactersPerLine;
   };

   // This provides specification for a Nudge_Control
   @mutable
   struct C_Nudge_Control_Specification : C_Input_Component_Specification
   {
      // The minimum value that nudgeCount attribute will have.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_minimumNudgeCount;
      // The maximum value that nudgeCount attribute will have.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_maximumNudgeCount;
   };

   // Specification for a button.
   @mutable
   struct C_Button_Control_Specification : C_Input_Component_Specification
   {
      // Indicates if the button supports transitioning i.e. can present a indeterminate state between known states when being physical actuated 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_transitioningSupported;
   };

   // Specification for a composite component.
   @mutable
   struct C_Composite_Component_Specification : C_Human_Interaction_Component_Specification
   {
   };
