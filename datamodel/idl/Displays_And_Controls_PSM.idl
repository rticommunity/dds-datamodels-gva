      // 
      // TYPE_NAME::<typeName>
      // 
      @hashid P_LDM_Primitive_PSM::T_MediumString A_componentTypeName;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_subComponents_sourceID;
   };

