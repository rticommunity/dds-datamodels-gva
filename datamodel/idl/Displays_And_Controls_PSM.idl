   // Sets the size of the application in pixels. Changing the size does not affect the position of the application.
   @mutable
   struct C_HMI_Application_setSize
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
