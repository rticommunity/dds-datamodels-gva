#ifndef DISPLAYS_AND_CONTROLS_PSM__IDL
#define DISPLAYS_AND_CONTROLS_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// Interface to user input and output devices down to discrete devices and applications.
module P_Displays_And_Controls_PSM
{
   // ISO 639-1 2 letter language code or ISO 639-2 3 letter language code.
   // 
   // Any trailing charcters beyond the end of the language code shall be set to the NULL character (value 0)
   // 
   // 
   typedef sequence <P_LDM_Primitive_PSM::T_Char, 3> T_LanguageCodeType;

   // A list of language code types
   typedef sequence <T_LanguageCodeType> T_LanguageCodeListType;

   // A list of key code identifiers
   typedef sequence <P_LDM_Primitive_PSM::T_Int32> T_KeyListType;

   // Data representing the text displayed on a single line of a text display
   @mutable
   @nested
   struct T_TextDisplayLineType
   {
      // The text to display
      @hashid P_LDM_Primitive_PSM::T_MediumString A_text;
      // The line number on which the text should be displayed
      @hashid P_LDM_Primitive_PSM::T_Int16 A_lineNumber;
   };

   // A list of text display lines for devices can can display more than 1 line
   typedef sequence <T_TextDisplayLineType> T_TextDisplayLineListType;

   // Data describing a touch location on a touch pad including an id to allow tracing of drags between messages. The point is referenced to (0, 0) in the top left corner.
   // 
   @mutable
   @nested
   struct T_TouchLocationType
   {
      // The horizontal location of the touch point normalised into the range 0.0000 - 1.0000; referenced to (0, 0) in the top left corner.
      @hashid P_LDM_Primitive_PSM::T_Double A_horizontalLocation;
      // A unique identifier which is imlementation defined, the identifier of a touch should not change between subsequent samples of the same continuous touch to allow detection of drag operations on the touch pad.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_uniqueId;
      // The vertical location of the touch point normalised into the range 0.0000 - 1.0000; referenced to (0, 0) in the top left corner.
      // 
      @hashid P_LDM_Primitive_PSM::T_Double A_verticalLocation;
   };

   // A list of touch locations to support the multi touch functions of some touch pads
   typedef sequence <T_TouchLocationType> T_TouchLocationListType;

   // This enumeration defines what direction should be used as the up location on displayed plan position indicators
   @appendable
   enum T_PlanPositionIndicatorUpType
   {
      L_PlanPositionIndicatorUp__Invalid,
      // The PPI should be displayed with the vehicle heading up
      L_PlanPositionIndicatorUp__Vehicle_Heading_Up,
      // The PPI should be displayed with the turret heading (which can be different to the vehicle heading) up
      L_PlanPositionIndicatorUp__Turret_Heading_Up,
      // The PPI should be displayed with north up
      L_PlanPositionIndicatorUp__North_Up
   };

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_Displays_And_Controls_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // Operation to set the current value of timeZoneOffset
   @mutable
   struct C_HMI_Desktop_setTimeZoneOffset
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The new timeZoneOffset in minutes that should be used
      @hashid P_LDM_Primitive_PSM::T_Int16 A_timeZoneOffset;
   };

   // Sets the application that currently has the input focus; only an application that is both visiable and active is elidgable to receive the input focus. As part of receiving the input focus if the application is currently underneath other applications it should be brought to the top so that it can be seen by user.
   @mutable
   struct C_HMI_Desktop_setInputFocus
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_DescriptorType A_applicationFullName;
   };

   // Sets the language in use for this HMI_Desktop, the value provided must match one of the values in the HMI_Desktop_Specification associated with the HMI_Desktop
   @mutable
   struct C_HMI_Desktop_setLanguage
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid T_LanguageCodeType A_newLanguage;
   };

   // Sets the grid format in use on this HMI desktop, the value provided to this function must match one of the values in the HMI_Desktop_Specification associated with this HMI_Desktop
   @mutable
   struct C_HMI_Desktop_setGridFormat
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The display name of the grid format that the HMI desktop should use.
      @hashid P_LDM_Primitive_PSM::T_MediumString A_gridFormatDisplayName;
   };

   // A single HMI desktop, which encompasses 1 or more physical screens and 1 or more applications which may appear either full screen or side by side.
   // 
   // Note that the HMI_Desktop's association to a Human_Interaction_Resource is to allow the desktop to be associated with the screens (Display_Panels) that are its physical embodyment. This should not be used to associate the HMI_Desktop to any other type of Human_Interaction_Resource (e.g. a hand controller); where required this sort of association should be made through the Arbitration PIM e.g. allocating control of the desktop device to the hand controller device.
   @mutable
   struct C_HMI_Desktop
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // The current language in use on the desktop
      @hashid T_LanguageCodeType A_language;
      // Size of the virtual desktop in pixels. The virtual desktop size is the size of all the Physical_Screens added together, however it may be larger.
      @hashid P_LDM_Common_PSM::T_Size2DType A_virtualDesktopSize;
      // The offset for the current timezone in minutes from UTC.
      // 
      // Note that although many time zones are an offset of a whole number of hours from https://en.wikipedia.org/wiki/List_of_time_zone_abbreviations the minimum unit required to express all time zones is 15 minutes e.g. NPT, Nepal Time = UTC+05:45.
      // 
      // The implementation is free to convert to or from any naming convention it sees fit for display of the time zone to the user e.g. https://en.wikipedia.org/wiki/List_of_time_zone_abbreviations or https://www.timeanddate.com/time/zones/military
      // 
      // Therefore
      // 
      // Alpha Time Zone = UTC +1 = CET (Central European Time) = +60 for this field
      // Tango Time Zone = UTC -7 = PDT (Pacific Daylight Time) = -420 for this field
      // 
      @hashid P_LDM_Primitive_PSM::T_Int16 A_timeZoneOffset;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hmiDesktopSpecification_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_availableApplications_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_applicationWithInputFocus_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_humanInteractionResources_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_currentDisplayedGridFormatSpecification_sourceID;
   };

   // The specification for an HMI Application.
   @mutable
   struct C_HMI_Application_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Indicates if the setActive command is supported by the application
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setActiveSupported;
      // Indicates if the setSize command is supported by the application
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setSizeSupported;
      // Indicates if the setTopLeft command is supported by the application
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setTopLeftSupported;
      // Indicates if the setVisible command is supported by the application
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setVisibleSupported;
      // Indicates if the setDefaultPlanPositionIndicatorUp operation is supported by the application.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setDefaultPlanPositionIndicatorUpSupported;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hmiDesktopSpecification_sourceID;
   };

   // This required operation provides a placeholder for any behaviour that needs to be initiated in other domains when the specified object status changes.
   // 
   // 
   @mutable
   struct C_Human_Interaction_Resource_CP_objectStatusChanged
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
