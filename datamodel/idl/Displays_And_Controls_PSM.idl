   // The specification for an element with 2 degrees of freedom
   @mutable
   struct C_Input_Control_2D_Specification : C_Input_Component_Specification
   {
      // Maximum value for the X dimension
      @hashid P_LDM_Primitive_PSM::T_Double A_maximumX;
