   };

   // If supported sets the lights colour. If a light that only supports selected discrete colours (e.g. red RGB(255, 0, 0) or green RGB(0, 255, 0) ) is sent a request to use a colour it does not support it is free to interpret it if it can (e.g. interpret RGB(192, 0, 0) as red RGB(255, 0, 0)) or ignore it (e.g. ignore a request fro blue RGB(0, 0, 255)).
   // 
   // If the command is being ignored and the sender of the command has requested a response then the returned respose code ResponseCodeType::ERROR should be used.
   @mutable
   struct C_Light_setColour
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
