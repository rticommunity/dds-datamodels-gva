      // An optional attribute if the display panel is part of an HMI desktop which gives the screens position in the desktop
      @hashid @optional P_LDM_Common_PSM::T_Position2DType A_positionOnDesktop;
   };

   // Data representing a generic input element.
   @mutable
   struct C_Input_Component : C_Human_Interaction_Component
   {
   };

   // This operation is a helper function, if supported then the resource should set the brightness of all associated Human_Interaction_Devices which have brightness to the supplied level.
   // 
   @mutable
   struct C_Human_Interaction_Resource_setBrightness
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Common_PSM::T_PercentageType A_brightness;
   };

   // If supported sets the current blackout mode of the resource, when in blackout the resource should take appropriate action for all Human_Interaction_Devices it is associated with e.g. switch off all lights and screens. When blackout mode is disabled it should return all associated devices to the brightness level they had before blackout mode was enabled i.e. brightness levels should persist through a blackout.
   @mutable
   struct C_Human_Interaction_Resource_setBlackout
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Boolean A_enabled;
   };

   // If supported sets the current test mode of the resource, when in test the resource should take appropriate action for all Human_Interaction_Devices it is associated with e.g. switch on all lights and put all screens into a test pattern.
   @mutable
   struct C_Human_Interaction_Resource_setTestMode
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      // The required test mode, true to enter test mode false to exit test mode.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_enabled;
   };

   // A device that appears on the vehicle as a resource (and can be counter-parted to the representation of a resource in other domains e.g. Platform_Configuration) which allows a human operator to interact with the vehicle either receiving information from or entering information into the vehicle system.
   // 
   // Examples
   // Commanders Control Panel with switches and indicator lights
   // GVA Compliant Crew Station with display (possibly with touch screen) and buttons around it in the standard manor.
   @mutable
   struct C_Human_Interaction_Resource
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Indicates the current test mode of the Human_Interaction_Resource
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_testMode;
      // Indicates the current blackout mode of the resource
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_blackout;
      // The brightness setting of the resource, this should reflect the value given in the Human_Interaction_Resource::setBrightness command.
      // 
      // This attribute should aid resources whose entire brightness control happens at the resource level rather than the level of individual components.
      @hashid @optional P_LDM_Common_PSM::T_PercentageType A_brightness;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_humanInteractionResourceSpecification_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_humanInteractionComponents_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_hmiDesktop_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_humanInteractionResourceCP_sourceID;
   };

   // Data representing a button of any type (e.g. momentary, latching, passing contact switch)
   @mutable
   struct C_Button_Control : C_Input_Component
   {
      // The current state of the button. While transitioning, there may be no discernible current position so this attribute is optional.
      @hashid @optional P_LDM_Common_PSM::T_ButtonStateType A_state;
      // Indicates if the button is transitioning between states; when the button is transitioning the it's state is indeterminate and should not be transmitted.
      // 
      // The transitioning attribute should always be transmitted if the button supports transitioning.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_transitioning;
   };

   // Specification for a physical screen
   @mutable
   struct C_Display_Panel_Specification : C_Output_Component_Specification
   {
      // Indicates if the display panel supports the setContrast operation
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setContrastSupported;
      // Indicates if the display panel supports the setResolution operation
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setResolutionSupported;
      // Indicates if the display panel supports the setPositionOnDesktop operation
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPositionOnDesktopSupported;
   };

   // Indicates the state of a keyboard with a list of key codes corresponding to the keys which are currently pressed on this keyboard.
   @mutable
   struct C_Keyboard : C_Input_Component
   {
      // An list of key codes corresponding to the keys which are currently pressed on this keyboard.
      // 
      @hashid T_KeyListType A_currentlyPressedKeyList;
   };

   // Defines the data for a multi-position switch (e.g. a rotary switch with multiple positions that has to be in 1 of the defined positions)
   // 
   @mutable
   struct C_Multi_Position_Switch_Control : C_Input_Component
   {
      // The current switch position indexed from 0. While transitioning, there may be no discernible current position so this attribute is optional.
      @hashid @optional P_LDM_Primitive_PSM::T_Int16 A_currentPosition;
      // Indicates if the switch is transitioning between states; when the switch is transitioning the it's currentPosition is indeterminate and should not be transmitted.
      // 
      // The transitioning attribute should always be transmitted if the button supports transitioning.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_transitioning;
   };

   // Data for a nudge element. A nudge element is an element that can move continuously normally in 2 directions without any endstop e.g. a rotary control which spin infinately in either direction. The control does not report position but rather movement in either direction and may report higher values for either faster actuation of the control or longer actuation of the control. 
   // 
   // If the control is rotary it will report positive values for clockwise rotation and negative values for anti-clockwise rotation; otherwise the meaning of the sign of the nudgeCount is implementation deefined.
   @mutable
   struct C_Nudge_Control : C_Input_Component
   {
      // The current relative nudge from the last update; +ve forwards, -ve backwards
      @hashid P_LDM_Primitive_PSM::T_Int16 A_nudgeCount;
   };

   // Specification for an input component.
   @mutable
   struct C_Input_Component_Specification : C_Human_Interaction_Component_Specification
   {
   };

   // Specification of a keyboard.
   @mutable
   struct C_Keyboard_Specification : C_Input_Component_Specification
   {
      // The maximum number of simultaneous key presses that the keyboard can report (known as rollover)
      @hashid P_LDM_Primitive_PSM::T_Int16 A_maxSimultaneousKeys;
      // True if the keyboard produces keycodes which match those defined in section 10 of the USB HID Usage Tables:
      // 
      // https://www.usb.org/sites/default/files/documents/hut1_12v2.pdf
      // 
      // If should be considered the norm to support these keycodes but a specialist keyboard may have keys that do not correspond to the keys defined in this document.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_usbHidKeyCodesCapable;
   };

   // Data for a device with a single degree of freedom; (e.g. rotary pot, linear pot)
   @mutable
   struct C_Input_Control_1D : C_Input_Component
   {
      // Current value of the Scaler_Element (knob, dial etc)
      @hashid P_LDM_Primitive_PSM::T_Double A_currentValue;
   };

   // Specification for an element with 1 degree of freedom.
   @mutable
   struct C_Input_Control_1D_Specification : C_Input_Component_Specification
   {
      // The minimum value that can be reported
      @hashid P_LDM_Primitive_PSM::T_Double A_minimumValue;
      // The maximum value that can be reported
      // 
      @hashid P_LDM_Primitive_PSM::T_Double A_maximumValue;
   };

   // Data for a device with 2 degrees of freedom (e.g. joystick, thumb controller, hat)
   @mutable
   struct C_Input_Control_2D : C_Input_Component
   {
      // Elements current X value
      @hashid P_LDM_Primitive_PSM::T_Double A_currentX;
      // Elements current Y value
      @hashid P_LDM_Primitive_PSM::T_Double A_currentY;
   };

   // Specification for a multi-position switch.
   // 
   // Note a toggle switch could be modelled as a multi-position switch with 2 positions (it could also be modelled as a button that is either pressed or not pressed).
   // 
   @mutable
   struct C_Multi_Position_Switch_Control_Specification : C_Input_Component_Specification
   {
      // The number of switch positions this switch has. Switch position are indexed from 0 so a switch with 6 positions (i.e. this attribute set to 6) will then have switch positions numbered 0,1,2,3,4, and 5.
      @hashid P_LDM_Primitive_PSM::T_Int16 A_noOfPositions;
      // Indicates if the switch supports transitioning i.e. can present a indeterminate currentPosition between known positions when being physical actuated 
      // 
      @hashid P_LDM_Primitive_PSM::T_Boolean A_transitioningSupported;
   };

   // The specification of a human interaction resource
   @mutable
   struct C_Human_Interaction_Resource_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Indicates if this resource supports the operation setTestMode. If supported then the resource should respond to being set into test mode in some implementation defined manor e.g. switch on all lights.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setTestModeSupported;
      // Indicates if this resource supports the operation setBlackout. If supported then the resource should respond to being set into blackout mode in some implementation defined manor e.g. switch all light emitting devices off or reduced their brightness to 0.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setBlackoutSupported;
      // Indicates if this resource supports the operation setBrightness.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setBrightnessSupported;
   };

   // The composite device is a discrete device that has the properties of more than 1 of the types of device described in this PIM e.g. an illuminated button has the properties of a button and a light.
   // 
   // A GVA crewstation would probably be a Human_Interaction_Resource with multiple devices rather than a single composite device but the system integrator/device manufacturer has some leeway in implementation.
   @mutable
   struct C_Composite_Component : C_Human_Interaction_Component
