      @hashid P_LDM_Primitive_PSM::T_Boolean A_setBrightnessSupported;
   };

   // Represents a display panel or screen with--in the vehicle such as might be found as part of a crewstation or a direct video displat from a driving camera. The screen may be part of an HMI desktop or it may be used for some other purpose.
   @mutable
   struct C_Display_Panel : C_Output_Component
   {
      // The resolution of the screen in pixels
      @hashid P_LDM_Common_PSM::T_Size2DType A_resolution;
      // The contrast of the displayed picture on the screen as a percentage of the screens maximum contrast
