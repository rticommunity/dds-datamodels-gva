#ifndef MOUNT_PSM__IDL
#define MOUNT_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

@doc("This package defines
    - data produced by all mounts and mounted entities and intended to be shared with other subsystems,
    - commands exposed by all mounts and mounted entities and expected to be called by other subsystems.")
module P_Mount_PSM
{
   @appendable
   enum T_Rotational_Movement_Inhibit_Zone_StateType
   {
      L_RotationalMovementInhibitZoneState__Invalid,
      @doc("The zone is activated, which means it is taken into account by the mount as a movement inhibit zone.")
      L_RotationalMovementInhibitZoneState__Activated,
      @doc("The zone is activated, which means it is not taken into account by the mount as a movement inhibit zone.")
      L_RotationalMovementInhibitZoneState__Deactivated
   };

   @appendable
   enum T_Linear_Movement_Inhibit_Zone_StateType
   {
      L_LinearMovementInhibitZoneState__Invalid,
      @doc("The zone is activated, which means it is taken into account by the mount as a movement inhibit zone.")
      L_LinearMovementInhibitZoneState__Activated,
      @doc("The zone is activated, which means it is not taken into account by the mount as a movement inhibit zone.")
      L_LinearMovementInhibitZoneState__Deactivated
   };

   @doc("The Types of Stabilisation applicable to a single axis.")
   @appendable
   enum T_AxisStabilisationModeType
   {
      L_AxisStabilisationMode__Invalid,
      @doc("This axis of the mount is stabilised")
      L_AxisStabilisationMode__Stabilised,
      @doc("This axis of the mount is not stabilised")
      L_AxisStabilisationMode__Unstabilised,
      @doc("The stabilisation function for this axis is calibrating.")
      L_AxisStabilisationMode__Calibrating
   };

   @doc("Type defines the possible control modes for an axis on a Mount")
   @appendable
   enum T_AxisControlModeType
   {
      L_AxisControlMode__Invalid,
      @doc("Axis commanded by setVelocity operation")
      L_AxisControlMode__Velocity,
      @doc("Axis commanded by setPosition operation")
      L_AxisControlMode__Position,
      @doc("Axis commnded by setRelativePosition operation")
      L_AxisControlMode__Relative_Position,
      @doc("Axis controlled through scanParameters operation")
      L_AxisControlMode__Scan,
      @doc("Axis respond to no commands in this mode")
      L_AxisControlMode__None,
      @doc("Axis is being operated manualy")
      L_AxisControlMode__Manual
   };

   @doc("Describes the movement lock states of a mount (locked, unlocked).")
   @appendable
   enum T_AxisLockStateType
   {
      L_AxisLockState__Invalid,
      @doc("This axis of the mount is locked")
      L_AxisLockState__Locked,
      @doc("This axis of the Mount id unlocked")
      L_AxisLockState__Unlocked
   };

   @doc("The precision of a set of angular parameters (azimuth, elevation, cross elevation).
       Each component of the precision is given as a number p, which indicates that the actual parameter belongs to the interval [a-p, a+p], where a is the value of the component.")
   @mutable
   @nested
   struct T_AngularPrecisionType
   {
      @doc("The precision of the azimuth component.
          Given as a number p, which indicates that the actual azimuth belongs to the interval [a-p, a+p], where a is the value of the azimuth.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_azimuthPrecision;
      @doc("The precision of the elevation component.
          Given as a number p, which indicates that the actual elevation belongs to the interval [e-p, \\ulwave e+p\\ulnone ], where e is the value of the elevation.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_elevationPrecision;
      @doc("The precision of the cross elevation component.
          Given as a number p, which indicates that the actual cross-elevation belongs to the interval [c-p, \\ulwave c+p\\ulnone ], where c is the value of the cross-elevation.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_crossElevationPrecision;
   };

   @doc("An enumeration of the Horizontal_Rotational axes i.e azimuth, elevation or cross-elevation.")
   @appendable
   enum T_RotationalAxisIndexType
   {
      L_RotationalAxisIndex__Invalid,
      L_RotationalAxisIndex__Azimuth,
      L_RotationalAxisIndex__Elevation,
      L_RotationalAxisIndex__Cross_Elevation
   };

   @doc("Describes the states that the current scan can be in.")
   @appendable
   enum T_CurrentScanStateType
   {
      L_CurrentScanState__Invalid,
      L_CurrentScanState__Scan_In_Progress,
      L_CurrentScanState__Scan_Paused,
      L_CurrentScanState__Scan_Completed
   };

   @doc("Enumeration of the actions applied to a scan")
   @appendable
   enum T_ScanActionType
   {
      L_ScanAction__Invalid,
      L_ScanAction__No_Scan,
      L_ScanAction__Start_Scan,
      L_ScanAction__Stop_Scan,
      L_ScanAction__Pause_Scan,
      L_ScanAction__Resume_Scan
   };

   @doc("Describes the scan parameters to for a particular axis.")
   @mutable
   @nested
   struct T_ScanParametersType
   {
      @doc("Defines the offset of the scan in radians. If the offset is set to zero, the scan will be symmetrical about the mid position of the scan.")
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_offset;
      @doc("Defines the scan rate in radians per second applied to the axis.")
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_demand;
      @doc("Defines the total width of the scan in radians. The center of the scan is located at one half of the scan width. The scan will reverse direction at each end of the scan width.")
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_scanWidth;
   };

   @doc("A structure containing the rotational position of all supported angular axis. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_AngularPositionType
   {
      @doc("The azimuth component of the position.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_azimuthPosition;
      @doc("The elevation component of the position.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_elevationPosition;
      @doc("The cross-elevation component of the position.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_crossElevationPosition;
   };

   @doc("A structure containing the rotational angular velocity of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_AngularVelocityType
   {
      @doc("The azimuth component of the rotational angular velocity.")
      @hashid @optional P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_azimuthAngularVelocity;
      @doc("The elevation component of the rotational angular velocity.")
      @hashid @optional P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_elevationAngularVelocity;
      @doc("The cross elevation component of the rotational angular velocity.")
      @hashid @optional P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_crossElevationAngularVelocity;
   };

   @doc("Structure to hold the angular limits for a single axis.")
   @mutable
   @nested
   struct T_AxisAngularVelocityLimitType
   {
      @doc("The negative component of a rotational angular velocity limit.")
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_angularVelocityNegativeLimit;
      @doc("The positive component of a rotational angular velocity limit.")
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_angularVeloityPositiveLimit;
   };

   @doc("Structure to hold the angular acceleration limits for a single axis.")
   @mutable
   @nested
   struct T_AxisAngularAccelerationLimitType
   {
      @doc("The negative component of a rotational angular acceleration limit.")
      @hashid P_LDM_Common_PSM::T_AngularAccelerationInRadiansPerSecPerSecType A_angularAccelerationNegativeLimit;
      @doc("The positive component of a rotational angular acceleration limit.")
      @hashid P_LDM_Common_PSM::T_AngularAccelerationInRadiansPerSecPerSecType A_angularAccelerationPositiveLimit;
   };

   @doc("Describes the two supported kinds of mounts : internal frame rotation (a.k.a. intrinsic rotation) and external frame mounts (extrinsic rotations).")
   @appendable
   enum T_RotationalMountType
   {
      L_RotationalMount__Invalid,
      L_RotationalMount__Internal_Frame_Rotation,
      L_RotationalMount__External_Frame_Rotation
   };

   @doc("A structure containing the linear position of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_PositionType
   {
      @doc("The x component of the linear position.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_xPosition;
      @doc("The y component of the linear position.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_yPosition;
      @doc("The z component of the linear position.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_zPosition;
   };

   @doc("A structure containing the linear velocity of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_VelocityType
   {
      @doc("The x component of the linear velocity.")
      @hashid @optional P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_xVelocity;
      @doc("The y component of the linear velocity.")
      @hashid @optional P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_yVelocity;
      @doc("The z component of the linear velocity.")
      @hashid @optional P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_zVelocity;
   };

   @doc("Structure to hold the velocity limits of an axis.")
   @mutable
   @nested
   struct T_AxisVelocityLimitsType
   {
      @doc("The negative component of the linear velocity limit on this axis.")
      @hashid P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_negativeVelocityLimit;
      @doc("The positive component of the linear velocity limit on this axis.")
      @hashid P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_positiveVelocityLimit;
   };

   @doc("Structure to hold the linear acceleration limits for a single axis.")
   @mutable
   @nested
   struct T_AxisAccelerationLimitType
   {
      @doc("The negative component of the linear acceleration limit.")
      @hashid P_LDM_Common_PSM::T_LinearAccelerationInMetresPerSecPerSecType A_negativeAccelerationLimit;
      @doc("The positive component of the linear acceleration limit.")
      @hashid P_LDM_Common_PSM::T_LinearAccelerationInMetresPerSecPerSecType A_positiveAccelerationLimit;
   };

   @doc("The precision of a set of linear parameters (x, y, z).")
   @mutable
   @nested
   struct T_PrecisionType
   {
      @doc("The precision of the x component.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_xPrecision;
      @doc("The precision of the y component.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_yPrecision;
      @doc("The precision of the z component.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_zPrecision;
   };

   @doc("Structure holding all status of all attributes specific to a particular linear axis.")
   @mutable
   @nested
   struct T_LinearAxisType
   {
      @doc("Describes the current linear position of this axis of the Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_position;
      @doc("Describes the current linear velocity of this axis on the Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_velocity;
      @doc("Describes the current linear acceleration of this axis on the mount.")
      @hashid @optional P_LDM_Common_PSM::T_LinearAccelerationInMetresPerSecPerSecType A_acceleration;
      @doc("The current stabilisation mode of this axis on the Linear Mount.")
      @hashid @optional T_AxisStabilisationModeType A_stabilisationMode;
      @doc("The current lock state of this axis on the Linear Mount.")
      @hashid @optional T_AxisLockStateType A_lockState;
      @doc("The current absolute commanded position of the axis on the Linear_Mount. Applicable only when the axis mode is Control_Mode_Position.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_commandedPosition;
      @doc("The commanded rate of this axis on the Linear_Mount. Applicable only when the movement mode is Control_Mode_Velocity. This is also sometimes known as Demanded Rate.")
      @hashid @optional P_LDM_Common_PSM::T_LinearVelocityInMetresPerSecType A_commandedRate;
      @doc("The current mode of control of the axis on the Linear Mount.")
      @hashid @optional T_AxisControlModeType A_movementControlMode;
      @doc("Current relative position command value. Normally applicable only when the movement mode is movement mode is Control_Mode_Relative_Position. Sometimes known as Rate Demand.")
      @hashid @optional P_LDM_Common_PSM::T_DistanceInMetresType A_commandedRelativePosition;
      @doc("Position soft limits for this axis of a Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_PositionLimitType A_positionSoftLimit;
      @doc("the velocity soft limits for this axis of a Linear_Mount")
      @hashid @optional T_AxisVelocityLimitsType A_velocitySoftLimit;
      @doc("The acceleration limits for this axis of a Linear_Mount.")
      @hashid @optional T_AxisAccelerationLimitType A_accelerationSoftLimit;
   };

   @doc("A type containing the lock State for each axis in a Linear Mount, intended to allow independent commanding of axis lock state")
   @mutable
   @nested
   struct T_RotationalLockStateType
   {
      @doc("The azimuth lock state. If the azimuth axis is not supported on this mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_azimuthLockState;
      @doc("The elevation lock state. If the elevation axis is not supported on this Mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_elevationLockState;
      @doc("The crosselevatiomn lock state. If the crosselevation axis is not supported on this Mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_crossElevationLockState;
   };

   @doc("A list of elements of type StabilisationMode.")
   typedef sequence <T_AxisStabilisationModeType> T_ListOfStabilisationModesType;

   @doc("A list of elements of type MountOperationMode.")
   typedef sequence <T_AxisControlModeType> T_ListOfAxisControlModesType;

   @doc("A structure containing the rotational angular acceleration limit of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_AngularAccelerationLimitType
   {
      @doc("The azimuth limits for rotational angular acceleration.")
      @hashid @optional T_AxisAngularAccelerationLimitType A_azimuthLimits;
      @doc("The elevation limits for rotational angular acceleration.")
      @hashid @optional T_AxisAngularAccelerationLimitType A_elevationLimits;
      @doc("The cross elevation limits for rotational angular acceleration.")
      @hashid @optional T_AxisAngularAccelerationLimitType A_crossElevationLimits;
   };

   @doc("A structure for commanding the movement mode of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_LinearMovementModeType
   {
      @doc("Commanded movement control mode for the x axis. Optionality should be used where this axis is not supported.
          Note the \"INVALID\" mode can not be used in this context.")
      @hashid @optional T_AxisControlModeType A_xAxisMode;
      @doc("Commanded movement control mode for the y axis. Optionality should be used where this axis is not supported.
          Note the \"INVALID\" mode can not be used in this context.")
      @hashid @optional T_AxisControlModeType A_yAxisMode;
      @doc("Commanded movement control mode for the z axis. Optionality should be used where this axis is not supported.
          Note the \"INVALID\" mode can not be used in this context.")
      @hashid @optional T_AxisControlModeType A_zAxisMode;
   };

   @doc("Structure for commanding the stabilisation modes of the Mount supported Axes")
   @mutable
   @nested
   struct T_LinearStabilisationModeType
   {
      @doc("Stabilisation mode for the x (or azimuth) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_xAxisMode;
      @doc("Stabilisation mode for the y (or elevation) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_yAxisMode;
      @doc("Stabilisation mode for the z (or cross elevation) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_zAxisMode;
   };

   @doc("A structure for commanding the movement mode of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_RotationalMovementModeType
   {
      @doc("Stabilisation mode for the azimuth axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisControlModeType A_azimuthMode;
      @doc("Stabilisation mode for the elevation axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisControlModeType A_elevationMode;
      @doc("Stabilisation mode for the crosselevation axis.  Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisControlModeType A_crossElevationMode;
   };

   @doc("A structure containing the rotational angular velocity limit of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_AngularVelocityLimitType
   {
      @doc("The azimuth rotational angular velocity limits.")
      @hashid @optional T_AxisAngularVelocityLimitType A_azimuthLimits;
      @doc("The elevation rotational angular velocity limits.")
      @hashid @optional T_AxisAngularVelocityLimitType A_elevationLimits;
      @doc("The cross elevation rotational angular velocity limits.")
      @hashid @optional T_AxisAngularVelocityLimitType A_crossElevationLimits;
   };

   @doc("Structure holding the status of all attributes specific to a particular rotational axis.")
   @mutable
   @nested
   struct T_RotationalAxisType
   {
      @doc("The current angular position of this axis of the Rotational_Mount")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_position;
      @doc("The current angular velocity of this axis of the Rotational_Mount")
      @hashid @optional P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_velocity;
      @doc("The current acceleration of the Mount in this axis, if supported.")
      @hashid @optional P_LDM_Common_PSM::T_AngularAccelerationInRadiansPerSecPerSecType A_acceleration;
      @doc("the absolute commanded position of the Mount in this axis. Only applicable in Control_Mode_Position")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_commandedPosition;
      @doc("the absolute commanded rate of the Mount in this axis. Only applicable in Control_Mode_Rate. Also sometime referred to as rate demand.")
      @hashid @optional P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_commandedRate;
      @doc("The current lock state of the axis.")
      @hashid @optional T_AxisLockStateType A_lockState;
      @doc("The current stabilisation mode of the mount if supported.")
      @hashid @optional T_AxisStabilisationModeType A_stabilisationMode;
      @doc("The movement control mode of the this axis of the Rotational_Mount")
      @hashid @optional T_AxisControlModeType A_movementControlMode;
      @doc("the absolute commanded position of the Mount in this axis. Only applicable in Control_Mode_Relative_Position. Also sometimes referred to as position error.")
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_commandedRelativePosition;
      @doc("Describes angular soft limits (software limitations of the mount).")
      @hashid @optional P_LDM_Common_PSM::T_AngularLimitType A_angleSoftLimit;
      @doc("Describes acceleration soft limits (software limitations of the mount).")
      @hashid @optional T_AxisAngularAccelerationLimitType A_accelerationSoftLimit;
      @doc("Describes velocity soft limits (software limitations of the mount).")
      @hashid @optional T_AxisAngularVelocityLimitType A_velocitySoftLimit;
   };

   @doc("A structure containing the linear velocity limit of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_VelocityLimitType
   {
      @doc("The x axis linear velocity limit.")
      @hashid @optional T_AxisVelocityLimitsType A_xLimits;
      @doc("The y axis linear velocity limit.")
      @hashid @optional T_AxisVelocityLimitsType A_yLimits;
      @doc("The z axis linear velocity limit.")
      @hashid @optional T_AxisVelocityLimitsType A_zLimits;
   };

   @doc("A structure containing the axis linear acceleration limit of all supported axes. Optionality should be used for unsupported axes.")
   @mutable
   @nested
   struct T_AccelerationLimitType
   {
      @doc("The x axis linear acceleration limits.")
      @hashid @optional T_AxisAccelerationLimitType A_xLimits;
      @doc("The y axis linear acceleration limit.")
      @hashid @optional T_AxisAccelerationLimitType A_yLimits;
      @doc("The z axis linear acceleration limit.")
      @hashid @optional T_AxisAccelerationLimitType A_zLimits;
   };

   @doc("A structure that holds all the specification data for an individual axis. May be used for a linear or rotational axis.")
   @mutable
   @nested
   struct T_AxisSpecificationType
   {
      @doc("If TRUE, indicates that the mount is able to communicate its current acceleration.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_accelerationOutputSupported;
      @doc("If TRUE, indicates that the mount is able to communicate its current position.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_positionOutputSupported;
      @doc("If TRUE, indicates that the mount is able to communicate its precision.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_precisionOutputSupported;
      @doc("If TRUE, indicates that the movement lock state of the mount (movement locked / unlocked) can be set through the system internal communication means (ex. vetronics).
          If FALSE, indicates that locking / unlocking the mount can only be done mechanically.
          If the mount is locked, then no movement command will be taken into account.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setLockStateSupported;
      @doc("If TRUE, indicates that the mount is able to receive requests to reach an absolute position.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setPositionSupported;
      @doc("If TRUE, indicates that the mount is able to receive requests of movement relative to its current position (offset).")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setRelativePositionSupported;
      @doc("If TRUE, indicates that the mount is able to receive velocity modification requests.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_setVelocitySupported;
      @doc("If TRUE, indicates that soft limits can be defined by the mount.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_softLimitsSupported;
      @doc("Lists the movement modes supported by the mount.")
      @hashid T_ListOfAxisControlModesType A_supportedMovementModes;
      @doc("Lists the stabilisation modes supported by the mount.")
      @hashid T_ListOfStabilisationModesType A_supportedStabilisationModes;
      @doc("If TRUE, indicates that the mount is able to communicate its current velocity.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_velocityOutputSupported;
   };

   @doc("A type containing the lock State for each axis in a Linear Mount, intended to allow independent commanding of axis lock state")
   @mutable
   @nested
   struct T_LinearLockStateType
   {
      @doc("The x lock state. If the x axis is not supported on this mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_xLockState;
      @doc("The y lock state. If the y axis is not supported on this Mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_yLockState;
      @doc("The z lock state. If the z axis is not supported on this Mount then optionality should be used.")
      @hashid @optional T_AxisLockStateType A_zLockState;
   };

   @doc("Structure for commanding the stabilisation modes of the Mount supported Axes")
   @mutable
   @nested
   struct T_RotationalStabilisationModeType
   {
      @doc("Stabilisation mode for the x (or azimuth) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_azimuthAxisMode;
      @doc("Stabilisation mode for the y (or elevation) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_elevationAxisMode;
      @doc("Stabilisation mode for the z (or cross elevation) axis. Optionality should be used where the Mount does not support this access.
          the literal \"INVALID\" is not a legitimate selection in the context of a command.")
      @hashid @optional T_AxisStabilisationModeType A_crossElevationAxisMode;
   };

   @doc("This type contains 3 booleans which correspond to the Azimuth, Elevation and Cross-elevation axes. This allows certain axes to be overridden (TRUE) or not (FALSE).")
   @mutable
   @nested
   struct T_RotationalAxisSoftLimitOverrideType
   {
      @doc("Boolean indicating if the azimuth axis soft limit is overridden. TRUE indicates the soft limit is overridden. FALSE indicates it is not overridden. Optionality should be used where the axis is not supported by the Mount.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_azimuthOverride;
      @doc("Boolean indicating if the elevation axis soft limit is overridden. TRUE indicates the soft limit is overridden. FALSE indicates it is not overridden. Optionality should be used where the axis is not supported by the Mount.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_elevationOverride;
      @doc("Boolean indicating if the crossElevation axis soft limit is overridden. TRUE indicates the soft limit is overridden. FALSE indicates it is not overridden. Optionality should be used where the axis is not supported by the Mount.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_crossElevationOverride;
   };

   @doc("This type contains 3 booleans which correspond to the X, Y and Z axes. This allows certain axes to be overridden (TRUE) or not (FALSE).")
   @mutable
   @nested
   struct T_LinearAxisSoftLimitOverrideType
   {
      @doc("Boolean indicating if the X axis soft limit is overridden. TRUE indicates the soft limit is overridden. FALSE indicates it is not overridden. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_xOverride;
