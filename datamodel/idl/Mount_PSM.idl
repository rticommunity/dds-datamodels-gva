   @doc("Makes the inhibit zone active.  I.e. it should be considered to inhibit the associated Mounted_Equipment")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area_enable
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
   };

   @doc("This describes an area that an object of type Mounted_Equipment cannot 'effect' in.  For example this may be a tactical effector not being able to fire.
       This area is defined locally to the platform; i.e.it is areas of the platform that stop the effect taking place; not a limitation on the area of effect.
       It is important to note that an inhibit area may be relative to a different mount than the Mounted_Equipment it is associated with is mounted to.  E.g. there may be an inhibit area at the rear door of the platform (essentially the Datum Mount) that inhibits the use of the weapon fitted to the RWS mounted on the turret.")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("A boolean indicating if the Inhibit area is currently enabled.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_enabled;
      @doc("A boolean indicating if the Inhibit area is currently overridden.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_overridden;
      @doc("Flag to indicate that the associated Mounted_Equipment is currently inhibited or not by this zone")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_equipmentInhibitedByZone;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_areaMount_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_inhibitedEquipment_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_inhibitAreaSpecification_sourceID;
   };

   @doc("Specification of an area relative to the platform in which Mounted_Equipment should be inhibited from taking effect.
       This element is intended to be specialised for different shapes / types / volumes of zone.")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Flag to show if enabling and disabling the zone is supported (e.g. an open hatch inhibit area may be enabled or disabled based on the status of the hatch.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_enableDisableSupported;
      @doc("Indicates if the Inhibit Area supports overriding.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideSupported;
      @doc("A human readable string describing the inhibit area. Each areaName must be unique within the scope of a mission system.")
      @hashid P_LDM_Primitive_PSM::T_MediumString A_areaName;
      @doc("An offset from the installation position of the mount to which the inhibit area applies")
      @hashid P_LDM_Common_PSM::T_LinearOffsetType A_linearOffsetFromMount;
   };

   @doc("Specialisation of a Mounted_Equipment_Inhibit_Area_Specification that represents a 3D cuboid")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area_Cuboid_Volume_Specification : C_Mounted_Equipment_Inhibit_Area_Specification
   {
      @doc("The bottom right back point of the cuboid which defines the inhibited area.  I.e. the extent.")
      @hashid P_LDM_Common_PSM::T_CoordinatePolar3DType A_bottomRightBack;
      @doc("The top left front point of the cuboid which defines the inhibited area.  I.e. the origin")
      @hashid P_LDM_Common_PSM::T_CoordinatePolar3DType A_topLeftFront;
   };

   @doc("Specialisation  of the Mounted_Equipment_Inhibit_Area_Specification that represents an angular volume.  This area will basically form a 'pyramid' shape with the point of the pyramid at the start of the inhibit area.  The width/depth of the base of the 'pyramid' are defined by the combination of the azimuth and elevation angles, and the depth.")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area_Angular_Volume_Specification : C_Mounted_Equipment_Inhibit_Area_Specification
   {
      @doc("The start and end of the inhibit area in the azimuth plane of the mount")
      @hashid P_LDM_Common_PSM::T_AngularLimitType A_azimuth;
      @doc("The depth (how far away from the inhibit area start point) the inhibit area should reach")
      @hashid P_LDM_Common_PSM::T_DistanceInMetresType A_depth;
      @doc("The start and end of the inhibit area in the elevation plane of the mount")
      @hashid P_LDM_Common_PSM::T_AngularLimitType A_elevation;
   };
};

#endif
