   @doc("Describes the status of a linear mount.
       A linear mount is a platform that has one, two or three orthogonal axes on which other resources can be attached. Movement is in the x, y or z direction.
       The axes addressed by the mount are described by the hard limits.")
   @mutable
   struct C_Linear_Mount : C_Mount
   {
      @doc("A LinearAxisSoftLimitOverrideType containing 3 booleans for the X, Y and X axes. Each Boolean is set to TRUE if the acceleration soft limit is overridden for that axis and FALSE if it is not.")
      @hashid @optional T_LinearAxisSoftLimitOverrideType A_accelerationSoftLimitsOverridden;
      @doc("The x axis status. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional T_LinearAxisType A_xAxis;
      @doc("The y axis status. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional T_LinearAxisType A_yAxis;
      @doc("The z axis status. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional T_LinearAxisType A_zAxis;
      @doc("A LinearAxisSoftLimitOverrideType containing 3 booleans for the X, Y and X axes. Each Boolean is set to TRUE if the position soft limit is overridden for that axis and FALSE if it is not.")
      @hashid @optional T_LinearAxisSoftLimitOverrideType A_positionSoftLimitsOverridden;
      @doc("A LinearAxisSoftLimitOverrideType containing 3 booleans for the X, Y and X axes. Each Boolean is set to TRUE if the velocity soft limit is overridden for that axis and FALSE if it is not.")
      @hashid @optional T_LinearAxisSoftLimitOverrideType A_velocitySoftLimitsOverridden;
      @doc("The specification of the considered linear mount.")
      @hashid P_GVA_Common_PSM::T_IdentifierType A_linearMountSpecification_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_linearMovementInhibitZones_sourceID;
   };

   @doc("The static parameters of a linear mount.")
   @mutable
   struct C_Linear_Mount_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Describes the mount position hard limits (physical limitations of the mount).")
      @hashid T_LinearPositionLimitType A_mountPositionHardLimits;
      @doc("Describes the mount velocity hard limits (physical limitations of the mount).")
      @hashid @optional T_VelocityLimitType A_mountVelocityHardLimits;
      @doc("Describes the mount acceleration hard limits (physical limitations of the mount).")
      @hashid @optional T_AccelerationLimitType A_mountAccelerationHardLimits;
      @doc("Describes the linear precision of the mount.
          Relevant only if the mount supports precision output.")
      @hashid @optional T_PrecisionType A_mountPrecision;
      @doc("A human readable identifier for the type name of the linear mount. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_linearMountTypeName;
      @doc("Specification for the X axis, if not present then X axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_xAxisSpecification;
      @doc("Specification for the Y axis, if not present then Y axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_yAxisSpecification;
      @doc("Specification for the Z axis, if not present then Z axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_zAxisSpecification;
      @doc("Indicates if the Mount supports the overriding of any associated Inhibit Zones.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_inhibitZoneOverrideSupported;
      @doc("Indicates if the Mount supports the overriding of any position soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overridePositionSoftLimitsSupported;
      @doc("Indicates if the Mount supports the overriding of any velocity soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideVelocitySoftLimitsSupported;
      @doc("Indicates if the Mount supports the overriding of any acceleration soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideAccelerationSoftLimitsSupported;
   };

