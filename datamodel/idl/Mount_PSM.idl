   @doc("Describes areas where the mount cannot be pointed at. This kind of restrictions is defined when the mobile element cannot be requested to move to certain positions for safety reasons (for example in order to avoid hitting a part of a vehicle).
       For the azimuth angle, the information is provided in the clockwise direction. So for example, an area with startPositionAzimuth = 3.0, endPositionAzimuth = -3 is a 0.28 radians exclusion area.
       For the elevation angle, the positive value is above the level plane and the negative value is below the level plane. So for example
       For the cross elevation angle, the positive value is clockwise and the negative value is anti-clockwise. So for example")
   @mutable
   struct C_Rotational_Movement_Inhibit_Zone
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("The azimuth of the area description start position.")
      @hashid @optional P_LDM_Common_PSM::T_AngularLimitType A_azimuthLimit;
      @doc("The elevation of the area description start position.")
      @hashid @optional P_LDM_Common_PSM::T_AngularLimitType A_elevationLimit;
      @doc("A human readable string describing the inhibit zone. Each zoneName must be unique within the scope of a mission system as this string is used to identify zones for removal.")
      @hashid P_LDM_Primitive_PSM::T_MediumString A_zoneName;
      @doc("The cross elevation of the area description start position.")
      @hashid @optional P_LDM_Common_PSM::T_AngularLimitType A_crossElevationLimit;
      @doc("Indicates if the Inhibit Zones is overridden.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_inhibitZoneOverridden;
      @doc("This is the activation state of the movement inhibit zone")
      @hashid T_Rotational_Movement_Inhibit_Zone_StateType A_currentState;
      @doc("The rotational mount for which the considered area represents a movement inhibit zone.")
      @hashid P_GVA_Common_PSM::T_IdentifierType A_rotationalMount_sourceID;
   };

