      @hashid T_ScanParametersType A_scanParameters;
   };

   @doc("This command controls the scan action applied to all of the axes for which scan parameters are set.
       For a 2 dimensional scan (typically Azimuth & Elevation), controlScan starts the scanning procedure. startAxis is the axis which shall be moved first, e.g. from left to right in azimuth. After reaching right, \"interAxisOffset\" is used to increase (or decrease) elevation. Afterwards, azimuth scanning from right to left starts, and so on, until the whole sector has been covered.")
   @mutable
   struct C_Rotational_Mount_controlScan
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @doc("Controls the start, stopping and pausing of a scan.")
      @hashid T_ScanActionType A_set;
      @doc("The first axis to be started in a 2 dimensional scan.")
      @hashid T_RotationalAxisIndexType A_startAxis;
      @doc("This is used to increase (or decrease) the second axis in a 2 dimensional scan. For example, when scanning in azimuth if the elevation is increased (or decreased) using the interAxisOffset value at the end of each scan then a larger scan area is covered compared to a single dimension scan.")
      @hashid P_LDM_Common_PSM::T_AngleInRadiansType A_interAxisOffset;
   };

   @doc("Describes the status of a horizontal rotational mount.
       A horizontal rotational mount is a platform that has one, two or three axes on which other resources can be attached. Movement is about the azimuth, elevation  & cross-elevation axes.
       Frame of reference is North East Up.")
   @mutable
   struct C_Rotational_Mount : C_Mount
   {
      @doc("Describes the current state of any scan underway for the axis under control.")
      @hashid @optional T_CurrentScanStateType A_scanState;
      @doc("The type of rotational mount.")
      @hashid T_RotationalMountType A_rotationalMountType;
      @doc("Describes the current scan parameters.")
      @hashid @optional T_ScanParametersType A_scanParameters;
      @doc("A RotationalAxisSoftLimitOverrideType containing 3 booleans for the Azimuth, Elevation and Cross-Elevation axes. Each Boolean is set to TRUE if the acceleration soft limit is overriden for that axis and FALSE if it is not.")
      @hashid @optional T_RotationalAxisSoftLimitOverrideType A_accelerationSoftLimitsOverridden;
      @doc("The status of the azimuth axis. Optionality should be used if the axis is not supported by the Rotational_Mount.")
      @hashid @optional T_RotationalAxisType A_azimuthAxis;
      @doc("The status of the elevation axis. Optionality should be used if the axis is not supported by the Rotational_Mount.")
      @hashid @optional T_RotationalAxisType A_elevationAxis;
      @doc("The status of the cross-elevation axis. Optionality should be used if the axis is not supported by the Rotational_Mount.")
      @hashid @optional T_RotationalAxisType A_crossElevationAxis;
      @doc("A RotationalAxisSoftLimitOverrideType containing 3 booleans for the Azimuth, Elevation and Cross-Elevation axes. Each Boolean is set to TRUE if the angle soft limit is overriden for that axis and FALSE if it is not.")
      @hashid @optional T_RotationalAxisSoftLimitOverrideType A_angleSoftLimitsOverridden;
      @doc("A RotationalAxisSoftLimitOverrideType containing 3 booleans for the Azimuth, Elevation and Cross-Elevation axes. Each Boolean is set to TRUE if the velocity soft limit is overriden for that axis and FALSE if it is not.")
      @hashid @optional T_RotationalAxisSoftLimitOverrideType A_velocitySoftLimitsOverridden;
      @doc("The specification of the considered rotational mount.")
      @hashid P_GVA_Common_PSM::T_IdentifierType A_rotationalMountSpecification_sourceID;
      @doc("The areas where the mount movement is inhibited due to platform constraints.")
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_rotationalMovementInhibitZones_sourceID;
   };

   @doc("The static parameters of a rotational mount.")
   @mutable
   struct C_Rotational_Mount_Specification
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Describes the mount angle hard limits (physical limitations of the mount).")
      @hashid T_AngularPositionLimitType A_mountAngleHardLimits;
      @doc("Describes the mount angular velocity hard limits (physical limitations of the mount).")
      @hashid @optional T_AngularVelocityLimitType A_mountAngularVelocityHardLimits;
      @doc("Describes the mount angle acceleration hard limits (physical limitations of the mount).")
      @hashid @optional T_AngularAccelerationLimitType A_mountlAngularAccelerationHardLimit;
      @doc("Describes the mount angular precision.
          Relevant only if the mount support precision output.")
      @hashid T_AngularPrecisionType A_mountAngularPrecision;
      @doc("If TRUE, indicate that the mount is capable of managing user-defined movement inhibition zones.
          This flag must be set to true only if the operations for adding and removing user-defined movement inhibition zones are supported by the implementation.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_userDefinedMovementInhibitZonesSupported;
      @doc("If TRUE, indicates that the Rotational Mount is capable of semi-automatic scanning. Semi-automatic scan allows the operator to  start, pause and stop the scan, instead of controlling all scan movements (e.g. with a joystick).")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_scanSupported;
      @doc("A human readable identifier for the type name of the rotational mount. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          TYPE_NAME::<typeName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_rotationalMountTypeName;
      @doc("Specification for the azimuth axis, if not present then azimuth axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_azimuthAxisSpecification;
      @doc("Specification for the elevation axis, if not present then elevation axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_elevationAxisSpecification;
      @doc("Specification for the crossElevation axis, if not present then crossElevation axis is not supported on this Mount.")
      @hashid @optional T_AxisSpecificationType A_crossElevationAxisSpecification;
      @doc("Indicates if the Mount supports the overriding of any associated Inhibit Zones.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_inhibitZoneOverrideSupported;
      @doc("Indicates if the Mount supports the overriding of any acceleration soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideAccelerationSoftLimitsSupported;
      @doc("Indicates if the Mount supports the overriding of any angular soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideAngleSoftLimitsSupported;
      @doc("Indicates if the Mount supports the overriding of any velocity soft limits.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_overrideVelocitySoftLimitsSupported;
   };

   @doc("A function to override or enable an existing Rotational_Movement_Inhibit_Zone.
