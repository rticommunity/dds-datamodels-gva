   @doc("Represents the datum mount, upon which others are mounted.  In the case of a vehicle, this is the vehicle hull itself.")
   @mutable
   struct C_Datum_Mount : C_Mount
   {
   };

   @doc("A function to override or enable an existing Rotational_Movement_Inhibit_Zone.
       If the parameter \"override\" is set to TRUE, the Rotational_Movement_Inhibit_Zone will be overridden.
       If the parameter \"override\" is set to FALSE, the Rotational_Movement_Inhibit_Zone will be enabled.")
   @mutable
   struct C_Linear_Movement_Inhibit_Zone_overrideMovementInhibitZone
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Boolean A_override;
   };

   @doc("Set the activation of the zone (activated, deactivated).
       This command is not valid on a zone of type Elevation Depression Zone.")
   @mutable
   struct C_Linear_Movement_Inhibit_Zone_setActivation
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.")
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("Boolean indicating whether a response is required to this command. If TRUE, a response is not required. If FALSE, a response is required.")
      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @hashid P_LDM_Primitive_PSM::T_Boolean A_isActivated;
   };

   @doc("Describes the position in the linear axis past which the linear mount cannot move.
       For a linear axis, the information is provided in a positive direction from the origin of that axis. So for example, xStartPosition = 3.0, the linear mount cannot move past 3 metres in that axis.
       Three types of movement inhibit zones are taken into consideration :
       - Elevation depression zones aims at preventing the mount from being directed into the platform it is part of (ex. vehicle). Elevation depression zones cannot be added / removed and cannot be overridden or deactivated.
       - Traverse inhibit zones are associated with the platform topology (ex. hatches). Traverse inhibit zones cannot be added / removed but can be overridden and deactivated.
       - User-defined safety zones can be added / removed to define additional movement inhibit zones specific to the platform. They can be overridden and deactivated.")
   @mutable
   struct C_Linear_Movement_Inhibit_Zone
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @doc("The y axis limit beyond which the mount cannot traverse. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_PositionLimitType A_yLimit;
      @doc("A human readable string describing the inhibit zone. Each zoneName must be unique within the scope of a mission system as this string is used to identify zones for removal.")
      @hashid P_LDM_Primitive_PSM::T_MediumString A_zoneName;
      @doc("The x axis limit beyond which the mount cannot traverse. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_PositionLimitType A_xLimit;
      @doc("The z axis limit beyond which the mount cannot traverse. Optionality should be used where the axis is not supported by the Linear_Mount.")
      @hashid @optional P_LDM_Common_PSM::T_PositionLimitType A_zLimit;
      @doc("Indicates if the Inhibit Zones is overridden.")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_inhibitZoneOverridden;
      @doc("This is the activation state of the movement inhibit zone")
      @hashid T_Linear_Movement_Inhibit_Zone_StateType A_currentState;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_linearMount_sourceID;
   };

   @doc("Removes the override on the zone - standard enabled/disabled behaviour applies")
   @mutable
   struct C_Mounted_Equipment_Inhibit_Area_removeOverride
   {
      @doc("The resourceID of the LRU which will receive the sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
