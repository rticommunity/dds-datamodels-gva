   // The video tracker status itself. It generates the objects of interest out of a video frame during multi object mode and handles the tracking of one object when lead/locked on. 
   @mutable
   struct C_Video_Tracker
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // For Detection & Multi Object Tracking:
      // If set to true, first detected object is used for leadOn
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_autoLeadOnDetections;
      // Track is lost, object movement is predicted.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_isCoasting;
      // Defines if the object categorisation is activated.
      @hashid P_LDM_Common_PSM::T_ReportedStatusType A_objectClassificationActivated;
      // For Detection & Multi Object Tracking: Value from 0 to 1
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_sensitivity;
      // Name of detection & tracking parameter set
      @hashid P_LDM_Primitive_PSM::T_MediumString A_trackingParameterSetName;
      // Offset for the tracked object during tracking relative to the middle of the Object.
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_trackingOffsetAzimuth;
      // Offset for the tracked object during tracking relative to the middle of the Object.
      @hashid @optional P_LDM_Common_PSM::T_AngleInRadiansType A_trackingOffsetElevation;
      @hashid T_Video_Tracker_StateType A_currentState;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_trackObjectCharacteristics_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_sensorMasks_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_availableCharacteristics_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_videoTrackerCP_sourceID;
   };

   // Video tracker specification. 
   @mutable
   struct C_Video_Tracker_Specification
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Maximal number of trackable objects during multi object mode.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_maxTrackableObjects;
      // Maximum possible number of sensor masks
      @hashid P_LDM_Primitive_PSM::T_Int32 A_maxSensorMasks;
      // List of available tracking parameters. Tracking parameters may be different between tracker implementations, thus the data model cannot keep a list of all parameters. Thus the video tracker publishes its available parameters.
      @hashid T_TrackingParameterListType A_availableTrackingParameter;
      // A meaningful name for the tracker type
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
      // A Boolean which, when set to TRUE, indicates that all Video Trackers sharing this specification support auto lead-on detections.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_autoLeadOnDetectionsSupported;
      // A Boolean which, when set to TRUE, indicates that all Video Trackers sharing this specification support the activation of object categorisations.
      @hashid P_LDM_Primitive_PSM::T_Boolean A_objectClassificationActivatedSupported;
   };

   // Desired characteristics of objects to track 
