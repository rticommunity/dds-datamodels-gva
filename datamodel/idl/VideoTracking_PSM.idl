   // changes the state of a certain object to focussed. This operation is part of the video tracker to avoid the overhead when switching focus.
   @mutable
   struct C_Video_Tracker_setFocussedObject
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
