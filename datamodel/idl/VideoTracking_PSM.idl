#ifndef VIDEOTRACKING_PSM__IDL
#define VIDEOTRACKING_PSM__IDL

#include "LDM_Primitive_PSM.idl"
#include "LDM_Common_PSM.idl"
#include "LDM_Geometry_PSM.idl"
#include "LDM_Confidentiality_Label_PSM.idl"
#include "GVA_Common_PSM.idl"

// This module contains data structures for control and management of a video tracker system to detect objects and to track their pixel positions in a video data stream.
// 
// Responsibilities of this domain are:
// 
//     Detecting multiple objects in a video stream (Aided Target Recognition)
//     Tracking multiple objects in a video stream (In-Frame Tracking)
//     Line-of-Sight tracking of a single object in a video stream (LOS Tracking) and generating rate commands for a pan-tilt-mount
//     Provide data structures for the tracked objects and the tracker configuration
// 
// $Rev: 9538 $
module P_VideoTracking_PSM
{
   @appendable
   enum T_Video_Tracked_Object_StateType
   {
      L_VideoTrackedObjectState__Invalid,
      // Object has Lead-on
      L_VideoTrackedObjectState__Lead_On,
      // Object has Lock-on
      L_VideoTrackedObjectState__Lock_On,
      // Object is detected
      L_VideoTrackedObjectState__Tracked_Object_Detected,
      // The Object is in Focus
      L_VideoTrackedObjectState__Tracked_Object_Focussed
   };

   @appendable
   enum T_Video_Tracker_StateType
   {
      L_VideoTrackerState__Invalid,
      // No Object is tracked by the tracker
      L_VideoTrackerState__Multi_Object_Tracking_No_Object_Of_Interest,
      // Objects of interest are found and distributed as a list of objects.
      L_VideoTrackerState__Multi_Object_Tracking_Objects_Of_Interest_Detected,
      // No object of interest is assgined.
      L_VideoTrackerState__Single_Object_Tracking_No_Object_Of_Interest,
      // Searching for an object to lock on at the given position
      L_VideoTrackerState__Single_Object_Tracking_Lock_On_Pending,
      // Searching for the object to lead on (cue mount) at the given position
      L_VideoTrackerState__Single_Object_Tracking_Lead_On_Pending,
      // Target found and the tracker is locked on
      L_VideoTrackerState__Single_Object_Tracking_Locked_On,
      // Object found and the tracker is on the target
      L_VideoTrackerState__Single_Object_Tracking_Leading_On,
      // Calibration in progress
      L_VideoTrackerState__Calibration
   };

   // Defines literals to categorise an object
   @appendable
   enum T_ObjectTypeType
   {
      L_ObjectType__Invalid,
      L_ObjectType__Unknown,
      L_ObjectType__Person,
      L_ObjectType__Vehicle,
      L_ObjectType__X_Etc
   };

   // Defines literals for the focus switch mode
   @appendable
   enum T_FocusSwitchDemandType
   {
      L_FocusSwitchDemand__Invalid,
      L_FocusSwitchDemand__Direction_Up,
      L_FocusSwitchDemand__Direction_Down,
      L_FocusSwitchDemand__Direction_Left,
      L_FocusSwitchDemand__Direction_Right,
      L_FocusSwitchDemand__Direction_Nearest
   };

   // Defines a type for a 2d polygon
   @mutable
   @nested
   struct T_Polygon2DType
   {
      // Points of the polygon ordered in clockwise manner.
      @hashid sequence <P_LDM_Common_PSM::T_Position2DType, 50> A_points;
   };

   // Type for the list of tracking parameters.
   typedef sequence <P_LDM_Primitive_PSM::T_ShortString> T_TrackingParameterListType;

   // All GVA Resources shall publish a common cesponse topic for each Domain Module they implement. Each Response message published shall use the same value for referenceNum as the Command message it is responding to.
   @mutable
   struct C_VideoTracking_CommandResponse
   {
      // The resourceID of the LRU which will receive the sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_recipientID;
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Identifies a sample published on a command topic. Each commanding resoure is responsible for ensuring that it stamps each sample it publishes on a particular Command Topic with a unique Reference Number (e.g. through an incrementing counter). When a commanded Resource publishes a sample on Command Response Topic, it must set the Reference Number to the same value as the Command to which it is responding.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_referenceNum;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Enumerated type with several common error codes defined. If an operation fails, Resources shall use the value that most closely reflects the underlying reason for the failure
      @hashid P_GVA_Common_PSM::T_ResponseCodeType A_responseCode;
      // LRU-specific error code to be used if an LRU gives an error response not covered by the standard GVA error codes. In the special case where  ResponseCodeAttributeType is L_ResponseCodeType_Pending, this attribute shall be set to the the worst-case time to completion in milliseconds.
      @hashid P_LDM_Primitive_PSM::T_Int32 A_additionalResponseCode;
   };

   // The features of objects tracked during multi object tracking and LOS tracking.
   @mutable
   struct C_Video_Tracked_Object
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // ID of the track. This Id is valid over several video frames for one object.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_trackID;
      // Velocity of the tracked object relative to the vehicle on azimuth. 
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_velocityAz;
      // Velocity of the tracked object relative to the vehicle on elevation. 
      @hashid P_LDM_Common_PSM::T_AngularVelocityinRadiansPerSecType A_velocityEl;
      // The tracker predicts the object trajectory while object is hidden.
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_isCoasting;
      // For MultiObjectTracking: 
      // Value 0 to 1 for confidence of object not being a false alarm.
      // 
      @hashid @optional P_LDM_Primitive_PSM::T_Double A_confidence;
      // Type of the tracked object
      @hashid T_ObjectTypeType A_trackedObjectType;
      // Size of the object in pixel
      @hashid P_LDM_Common_PSM::T_Size2DType A_objectSize;
      // Position of the objects Centre in image coordinates.
      @hashid P_LDM_Common_PSM::T_Position2DType A_objectPositionInImage;
      @hashid T_Video_Tracked_Object_StateType A_currentState;
   };

   // Contains all tracked objects of one video frame
   @mutable
   struct C_Track_Data_Video_Frame
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Id of the video frame.
      @hashid P_LDM_Primitive_PSM::T_Int64 A_frameID;
      // Video frames are generated in a huge amount and are volatile, therefore this association is modelled as a unidirectional association.
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_trackObjects_sourceID;
      // Video frames are generated in a huge amount and are volatile, therefore this association is modelled as a unidirectional association.
      @hashid P_GVA_Common_PSM::T_IdentifierType A_videoTracker_sourceID;
   };

   // Desired characteristics of objects to track
   @mutable
   struct C_Track_Object_Characteristic
   {
      // The resourceID of the LRU which publishes this sample.
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      // Specifies the metadata for this sample.
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      // Type of the tracked object.
      @hashid T_ObjectTypeType A_trackedObjectType;
      // Maximum size of the object.
      @hashid P_LDM_Common_PSM::T_Size2DType A_size;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_videoTracker_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_specification_sourceID;
   };

   // Deletes the sensor mask 
   @mutable
   struct C_Sensor_Mask_deleteSensorMask
   {
      // The resourceID of the LRU which will receive the sample.
