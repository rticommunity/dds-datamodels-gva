      @hashid P_LDM_Primitive_PSM::T_Boolean A_responseNotRequired;
      @doc("A human readable identifier for the name of the Object. This shall be a text string in the following format as defined in the LDM Methodology and Modelling Standard:
          The uppercase labels that prefix each descriptor value are literal strings. Names in <angleBrackets> represent placeholders for actual values.
          OBJECT::<domainName>::<className>::<objectName>")
      @hashid P_LDM_Common_PSM::T_DescriptorType A_descriptor;
   };

   @doc("Placeholder for counterpart associations and services in build sets.")
   @mutable
   struct C_Platform_Following_Route_CP
   {
      @doc("The resourceID of the LRU which publishes this sample.")
      @hashid @key P_GVA_Common_PSM::T_IdentifierType A_sourceID;
      @doc("Specifies the metadata for this sample.")
      @hashid P_GVA_Common_PSM::T_MetadataType A_metadata;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_cpPlatformFollowingRoute_sourceID;
   };

   @doc("A Control Feature that represents a natural or man-made object that creates a physical impediment to or hazard for the movement of vehicles, personnel or formations.
       Remarks:
       The term 'obstacle' is preferred in the land environment whereas the term 'obstruction' is preferred in the air and water environments.")
   @mutable
   struct C_Obstacle : C_Point
   {
      @doc("The assessment conducted on the Obstacle.")
      @hashid P_LDM_Primitive_PSM::T_LongString A_assessmentText;
      @doc("The status of the Obstacle concerning its possible demolition.")
      @hashid @optional T_DemolitionStatusCodeType A_demolitionStatusCode;
      @doc("Whether the Obstacle is considered a CBRN threat (true) or not (false).")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_isCBRNThreat;
      @doc("Whether the Obstacle is man-made (true) or natural (false).")
      @hashid @optional P_LDM_Primitive_PSM::T_Boolean A_isManMade;
      @doc("The description of the Obstacle based on observation. It may describe the conditions under which the observation was made.")
      @hashid P_LDM_Primitive_PSM::T_LongString A_observationText;
      @doc("The operational status of the Obstacle.")
      @hashid T_ObstacleOperationalStatusCodeType A_operationalStatusCode;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_lanes_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_gaps_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_obstacleBypass_sourceID;
      @hashid P_GVA_Common_PSM::T_IdentifierType A_owningBarrier_sourceID;
   };

   @doc("A line which delineates surface areas (or airspace) for the purpose of facilitating coordination and deconfliction of operations between adjacent units, formations or areas.
       2. A control measure normally drawn along identifiable terrain features and used to delineate areas of tactical responsibility between adjacent units and between higher headquarters to the rear of the subordinate units. Control measures which define the left and right limits of a unit's zone of action or sector. Together with the rear and forward boundary and a coordinating altitude, lateral boundaries define the area of operations for a commander.")
   @mutable
   struct C_Organisation_Boundary : C_Line
   {
      @doc("The name of the organisation that is located to the left of the boundary.")
      @hashid @optional P_LDM_Primitive_PSM::T_MediumString A_leftOrganisationName;
      @doc("The name of the organisation that is located to the right  of the boundary.")
      @hashid @optional P_LDM_Primitive_PSM::T_MediumString A_rightOrganisationalName;
   };

   @doc("A Control Feature that involves chemical, biological, radiological or nuclear materiel individually or in combination.")
   @mutable
   struct C_CBRN_Control_Feature : C_Area
   {
      @doc("The category of CBRN Control Feature.")
      @hashid T_CBRNControlFeatureCategoryCodeType A_categoryCode;
      @doc("The area of the control feature. This is expressed as a line that defines the boundary of the area.")
      @hashid T_LineType A_area;
   };

   @doc("A coordinated series of obstacles designed or employed to detect, channel, direct, restrict, delay or stop the movement of an opposing force, and to impose additional losses in personnel, time and equipment on the opposing force.")
   @mutable
   struct C_Barrier : C_Non_Geometric_Control_Feature
   {
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_constituentObstacles_sourceID;
   };

   @doc("A control feature made up of two or more other control features.")
   @mutable
   struct C_Composite_Control_Feature : C_Control_Feature
   {
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_childControlFeatures_sourceID;
   };

   @doc("A predefined segment for reuse in multiple routes.  Note that the copies can be edited once created.")
   @mutable
   struct C_Library_Route_Segment : C_Non_Geometric_Control_Feature
   {
      @doc("The category of Route Segment.")
      @hashid @optional T_RouteCategoryCodeType A_categoryCode;
      @doc("The assigned direction for the traffic on a route.")
      @hashid @optional T_RouteDirectionUsageCodeType A_directionUsage;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_waypointsAlongSegment_sourceID;
      @hashid sequence <P_GVA_Common_PSM::T_IdentifierType> A_viableMobilityCategories_sourceID;
   };

   @doc("A point in space, used as the basis for specifying routes and segments.")
   @mutable
   struct C_Waypoint : C_Point
   {
      @doc("An optional string describing the waypoint")
      @hashid P_LDM_Primitive_PSM::T_MediumString A_waypointName;
